string iNewsList = input.string("", "Other releases (NY): yyyy-mm-dd hhmm, ...", group = G_C, tooltip = "example: 2026-11-12 0830, 2026-11-18 1400 (CPI 08:30, FOMC 14:00). type the week's red folders every Monday")
int iNewsBef = input.int(10, "Blackout before (min)", minval = 0, inline = "nw", group = G_C)
