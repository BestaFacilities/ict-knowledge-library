bool iEsChk = input.bool(true, "ES checks (delivery + FVG SMT)", group = G_C, tooltip = "rulebook D: ES also delivering from a HTF FVG, and no FVG SMT (NQ prints the gap, ES does not = low probability)")
string iTrade = input.string("Last setup", "Entry / stop / target lines", options = ["Last setup", "All setups", "Off"], group = G_D, tooltip = "Last setup = older setups keep their label and iFVG box only")
int iDays = input.int(5, "History to calculate (days)", minval = 1, maxval = 60, group = G_D, tooltip = "SNM+ only runs its engine on the last N days before the last candle (in replay: before the replay candle). 5 days loads fast and is enough for every level and gap a session needs. raise it only if you want older setups drawn")
int iKeep = input.int(3, "Setups kept on the chart", minval = 1, maxval = 30, group = G_D)
string iDet = input.string("Simple", "Detail level", options = ["Simple", "Full"], group = G_D, tooltip = "Simple: the panel shows D / T / E / confluence / today, and the tooltip shows the trade plan + only what is missing. Full: every check, as before")
bool iPanel = input.bool(true, "Checklist panel", inline = "pn", group = G_D)
string iPos = input.string("Bottom Right", "", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], inline = "pn", group = G_D)
string iSz = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G_D)
string iTheme = input.string("Auto", "Theme", options = ["Auto", "Dark", "Light"], group = G_D, tooltip = "Auto reads your chart background")
string iLbl = input.string("Pills", "Setup labels", options = ["Pills", "Text"], group = G_D, tooltip = "Pills = solid coloured tag, readable on any background")
string iZst = input.string("Grey", "HTF gap boxes", options = ["Grey", "Tinted", "Edges only"], group = G_D, tooltip = "Grey = ManipulationX look, very light. Tinted = blue for FVG+, red for FVG-. Edges only = two thin lines, no fill")
float iFillMax = input.float(0.9, "HTF gaps: rebalanced when filled (fraction)", minval = 0.5, maxval = 1.0, step = 0.05, group = G_D, tooltip = "a gap price has already traded through by this fraction is rebalanced: no longer drawn and no longer used as a target. it still counts as delivery while it holds (no close beyond it)")
bool iZTrim = input.bool(true, "HTF gaps: draw only the unfilled part", group = G_D, tooltip = "like ManipulationX: the part of a gap price has already traded through is not drawn, so a big 1H / 4H gap shrinks as it gets filled. the full gap is still used for the delivery check")
int iZBack = input.int(120, "HTF gaps: box starts at most (candles back)", minval = 20, maxval = 1000, group = G_D, tooltip = "a gap made days ago does not paint the whole chart")
string iPSz = input.string("Small", "Panel text", options = ["Tiny", "Small", "Normal"], group = G_D)
string iPal = input.string("Blue / Pink", "Signal colours", options = ["Blue / Pink", "Blue / Red", "Teal / Orange", "Green / Red", "Custom"], group = G_D, tooltip = "pick a pair that does NOT match your candle colours, so setups never blend into candles. Blue / Pink works with red / green / white / black candles. Custom uses the two colours below. colours too close to your background are corrected automatically")
color iLongIn = input.color(#2962FF, "Custom long", inline = "c", group = G_D)
color iShortIn = input.color(#F23645, "Custom short", inline = "c", group = G_D)

// ───────── palette: follows the chart background and text colours; signal colours kept readable on it
f_lum(color c) =>
    0.299 * color.r(c) + 0.587 * color.g(c) + 0.114 * color.b(c)
f_shift(color c, float k) =>
    color.rgb(math.max(0, math.min(255, color.r(c) + k)), math.max(0, math.min(255, color.g(c) + k)), math.max(0, math.min(255, color.b(c) + k)))
float bgLum = f_lum(chart.bg_color)
bool bgLight = iTheme == "Light" or (iTheme == "Auto" and bgLum > 140)
// a colour too close to the background in brightness is pushed away from it
f_adj(color c) =>
    float dl = f_lum(c) - (iTheme == "Auto" ? bgLum : bgLight ? 255.0 : 20.0)
    math.abs(dl) >= 70 ? c : f_shift(c, bgLight ? -(70 - math.abs(dl)) - 20 : (70 - math.abs(dl)) + 20)
// text on a solid colour: dark on light colours, white on dark ones
f_on(color c) =>
    f_lum(c) > 165 ? #131722 : #FFFFFF
color iLong = f_adj(iPal == "Blue / Pink" ? #2962FF : iPal == "Blue / Red" ? #2962FF : iPal == "Teal / Orange" ? #00897B : iPal == "Green / Red" ? #089981 : iLongIn)
color iShort = f_adj(iPal == "Blue / Pink" ? #D81B60 : iPal == "Blue / Red" ? #F23645 : iPal == "Teal / Orange" ? #F57C00 : iPal == "Green / Red" ? #F23645 : iShortIn)
color cTx = iTheme == "Auto" ? chart.fg_color : bgLight ? #131722 : #E8EAED
color cMu = iTheme == "Auto" ? color.from_gradient(45, 0, 100, chart.fg_color, chart.bg_color) : bgLight ? #6A6D78 : #9598A1
color cPan = iTheme == "Auto" ? f_shift(chart.bg_color, bgLight ? -10 : 12) : bgLight ? #FFFFFF : #1E222D
color cFrm = iTheme == "Auto" ? f_shift(chart.bg_color, bgLight ? -40 : 40) : bgLight ? #D1D4DC : #363A45
color cOk = f_adj(#089981)
color cBad = f_adj(#F23645)
color cWarn = f_adj(#FF9800)
color cNeu = #787B86
pSz = iPSz == "Tiny" ? size.tiny : iPSz == "Normal" ? size.normal : size.small
hSz = iPSz == "Tiny" ? size.small : size.normal

