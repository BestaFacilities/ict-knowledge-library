int iLrlLook = input.int(180, "LRL touches: look back (min)", minval = 30, maxval = 600, group = G_L, tooltip = "untaken failure swings (highs / lows that took nothing and are still standing) between entry and the far edge of TP1 count as LRL: the staircase leading to the draw and the taps at it. need 2 for a continuation, 3 for a reversal")
bool iLrlMk = input.bool(true, "Mark the LRL touches (last setup)", group = G_L)
float iEqTol = input.float(0, "Equal highs/lows tolerance (pts)", minval = 0, step = 0.25, group = G_L, tooltip = "0 = auto: 3 pts NQ / MNQ, 0.75 ES / MES")
bool iLvShow = input.bool(true, "Draw the nearest levels", inline = "lv", group = G_L)
int iLvN = input.int(2, "", minval = 0, maxval = 6, inline = "lv", group = G_L, tooltip = "Nearest additional non-priority levels per side. With core session + PDH/PDL priority on, this count is in addition to enabled core levels, including the combined NY range. Clean uses one additional level per side.")
bool iLvCore = input.bool(true, "Always show sessions + PDH/PDL", group = G_L, tooltip = "When on, every enabled, untaken completed-session Asia/London/Premarket/NY high/low and PDH/PDL is shown beyond the per-side count. The count adds nearby secondary levels. Clean keeps these plus one additional level per side. Off makes the count apply to all levels. Existing individual session and Previous day H/L switches still apply.")
bool iLvSwept = input.bool(true, "Keep swept levels to their sweep", group = G_L, tooltip = "Display only: keep a muted line from the level's chart anchor through the bar that swept it, then stop. The consumed level is still removed from active sweep/target logic. Off restores removal from the display.")
int iLvHist = input.int(20, "Swept levels kept", minval = 1, maxval = 60, group = G_L, tooltip = "Maximum historical segments; completed-session (including the combined NY range) and PDH/PDL hits are retained ahead of secondary swings. Lower this to reduce chart objects.")

string iWin = input.string("2000-0000,0200-0500,0930-1100", "Trading windows (NY)", group = G_C)
