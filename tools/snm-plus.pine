bool iNewsBg = input.bool(true, "Shade the blackout", group = G_C)
string iZInvalid = input.string("Hybrid (HTF close)", "HTF FVG invalidation", options = ["Hybrid (HTF close)", "Chart close (3.50)"], group = G_C, tooltip = "Hybrid: a chart-TF close beyond the edge marks an HTF slot gap BREACHED and removes its delivery/target sponsorship immediately. The box remains informational until its own HTF candle closes: a close beyond deletes it; a reclaim clears BREACHED only from that HTF close onward. Chart close restores 3.50 removal.")
