bool iNy = input.bool(true, "New York (NY)", inline = "ny", group = G_L, tooltip = "One combined NY high/low range, replacing separate NY AM and NY PM pools. Completed levels enter the existing liquidity, sweep, target and setup logic.")
string sNy = input.session("0930-1600", "", inline = "ny", group = G_L, tooltip = "New York time; default 09:30–16:00. This is the single combined NY liquidity range, independent of the NY AM rulebook window.")
bool iSessDate = input.bool(true, "Date-stamp Asia/London/NY labels", group = G_L, tooltip = "On: prefix these session high/low labels with the NY date (DD/MM). Off: keep the same active levels but show their undated names.")
bool iPD = input.bool(true, "Previous day H/L", inline = "k", group = G_L)
