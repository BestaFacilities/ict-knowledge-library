bool iNewsBg = input.bool(true, "Shade the blackout", group = G_C)
string iZMode = input.string("Fixed", "HTF gap timeframe mode", options = ["Fixed", "Auto"], group = G_C, tooltip = "Fixed preserves the 3.48 15m/1H/4H delivery slots. Auto selects three strictly higher TFs from the entry chart (1m/3m → 15m/1H/4H, 5m/15m → 1H/4H/1D). This changes delivery and available targets only when enabled.")
