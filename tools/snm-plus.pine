string iPairMode = input.string("Auto", "SMT sibling", options = ["Auto", "Manual"], group = G_C, tooltip = "Auto keeps SNM+ 3.47's NQ/ES and MNQ/MES pairing. Manual permits another symbol; if the feed has no data, SMT/ES checks will be unavailable, not silently treated as confirmed.")
string iManualPair = input.symbol("CME_MINI:ES1!", "Manual SMT symbol", group = G_C, tooltip = "Only used when SMT sibling = Manual. For gold, choose the exact correlated feed available on your TradingView account; an invalid feed cannot validate SMT.")
int iMfiLen = input.int(14, "Volume oscillator length (MFI)", minval = 5, group = G_C)

float iRiskP = input.float(200, "Risk A++ / A+ ($)", minval = 0, group = G_R)
float iRiskA = input.float(150, "Risk A ($)", minval = 0, group = G_R)
float iMaxStop = input.float(0, "Max stop (pts)", minval = 0, group = G_R, tooltip = "0 = auto: 75 on NQ / MNQ, 18 on ES / MES. wider stops are flagged, not hidden")

string iInvalidDraw = input.string("Keep", "Drawings after stop", options = ["Keep", "Dim", "Hide"], group = G_D, tooltip = "Display-only: after a confirmed setup's chosen stop is touched on a later bar, keep it, dim its objects or hide them. Does not delete the setup record, change grades, alerts, or the optional outcome tracker. Keep = 3.48 behaviour.")
string iInvalidTouch = input.string("Wick", "Stop touch means", options = ["Wick", "Close"], group = G_D, tooltip = "For the optional Dim/Hide display only. Wick = price touches the stop intrabar; Close = candle closes strictly through it. Outcome tracking still uses its own conservative wick stop.")
bool iBe = input.bool(true, "BE line (nearest internal structure)", group = G_D)
bool iTp2 = input.bool(true, "TP2 line (runner draw)", group = G_D)
bool iAlOn = input.bool(true, "Enable alerts", group = G_A)
bool iAlConfirmed = input.bool(true, "Confirmed", inline = "al", group = G_A)
bool iAlPreview = input.bool(true, "", inline = "al", group = G_A)
bool iAlRejected = input.bool(true, "", inline = "al", group = G_A)
bool iAlBlockedB = input.bool(false, "Alert rulebook-blocked B (study)", group = G_A, tooltip = "Off: keep rulebook-blocked B tags but suppress their confirmed alerts. On: send marked STUDY BLOCKED alerts. Grade, entry, news and alert windows stay unchanged.")
bool iAlWindow = input.bool(false, "Use separate alert windows (NY)", group = G_A, tooltip = "Off: preserve SNM+ 3.47's trading-window alerts. On: alerts must be inside the trading windows AND one of these alert windows. News blackout still suppresses alerts.")
string iAlS1 = input.session("0930-1100", "Alert window 1 (NY)", group = G_A)
bool iAlS2On = input.bool(false, "Alert window 2", inline = "al2", group = G_A)
string iAlS2 = input.session("0200-0500", "", inline = "al2", group = G_A)
bool iTrack = input.bool(false, "Auto outcome (backtest)", group = G_D, tooltip = "follows each confirmed setup with the rulebook plan: stop, BE at internal structure, half at TP1 (or 2R if TP1 is under 1.5R), runner to TP2, flip on an opposite setup, 2h time stop. writes the R result, MFE / MAE and whether the wick CE / iFVG edge stops were hit. mechanical, conservative (stop first when a candle hits both)")
bool iMap = input.bool(true, "Status line (what to wait for)", group = G_D, tooltip = "one line at the top, checked in order, first match wins: outside windows · news · day done · no direction · set bias · HTF conflict · confirmed · armed · at the zone, wait for a sweep · wait for delivery. it never says buy or sell: it says which checklist step you are on and what has to happen next")
int iMapMin = input.int(45, "Map: a tap counts as respected for (min)", minval = 5, maxval = 240, group = G_D)
bool iRib = input.bool(true, "Timing ribbon (windows, macro, news)", group = G_D)
bool iEsChk = input.bool(true, "ES checks (delivery + FVG SMT)", group = G_C, tooltip = "rulebook D: ES also delivering from a HTF FVG, and no FVG SMT (NQ prints the gap, ES does not = low probability)")
string iTrade = input.string("Last setup", "Entry / stop / target lines", options = ["Last setup", "All setups", "Off"], group = G_D, tooltip = "Last setup = older setups keep their label and iFVG box only")
int iDays = input.int(5, "History to calculate (days)", minval = 1, maxval = 60, group = G_D, tooltip = "SNM+ only runs its engine on the last N days before the last candle (in replay: before the replay candle). 5 days loads fast and is enough for every level and gap a session needs. raise it only if you want older setups drawn")
int iKeep = input.int(3, "Setups kept on the chart", minval = 1, maxval = 30, group = G_D)
string iDet = input.string("Simple", "Detail level", options = ["Simple", "Full"], group = G_D, tooltip = "Simple: D/T/E panel and plan + missing checks. Full: expanded panel and compact per-check/management tooltip. The verbose Full prose was condensed in 3.59 for TradingView's compiled-token limit; calculations, grades and alerts are unchanged.")
bool iPanel = input.bool(true, "Checklist panel", inline = "pn", group = G_D)
bool iStageRow = input.bool(false, "Show setup state row (study)", group = G_D, tooltip = "Read-only in every view: shows a confirmed evaluated trigger on this bar, or PREV CLOSE for just the next bar, then the active sweep / preview / wait state. Known blockers only; no raw-gap detector. ELIGIBLE is alert eligibility, not delivery. Off draws no new row.")
string iPos = input.string("Auto", "", options = ["Auto", "Top Right", "Top Left", "Middle Right", "Bottom Right", "Bottom Left"], inline = "pn", group = G_D, tooltip = "Auto puts the checklist at middle right on 1m–5m charts so it is nearer the live price row, and bottom right on slower charts. Choose a fixed position to restore the 3.56 bottom-right placement or avoid overlap with other indicators. Tables follow chart corners, not price bars.")
string iSz = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G_D)
string iTheme = input.string("Auto", "Theme", options = ["Auto", "Dark", "Light"], group = G_D, tooltip = "Auto reads your chart background")
string iLbl = input.string("Pills", "Setup labels", options = ["Pills", "Text"], group = G_D, tooltip = "Pills = solid coloured tag, readable on any background")
string iZst = input.string("Grey", "HTF gap boxes", options = ["Grey", "Tinted", "Edges only"], group = G_D, tooltip = "Grey = ManipulationX look, very light. Tinted = blue for FVG+, red for FVG-. Edges only = two thin lines, no fill")
float iFillMax = input.float(0.9, "HTF gaps: rebalanced when filled (fraction)", minval = 0.5, maxval = 1.0, step = 0.05, group = G_D, tooltip = "a gap price has already traded through by this fraction is rebalanced: no longer drawn and no longer used as a target. it still counts as delivery while it holds (no close beyond it)")
bool iZTrim = input.bool(true, "HTF gaps: draw only the unfilled part", group = G_D, tooltip = "like ManipulationX: the part of a gap price has already traded through is not drawn, so a big 1H / 4H gap shrinks as it gets filled. the full gap is still used for the delivery check")
int iZBack = input.int(120, "HTF gaps: box starts at most (candles back)", minval = 20, maxval = 1000, group = G_D, tooltip = "a gap made days ago does not paint the whole chart")
string iPSz = input.string("Small", "Panel text", options = ["Tiny", "Small", "Normal"], group = G_D)
string iPal = input.string("Blue / Pink", "Signal colours", options = ["Blue / Pink", "Blue / Red", "Teal / Orange", "Green / Red", "Custom"], group = G_D, tooltip = "pick a pair that does NOT match your candle colours, so setups never blend into candles. Blue / Pink works with red / green / white / black candles. Custom uses the two colours below. colours too close to your background are corrected automatically")
color iLongIn = input.color(#2962FF, "Custom long", inline = "c", group = G_D)
color iShortIn = input.color(#F23645, "", inline = "c", group = G_D)

// ───────── palette: follows the chart background and text colours; signal colours kept readable on it
f_lum(color c) =>
    0.299 * color.r(c) + 0.587 * color.g(c) + 0.114 * color.b(c)
f_shift(color c, float k) =>
    color.rgb(math.max(0, math.min(255, color.r(c) + k)), math.max(0, math.min(255, color.g(c) + k)), math.max(0, math.min(255, color.b(c) + k)))
float bgLum = f_lum(chart.bg_color)
bool bgLight = iTheme == "Light" or (iTheme == "Auto" and bgLum > 140)
// a colour too close to the background in brightness is pushed away from it
f_adj(color c) =>
    float dl = f_lum(c) - (iTheme == "Auto" ? bgLum : bgLight ? 255.0 : 20.0)
    math.abs(dl) >= 70 ? c : f_shift(c, bgLight ? -(70 - math.abs(dl)) - 20 : (70 - math.abs(dl)) + 20)
// text on a solid colour: dark on light colours, white on dark ones
f_on(color c) =>
    f_lum(c) > 165 ? #131722 : #FFFFFF
color iLong = f_adj(iPal == "Blue / Pink" ? #2962FF : iPal == "Blue / Red" ? #2962FF : iPal == "Teal / Orange" ? #00897B : iPal == "Green / Red" ? #089981 : iLongIn)
color iShort = f_adj(iPal == "Blue / Pink" ? #D81B60 : iPal == "Blue / Red" ? #F23645 : iPal == "Teal / Orange" ? #F57C00 : iPal == "Green / Red" ? #F23645 : iShortIn)
color cTx = iTheme == "Auto" ? chart.fg_color : bgLight ? #131722 : #E8EAED
color cMu = iTheme == "Auto" ? color.from_gradient(45, 0, 100, chart.fg_color, chart.bg_color) : bgLight ? #6A6D78 : #9598A1
color cPan = iTheme == "Auto" ? f_shift(chart.bg_color, bgLight ? -10 : 12) : bgLight ? #FFFFFF : #1E222D
color cFrm = iTheme == "Auto" ? f_shift(chart.bg_color, bgLight ? -40 : 40) : bgLight ? #D1D4DC : #363A45
color cOk = f_adj(#089981)
color cBad = f_adj(#F23645)
color cWarn = f_adj(#FF9800)
color cNeu = #787B86
pSz = iPSz == "Tiny" ? size.tiny : iPSz == "Normal" ? size.normal : size.small
hSz = iPSz == "Tiny" ? size.small : size.normal

// ───────── types
type Lv
    float px
    bool hi
    string nm
    int b
    float op
    bool oTk = false
    bool hrl = false

type LvHit
    float px
    bool hi
    string nm
    int x1
    int sweepB
    int sweepT
    bool core
    line ln
    label lb

type Zn
    int dir
    float top
    float bot
    string tf
    int t0
    int tapB = -1
    float mit = na
    int slot = 0
    bool breached = false

type Gp
    bool bull
    float top
    float bot
    int t0
    int b
    string tf = "1m"
    int rk = 1

type Sw
    bool on = false
    string nm = ""
    int lvB = -1
    float op
    bool oTk = false
    float ext
    int extB = 0
    float pairX
    int b0 = 0
    string dt = ""
    bool key = false
    bool cd = false
    bool xl = false
    int rk = 0

type St
    label lb
    box bx
    array<line> ln
    array<label> tl
    array<label> tc
    float stopPx = na
    int dir = 0
    int madeB = -1
    bool invalid = false

type SigKey
    int d
    float trigger
    int sweepB
    int signalB
    string model

type Tr
    int d
    float en
    float stp
    float risk
    float pL
    float tp2
    float beP
    float slC
    float slE
    int b0
    int t0
    label lb
    string txt
    string tip
    bool part = false
    bool beOn = false
    bool done = false
    bool preT = true
    bool rule = false
    bool hitC = false
    bool hitE = false
    bool tagVisible = true
    float bank = 0.0
    float mfe = 0.0
    float mae = 0.0

type Ui
    string alMsg = ""
    string grade = "-"
    string dir = "-"
    string swept = "-"
    string tm = "-"
    string when = "-"
    string fv = "-"
    bool fvOk = true
    int intL = 2
    int nAp = 0
    int nA = 0
    float dR = 0.0
    int nOut = 0
    int nTk = 0
    int nLoss = 0
    int lastB = -1
    bool lastL = false
    string lastG = ""
    int stageB = -1
    string stageMsg = ""
    string sD = "-"
    string sT = "-"
    string sE = "-"
    int okD = 2
    int okT = 2
    int okE = 2
    string lrl = "-"
    int lrOk = 2

// ───────── data
int cs = timeframe.in_seconds()
float atr = ta.atr(14)
float mfi = ta.mfi(hlc3, iMfiLen)
float ph5 = ta.pivothigh(high, 5, 5)
int extLen = math.max(5, int(iExtMin * 60 / math.max(timeframe.in_seconds(), 1)))
float hhX = ta.highest(high, extLen)[1]
float llX = ta.lowest(low, extLen)[1]
float pl5 = ta.pivotlow(low, 5, 5)
float ph2 = ta.pivothigh(high, 2, 2)
int lrLkG = math.max(10, int(iLrlLook * 60 / math.max(timeframe.in_seconds(), 1)))
int cdBars = math.max(2, int(iCdMin * 60 / math.max(timeframe.in_seconds(), 1)))
float hhE = ta.highest(high, lrLkG)
float llE = ta.lowest(low, lrLkG)
float pl2 = ta.pivotlow(low, 2, 2)

string root = syminfo.root
string autoPairRoot = root == "NQ" ? "ES" : root == "ES" ? "NQ" : root == "MNQ" ? "MES" : root == "MES" ? "MNQ" : ""
string autoPairSym = autoPairRoot == "" ? "" : str.replace(syminfo.tickerid, root, autoPairRoot)
string pairSym = iPairMode == "Manual" ? iManualPair : autoPairSym
string pairRoot = iPairMode == "Manual" ? array.last(str.split(iManualPair, ":")) : autoPairRoot
bool pairConfigured = iSmtOn and pairSym != ""
string pTk = pairConfigured ? pairSym : syminfo.tickerid
[oH, oL, oC] = request.security(pTk, timeframe.period, [high, low, close], ignore_invalid_symbol = true)
bool smtOn = pairConfigured and not na(oH) and not na(oL)
bool esBu = smtOn and not na(oL) and not na(oH[2]) and oL > oH[2]
bool esBe = smtOn and not na(oH) and not na(oL[2]) and oH < oL[2]
float eqTolP = str.startswith(pairRoot, "ES") or str.startswith(pairRoot, "MES") ? 1.0 : 4.0

[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[opdh, opdl] = request.security(pTk, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[opwh, opwl] = request.security(pTk, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

f_hsw() =>
    float pH = ta.pivothigh(high, 2, 2)
    float pL = ta.pivotlow(low, 2, 2)
    [pH[1], pL[1], time[3]]
f_hpx() =>
    [high[3], low[3]]
[hH, hL, hT] = request.security(syminfo.tickerid, "60", f_hsw(), lookahead = barmerge.lookahead_on)
[ohH, ohL] = request.security(pTk, "60", f_hpx(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

// market structure on the chosen timeframe: 1 bullish, -1 bearish, 0 unknown (last closed candle)
f_ms() =>
    var int st = 0
    var float lh = na
    var float ll = na
    float ph = ta.pivothigh(high, 2, 2)
    float pl = ta.pivotlow(low, 2, 2)
    if not na(ph)
        lh := ph
    if not na(pl)
        ll := pl
    if not na(lh) and close > lh
        st := 1
    if not na(ll) and close < ll
        st := -1
    st[1]
int msSt = request.security(syminfo.tickerid, iMsTf, f_ms(), lookahead = barmerge.lookahead_on)

bool newDay = ta.change(time("D")) != 0
int cm = math.max(1, int(timeframe.in_seconds() / 60))
string cTf = str.tostring(cm) + "m"
string zTF1 = iZMode == "Auto" ? (cm <= 3 ? "15" : cm <= 15 ? "60" : cm <= 60 ? "240" : "D") : iZTF1
string zTF2 = iZMode == "Auto" ? (cm <= 3 ? "60" : cm <= 15 ? "240" : cm <= 60 ? "D" : "W") : iZTF2
string zTF3 = iZMode == "Auto" ? (cm <= 3 ? "240" : cm <= 15 ? "D" : cm <= 60 ? "W" : "M") : iZTF3
f_zName(string tf) =>
    int secs = timeframe.in_seconds(tf)
    tf == "D" ? "1D" : tf == "W" ? "1W" : tf == "M" ? "1M" : secs < 3600 ? str.tostring(int(secs / 60)) + "m" : secs < 86400 ? str.tostring(int(secs / 3600)) + "H" : tf
string zNm1 = f_zName(zTF1)
string zNm2 = f_zName(zTF2)
string zNm3 = f_zName(zTF3)
int zSec1 = timeframe.in_seconds(zTF1)
int zSec2 = timeframe.in_seconds(zTF2)
int zSec3 = timeframe.in_seconds(zTF3)
// Rank by the actual selected timeframe, not by a hard-coded label: a 45m / 3H manual
// slot must not silently become a 4H+ reversal-delivery zone.
f_zRank(string tf) =>
    int secs = tf == zNm1 ? timeframe.in_seconds(zTF1) : tf == zNm2 ? timeframe.in_seconds(zTF2) : tf == zNm3 ? timeframe.in_seconds(zTF3) : 0
    secs > 0 and secs < 3600 ? 2 : secs > 0 and secs < 14400 ? 3 : 4

f_zf() =>
    bool bu = low > high[2]
    bool be = high < low[2]
    [bu[1], be[1], high[3], low[1], low[3], high[1], time[3], close[1]]
[u15, e15, ub15, ut15, et15, eb15, k15, zClose1] = request.security(syminfo.tickerid, zTF1, f_zf(), lookahead = barmerge.lookahead_on)
[u60, e60, ub60, ut60, et60, eb60, k60, zClose2] = request.security(syminfo.tickerid, zTF2, f_zf(), lookahead = barmerge.lookahead_on)
[u240, e240, ub240, ut240, et240, eb240, k240, zClose3] = request.security(syminfo.tickerid, zTF3, f_zf(), lookahead = barmerge.lookahead_on)
[u2, e2, ub2, ut2, et2, eb2, k2, _] = request.security(syminfo.tickerid, "2", f_zf(), lookahead = barmerge.lookahead_on)
[u3, e3, ub3, ut3, et3, eb3, k3, _] = request.security(syminfo.tickerid, "3", f_zf(), lookahead = barmerge.lookahead_on)
[u5, e5, ub5, ut5, et5, eb5, k5, _] = request.security(syminfo.tickerid, "5", f_zf(), lookahead = barmerge.lookahead_on)
[fu15, fe15, fub15, fut15, fet15, feb15, fk15, _] = request.security(pTk, "15", f_zf(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[fu60, fe60, fub60, fut60, fet60, feb60, fk60, _] = request.security(pTk, "60", f_zf(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[fu240, fe240, fub240, fut240, fet240, feb240, fk240, _] = request.security(pTk, "240", f_zf(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
// a session list ("2000-0000,0200-0500") checked part by part, every day of the week: without explicit days a session string can skip
// Sunday evening, which is Monday's Asia (the trading day starts at 18:00 New York)
f_in(string ss) =>
    bool r = false
    for part in str.split(ss, ",")
        string t = str.trim(part)
        if str.length(t) > 0
            string u = str.contains(t, ":") ? t : t + ":1234567"
            if not na(time(timeframe.period, u, NY))
                r := true
    r
bool inAs = f_in(sAs)
bool inLo = f_in(sLo)
bool inPr = f_in(sPr)
bool inNy = f_in(sNy)
bool inAm = f_in(sNyRule)
bool inWin = f_in(iWin)
bool inMacro = f_in(iMacro)
f_alertAllowed() =>
    iAlOn and (not iAlWindow or f_in(iAlS1) or (iAlS2On and f_in(iAlS2)))

// news blackout: NFP automatic, other releases typed by hand
var array<int> newsT = array.new<int>()
if barstate.isfirst and str.length(iNewsList) > 0
    for itm in str.split(iNewsList, ",")
        string t = str.trim(itm)
        if str.length(t) >= 15
            float ny = str.tonumber(str.substring(t, 0, 4))
            float nm = str.tonumber(str.substring(t, 5, 7))
            float nd = str.tonumber(str.substring(t, 8, 10))
            float nh = str.tonumber(str.substring(t, 11, 13))
            float nn = str.tonumber(str.substring(t, 13, 15))
            if not na(ny) and not na(nm) and not na(nd) and not na(nh) and not na(nn)
                newsT.push(timestamp(NY, int(ny), int(nm), int(nd), int(nh), int(nn)))
int nBef = iNewsBef * 60000
int nAft = iNewsAft * 60000
bool nfpDay = iNfp and dayofweek(time, NY) == dayofweek.friday and dayofmonth(time, NY) <= 7
int nfpT = timestamp(NY, year(time, NY), month(time, NY), dayofmonth(time, NY), 8, 30)
bool inNfp = iNews and nfpDay and time >= nfpT - nBef and time < nfpT + nAft
bool inList = false
if iNews and newsT.size() > 0
    for nt in newsT
        if time >= nt - nBef and time < nt + nAft
            inList := true
bool inNews = inNfp or inList
string newsWhy = inNfp ? "NFP 08:30" : "news release"
bool okWin = inWin and not inNews
bgcolor(iNewsBg and inNews ? color.new(color.orange, 85) : na, title = "News blackout")

float autoStop = root == "NQ" or root == "MNQ" ? 75.0 : root == "ES" or root == "MES" ? 18.0 : 0.0
float maxStop = iMaxStop > 0 ? iMaxStop : autoStop
float edgeDist = iEdge > 0 ? iEdge : root == "NQ" or root == "MNQ" ? 50.0 : root == "ES" or root == "MES" ? 12.0 : 50 * syminfo.mintick
float eqTol = iEqTol > 0 ? iEqTol : root == "NQ" or root == "MNQ" ? 3.0 : root == "ES" or root == "MES" ? 0.75 : 4 * syminfo.mintick
int minG = iMinG == "A++" ? 3 : iMinG == "A+" ? 2 : iMinG == "A" ? 1 : 0

// ───────── state
var array<Lv> lvs = array.new<Lv>()
var array<LvHit> lvHits = array.new<LvHit>()
var array<Zn> zs = array.new<Zn>()
var array<Gp> gps = array.new<Gp>()
var array<St> sts = array.new<St>()
var Sw swS = Sw.new()
var Sw swL = Sw.new()
var Ui ui = Ui.new()
var array<Tr> trs = array.new<Tr>()
var array<SigKey> sigKeys = array.new<SigKey>()
var array<int> dedupBars = array.new_int()
var array<Zn> zsE = array.new<Zn>()
var array<int> esBuB = array.new<int>()
var array<int> esBeB = array.new<int>()
var array<label> rjLb = array.new<label>()
// T-Spot history: one box per HTF candle of the sequence, plus the wick dot
var array<int> pv = array.new<int>()
var array<int> hiSwB = array.new<int>()
var array<int> loSwB = array.new<int>()
// failure swings (pivots 2/2 that took nothing): LRL touchpoints
var array<float> lrHp = array.new<float>()
var array<int> lrHb = array.new<int>()
var array<float> lrLp = array.new<float>()
var array<int> lrLb = array.new<int>()
var array<float> sH = array.new<float>(4, na)
var array<float> sL = array.new<float>(4, na)
var array<int> sHb = array.new<int>(4, 0)
var array<int> sLb = array.new<int>(4, 0)
var array<int> sHt = array.new<int>(4, 0)
var array<int> sLt = array.new<int>(4, 0)
var array<float> qH = array.new<float>(4, na)
var array<float> qL = array.new<float>(4, na)
var array<bool> sWas = array.new<bool>(4, false)
var int lastPhB = -1
var int lastPlB = -1
var float prevPhH = na
var float prevPhP = na
var float prevPlL = na
var float prevPlP = na

// ───────── helpers
f_sz() =>
    iSz == "Tiny" ? size.tiny : iSz == "Normal" ? size.normal : size.small

f_prc(float p) =>
    na(p) ? "-" : str.tostring(p, format.mintick)

f_ck(bool b) =>
    b ? "✔ " : "✖ "

f_gT(int g) =>
    g == 3 ? "A++" : g == 2 ? "A+" : g == 1 ? "A" : "B"

// Dated labels keep a stable identity so today's session level replaces the prior one.
f_lvKey(string nm) =>
    bool hasDate = str.length(nm) > 6 and str.substring(nm, 2, 3) == "/" and str.substring(nm, 5, 6) == " "
    hasDate ? str.substring(nm, 6, str.length(nm)) : nm

f_sessionLevelName(string sessionName, bool hi, int levelTime) =>
    string base = sessionName + "." + (hi ? "H" : "L")
    sessionName == "PRE" or not iSessDate ? base : str.format_time(levelTime, "dd/MM", NY) + " " + base

f_isDatedSessionLevel(string nm) =>
    string key = f_lvKey(nm)
    key != nm and (key == "ASIA.H" or key == "ASIA.L" or key == "LON.H" or key == "LON.L" or key == "NY.H" or key == "NY.L")

f_isSessionLevel(string nm) =>
    string key = f_lvKey(nm)
    key == "ASIA.H" or key == "ASIA.L" or key == "LON.H" or key == "LON.L" or key == "PRE.H" or key == "PRE.L" or key == "NY.H" or key == "NY.L"

f_isCoreLevel(string nm) =>
    nm == "PDH" or nm == "PDL" or f_isSessionLevel(nm)

// a bar that took liquidity: the high / low it leaves is HRL (protected)
f_mark(bool hi) =>
    array<int> a = hi ? hiSwB : loSwB
    if a.size() == 0 or a.last() != bar_index
        a.push(bar_index)
    if a.size() > 60
        a.shift()
    true

f_addLv(float px, bool hi, string nm, int b, float op, bool uniq, bool noH = false) =>
    if not na(px)
        if uniq and lvs.size() > 0
            for i = lvs.size() - 1 to 0
                if f_lvKey(lvs.get(i).nm) == f_lvKey(nm)
                    lvs.remove(i)
        bool h = not noH and b >= 0 and (hi ? hiSwB.includes(b) : loSwB.includes(b))
        lvs.push(Lv.new(px, hi, nm, b, op, false, h))
        if not uniq
            int c = 0
            for v in lvs
                if v.nm == nm
                    c += 1
            if c > 3
                for i = 0 to lvs.size() - 1
                    if lvs.get(i).nm == nm
                        lvs.remove(i)
                        break
    true

// Keep a separate display-only record: taken levels must stay removed from the live-liquidity registry.
f_lvHitAdd(Lv v) =>
    if iLvSwept and iLvShow
        int sourceB = v.b >= 0 ? v.b : math.max(0, bar_index - 60)
        int x1 = math.max(sourceB, math.max(0, bar_index - 9000))
        bool merged = false
        if lvHits.size() > 0
            for i = lvHits.size() - 1 to 0
                LvHit old = lvHits.get(i)
                if old.sweepB == bar_index and old.hi == v.hi and math.abs(old.px - v.px) <= eqTol
                    if not str.contains(old.nm, v.nm)
                        old.nm := old.nm + " / " + v.nm
                    old.px := v.hi ? math.max(old.px, v.px) : math.min(old.px, v.px)
                    old.x1 := math.min(old.x1, x1)
                    old.core := old.core or f_isCoreLevel(v.nm)
                    line.set_xy1(old.ln, old.x1, old.px)
                    line.set_xy2(old.ln, old.sweepB, old.px)
                    label.set_xy(old.lb, old.sweepB, old.px)
                    label.set_text(old.lb, old.nm + " · swept")
                    label.set_tooltip(old.lb, "Swept " + old.nm + " at " + f_prc(old.px) + " · " + str.format_time(old.sweepT, "dd MMM HH:mm", NY))
                    merged := true
                    break
        if not merged
            line ln = line.new(x1, v.px, bar_index, v.px, color = color.new(cMu, 35), style = line.style_dashed, width = 1)
            string tip = "Swept " + v.nm + " at " + f_prc(v.px) + " · " + str.format_time(time, "dd MMM HH:mm", NY)
            label lb = label.new(bar_index, v.px, v.nm + " · swept", style = label.style_label_right, color = color.new(cTx, 100), textcolor = color.new(cMu, 15), size = size.tiny, tooltip = tip, text_font_family = font.family_monospace)
            lvHits.push(LvHit.new(v.px, v.hi, v.nm, x1, bar_index, time, f_isCoreLevel(v.nm), ln, lb))
        while lvHits.size() > iLvHist
            int drop = 0
            for i = 0 to lvHits.size() - 1
                if not lvHits.get(i).core
                    drop := i
                    break
            LvHit dropped = lvHits.get(drop)
            lvHits.remove(drop)
            line.delete(dropped.ln)
            label.delete(dropped.lb)
    true

// intraday swing: merges with a nearby swing into EQH / EQL
f_addSw(float px, bool hi, int b, float op) =>
    string nm = hi ? "SW H" : "SW L"
    float p = px
    int bb = b
    float o = op
    if lvs.size() > 0
        for i = lvs.size() - 1 to 0
            Lv v = lvs.get(i)
            if v.hi == hi and math.abs(v.px - px) <= eqTol and (str.startswith(v.nm, "SW") or str.startswith(v.nm, "EQ"))
                p := hi ? math.max(p, v.px) : math.min(p, v.px)
                bb := math.min(bb, v.b)
                o := na(o) ? v.op : na(v.op) ? o : hi ? math.max(o, v.op) : math.min(o, v.op)
                nm := hi ? "EQH" : "EQL"
                lvs.remove(i)
    f_addLv(p, hi, nm, bb, o, false, str.startswith(nm, "EQ"))

// the chart bar that holds a higher timeframe high / low
f_exact(bool hi, float px, int b0, int n) =>
    int r = b0
    for k = 0 to n
        int off = bar_index - (b0 + k)
        if off >= 0 and off < 990
            if hi ? high[off] == px : low[off] == px
                r := b0 + k
                break
    r

// how much of a gap price has already traded through (0 = untouched, 1 = fully rebalanced)
f_fill(Zn z) =>
    na(z.mit) ? 0.0 : (z.dir == 1 ? z.top - z.mit : z.mit - z.bot) / math.max(z.top - z.bot, syminfo.mintick)

f_zAdd(int dir, float top, float bot, string tf, int t0, int slot) =>
    if not na(top) and not na(bot) and top > bot
        Zn z = Zn.new(dir, top, bot, tf, t0)
        z.slot := slot
        zs.push(z)
        if zs.size() > 80
            zs.shift()
    true

// a level is taken: start (or extend) the sweep on that side
f_sweep(Lv v) =>
    Sw s = v.hi ? swS : swL
    f_mark(v.hi)
    // which level exactly: name, price, and the time it was made
    int lvOff = bar_index - v.b
    string lvT = ""
    if v.b >= 0 and lvOff < 990
        lvT := " (" + str.format_time(time[lvOff], "HH:mm", NY) + ")"
    // key level: named levels, EQH / EQL, or a swing that was the edge of the local range
    bool isSw = str.startswith(v.nm, "SW")
    bool isKey = not isSw or (v.hi ? v.px >= hhX - eqTol : v.px <= llX + eqTol)
    string lvD = v.nm + " " + f_prc(v.px) + lvT + (isSw and isKey ? " EXT" : isSw ? " internal" : "") + (v.hrl ? " HRL" : "")
    if not s.on or bar_index - s.extB > iInvMax
        int refB = v.b >= 0 and bar_index - v.b < 990 ? v.b : (v.hi ? lastPhB : lastPlB)
        s.on := true
        s.cd := false
        s.xl := false
        s.rk := 0
        s.nm := v.nm
        s.dt := lvD
        s.key := isKey
        s.lvB := refB
        s.op := v.op
        s.oTk := v.oTk
        s.ext := v.hi ? high : low
        s.extB := bar_index
        s.pairX := v.hi ? oH : oL
        s.b0 := bar_index
    else
        if not str.contains(s.nm, v.nm)
            s.nm := s.nm + " + " + v.nm
        s.key := s.key or isKey
        if not str.contains(s.dt, lvD)
            s.dt := s.dt + " + " + lvD
    true

f_swUpd(Sw s, bool hiSide) =>
    if s.on
        if bar_index > s.b0
            if hiSide ? high > s.ext : low < s.ext
                s.ext := hiSide ? high : low
                s.extB := bar_index
                f_mark(hiSide)
            if not na(oH)
                s.pairX := hiSide ? (na(s.pairX) ? oH : math.max(s.pairX, oH)) : (na(s.pairX) ? oL : math.min(s.pairX, oL))
        if bar_index - s.extB > math.max(iInvMax, iSc ? cdBars : 0)
            s.on := false
    true

// Visual-only invalidation. Keep object IDs intact: the optional outcome tracker still owns
// the setup label, and deleting it here would break f_trkEnd's result update.
f_stFade(St st, bool hide) =>
    int tr = hide ? 100 : 72
    if not na(st.lb)
        label.set_color(st.lb, color.new(cNeu, tr))
        label.set_textcolor(st.lb, color.new(cNeu, tr))
        if hide
            label.set_text(st.lb, "")
            label.set_tooltip(st.lb, "")
    if not na(st.bx)
        box.set_bgcolor(st.bx, color.new(cNeu, hide ? 100 : 95))
        box.set_border_color(st.bx, color.new(cNeu, tr))
    for l in st.ln
        if not na(l)
            line.set_color(l, color.new(cNeu, tr))
    for lab in st.tl
        if not na(lab)
            label.set_color(lab, color.new(cNeu, 100))
            label.set_textcolor(lab, color.new(cNeu, tr))
            if hide
                label.set_text(lab, "")
                label.set_tooltip(lab, "")
    for lab in st.tc
        if not na(lab)
            label.set_color(lab, color.new(cNeu, 100))
            label.set_textcolor(lab, color.new(cNeu, tr))
            if hide
                label.set_text(lab, "")
                label.set_tooltip(lab, "")
    true

f_stDel(St st) =>
    st.lb.delete()
    st.bx.delete()
    for l in st.ln
        l.delete()
    for l in st.tl
        l.delete()
    if not na(st.tc)
        for l in st.tc
            l.delete()
    true

f_gAdd(bool u, bool e, float ub, float ut, float et, float eb, int k, string tf, int rk, float gMin) =>
    if u and not na(ut) and not na(ub) and ut - ub >= gMin
        gps.push(Gp.new(true, ut, ub, k, bar_index, tf, rk))
    if e and not na(et) and not na(eb) and et - eb >= gMin
        gps.push(Gp.new(false, et, eb, k, bar_index, tf, rk))
    true

f_pend(bool bullGaps, Gp best, Sw s) =>
    Gp r = na
    for g in gps
        if g.bull == bullGaps and g.rk > best.rk and g.b >= s.extB - 30
            if na(r) or g.rk > r.rk
                r := g
    r

// draws at or beyond `from`. mode: "any" every draw · "ltf" 15m FVGs only (rebalance) · "htf" key levels, 15m+ FVGs (no internal swings)
f_draw(bool isL, int d, float from, string mode) =>
    float tp = na
    string tpN = ""
    bool tpH = false
    float tpFar = na
    if mode != "ltf"
        for v in lvs
            if v.hi == isL and (isL ? v.px >= from : v.px <= from) and not (v.hrl and iHrl == "Skip as target") and not (mode == "htf" and str.startswith(v.nm, "SW"))
                if na(tp) or (isL ? v.px < tp : v.px > tp)
                    tp := v.px
                    tpN := v.nm + (v.hrl ? " · HRL" : " · LRL")
                    tpH := v.hrl
                    tpFar := v.px
    for z in zs
        bool okTf = mode == "any" or (mode == "ltf" ? z.tf == "15m" : true)
        if z.dir == -d and okTf and not z.breached and f_fill(z) < iFillMax
            float edge = isL ? z.bot : z.top
            if isL ? edge >= from : edge <= from
                if na(tp) or (isL ? edge < tp : edge > tp)
                    tp := edge
                    tpN := z.tf + " FVG"
                    tpH := false
                    tpFar := isL ? z.top : z.bot
    [tp, tpN, tpH, tpFar]

// the untaken HTF key level price is edging: recent high (low) within edgeDist below (above) it
f_edge(bool isL, int d) =>
    float ep = na
    string eN = ""
    float eFar = na
    float ref = isL ? hhE : llE
    for v in lvs
        if v.hi == isL and not v.hrl and not str.startswith(v.nm, "SW")
            float dd = isL ? v.px - ref : ref - v.px
            if dd > 0 and dd <= edgeDist and (na(ep) or (isL ? v.px < ep : v.px > ep))
                ep := v.px
                eN := v.nm
                eFar := v.px
    for z in zs
        if z.dir == -d and not z.breached and f_fill(z) < iFillMax
            float edge = isL ? z.bot : z.top
            float dd = isL ? edge - ref : ref - edge
            if dd > 0 and dd <= edgeDist and (na(ep) or (isL ? edge < ep : edge > ep))
                ep := edge
                eN := z.tf + " FVG"
                eFar := isL ? z.top : z.bot
    [ep, eN, eFar, ref]

// CISD level: the open of the run of candles that made the extreme (bearish run for a long, bullish run for a short)
f_cisd(bool isL, int offX) =>
    float cLvl = na
    int cOff = na
    int k = offX
    int stp = 0
    while stp < 3 and k < 989 and not (isL ? close[k] < open[k] : close[k] > open[k])
        k += 1
        stp += 1
    if k < 989 and (isL ? close[k] < open[k] : close[k] > open[k])
        int j = k
        while j < k + 40 and j < 989 and (isL ? close[j] < open[j] : close[j] > open[j])
            cLvl := open[j]
            cOff := j
            j += 1
    [cLvl, cOff]

// ES: HTF gaps of the pair, its delivery at the pair's own extreme, and FVG SMT on a chart gap
f_zAddE(int dir, float top, float bot, string tf, int t0) =>
    if not na(top) and not na(bot) and top > bot
        zsE.push(Zn.new(dir, top, bot, tf, t0))
        if zsE.size() > 40
            zsE.shift()
    true

f_esDel(int d, float pX) =>
    bool ok = false
    string nm = ""
    if not na(pX)
        for z in zsE
            if z.dir == d and pX <= z.top + eqTolP and pX >= z.bot - eqTolP
                ok := true
                nm := z.tf + " FVG"
    [ok, nm]

// 1 = ES printed the same gap (within a candle), 0 = it did not (FVG SMT), 2 = not checked (HTF / CISD trigger, no pair)
f_fsmt(bool bull, int b, string tf) =>
    int r = 2
    if smtOn and tf == cTf
        array<int> a = bull ? esBuB : esBeB
        r := a.includes(b) or a.includes(b - 1) or a.includes(b + 1) ? 1 : 0
    r

// auto outcome: close a tracked setup and write the result on its label only while that tag is visible
f_trkEnd(Tr t, float rr, string ex) =>
    t.done := true
    if t.rule
        ui.dR += rr
        ui.nOut += 1
        if rr < 0
            ui.nLoss += 1
    string res = (rr >= 0 ? "+" : "") + str.tostring(rr, "#.##") + "R · " + ex
    string ot = "\n\nAUTO OUTCOME (mechanical plan): " + res + (t.rule ? " · counted (within the daily rules)" : " · not counted: rulebook limit (trade already open, 2 trades or 2 losses today)")
    ot += "\nMFE " + str.tostring(t.mfe, "#.##") + "R · MAE " + str.tostring(t.mae, "#.##") + "R"
    ot += "\nwick CE stop hit before TP1: " + (na(t.slC) ? "-" : t.hitC ? "Yes" : "No") + " · edge stop hit before TP1: " + (na(t.slE) ? "-" : t.hitE ? "Yes" : "No")
    ot += "\nexit " + str.format_time(time, "dd MMM HH:mm", NY)
    if t.tagVisible
        t.lb.set_text(t.txt + " → " + (rr >= 0 ? "+" : "") + str.tostring(rr, "#.#") + "R")
        t.lb.set_tooltip(t.tip + ot)
    true

f_trk(Tr t) =>
    if not t.done and bar_index > t.b0
        bool isL = t.d == 1
        t.mfe := math.max(t.mfe, isL ? (high - t.en) / t.risk : (t.en - low) / t.risk)
        t.mae := math.max(t.mae, isL ? (t.en - low) / t.risk : (high - t.en) / t.risk)
        if t.preT
            if not na(t.slC) and (isL ? low <= t.slC : high >= t.slC)
                t.hitC := true
            if not na(t.slE) and (isL ? low <= t.slE : high >= t.slE)
                t.hitE := true
        float rr = na
        string ex = ""
        // the stop first when a candle hits both (conservative)
        if isL ? low <= t.stp : high >= t.stp
            float rs = isL ? (t.stp - t.en) / t.risk : (t.en - t.stp) / t.risk
            rr := t.part ? t.bank + 0.5 * rs : rs
            ex := t.part ? "half at TP1, runner at BE" : t.beOn ? "BE" : "SL"
        else
            if not na(t.beP) and not t.beOn and (isL ? high >= t.beP : low <= t.beP)
                t.beOn := true
                t.stp := t.en
            if not t.part and not na(t.pL) and (isL ? high >= t.pL : low <= t.pL)
                t.part := true
                t.preT := false
                t.bank := 0.5 * math.abs(t.pL - t.en) / t.risk
                t.beOn := true
                t.stp := t.en
                if na(t.tp2)
                    rr := 2 * t.bank
                    ex := "all at TP1 (no runner draw)"
            if na(rr) and t.part and not na(t.tp2) and (isL ? high >= t.tp2 : low <= t.tp2)
                rr := t.bank + 0.5 * math.abs(t.tp2 - t.en) / t.risk
                ex := "half at TP1, runner at TP2"
            if na(rr) and time - t.t0 >= 2 * 3600000
                float rc = isL ? (close - t.en) / t.risk : (t.en - close) / t.risk
                rr := t.part ? t.bank + 0.5 * rc : rc
                ex := "time stop (2h)"
        if not na(rr)
            f_trkEnd(t, rr, ex)
    true

// delivery check: the sweep extreme inside a same-direction HTF gap
f_deliv(int d, float ext) =>
    bool htf = false
    int rk = 0
    string nm = ""
    for z in zs
        if z.dir == d and not z.breached and ext <= z.top + 0.25 * atr and ext >= z.bot - 0.25 * atr
            int zr = f_zRank(z.tf)
            if zr > 0
                htf := true
                if zr > rk
                    rk := zr
                    nm := z.tf + " FVG"
    [htf, rk, nm]

// a setup still forming on the live candle: trigger levels and the grade it would get (displacement assumed)
f_preview(int d, Sw s) =>
    bool isL = d == 1
    float buf = 2 * syminfo.mintick
    float trN = na
    string trNt = ""
    int trFs = 2
    float trH = na
    string trHt = ""
    int rkH = 0
    if bar_index - s.extB <= iInvMax
        for g in gps
            if g.bull != isL and g.b >= s.extB - 30 and g.rk > s.rk
                float tl = isL ? g.top : g.bot
                if na(trN) or (isL ? tl < trN : tl > trN)
                    trN := tl
                    trNt := g.tf + " iFVG"
                    trFs := f_fsmt(g.bull, g.b, g.tf)
                if g.rk > rkH or (g.rk == rkH and (isL ? tl < trH : tl > trH))
                    rkH := g.rk
                    trH := tl
                    trHt := g.tf + " iFVG"
    float cl = na
    if iSc and not s.cd and bar_index > s.extB and bar_index - s.extB <= cdBars
        [c1, o1] = f_cisd(isL, bar_index - s.extB)
        cl := c1
    float trig = trN
    string trT = trNt
    if not na(cl) and (na(trig) or (isL ? cl < trig : cl > trig))
        trig := cl
        trT := "CISD"
    int gN = -1
    string mdl = "?"
    float sl = isL ? s.ext - buf : s.ext + buf
    float risk = na
    float tp = na
    string tpN = ""
    if not na(trig) and (isL ? sl < trig : sl > trig)
        risk := math.abs(trig - sl)
        [htf, rk, hN] = f_deliv(d, s.ext)
        string mb = msSt == d ? "C" : msSt == -d ? "R" : "?"
        mdl := mb
        bool isR = mb == "R"
        bool delOk = isR ? rk >= (iRvDel == "15m allowed (more setups)" ? 2 : 3) : htf
        float minP = isL ? trig + iMinR * risk : trig - iMinR * risk
        if isR
            [a1, b1, c1x, d1] = f_draw(isL, d, minP, "ltf")
            if not na(a1)
                tp := a1
                tpN := b1
                mdl := "RB"
            else
                [a2, b2, c2, d2] = f_draw(isL, d, minP, "htf")
                tp := a2
                tpN := b2
                mdl := "RV"
        else
            [eP, eN, eF, eR] = f_edge(isL, d)
            if mb == "C" and not na(eP) and (isL ? eP >= minP : eP <= minP)
                tp := eP
                tpN := eN + " · edged"
            else
                [a3, b3, c3, d3] = f_draw(isL, d, minP, "any")
                tp := a3
                tpN := b3
        bool vsh = bar_index - s.extB <= iVMax or trT == "CISD"
        int miss = (delOk ? 0 : 1) + (vsh ? 0 : 1) + (na(tp) ? 1 : 0)
        gN := miss == 0 ? 2 : miss == 1 ? 1 : 0
        bool bOk = iBias == "Neutral" or (iBias == "Bullish") == isL
        if not (s.key or htf) or not bOk
            gN := 0
        if iHard and isR and not inAm
            gN := 0
    [esOk, esN] = f_esDel(d, s.pairX)
    int fsOut = trT == "CISD" ? 2 : trFs
    [gN, mdl, trig, trT, trH, trHt, cl, sl, risk, tp, tpN, fsOut, esOk, esN]

// ───────── a setup: sweep + iFVG (or Sweep + CISD), graded, drawn
f_isDuplicate(int d, float trigger, int sweepB, string model) =>
    bool dup = false
    if iProx and not na(atr) and sigKeys.size() > 0
        for key in sigKeys
            if key.d == d and key.model == model and key.sweepB == sweepB and bar_index - key.signalB <= iProxBars and math.abs(key.trigger - trigger) < iProxAtr * atr
                dup := true
                break
    dup

f_setup(int d, Gp g, Sw s, Gp pd, bool cd = false) =>
    if d != 0
        bool isL = d == 1
        float buf = 2 * syminfo.mintick
        int offX = math.min(bar_index - s.extB, 989)
        float en = close
        float slX = isL ? s.ext - buf : s.ext + buf
        float slE = isL ? g.bot - buf : g.top + buf
        float bodyE = isL ? math.min(open[offX], close[offX]) : math.max(open[offX], close[offX])
        float slC = (s.ext + bodyE) / 2 + (isL ? -buf : buf)
        float sl = slX
        string slWhy = "sweep extreme"
        if iStop == "iFVG edge"
            sl := slE
            slWhy := cd ? "CISD edge" : "iFVG edge"
        else if iStop == "Wick CE"
            sl := slC
            slWhy := "wick CE"
        if isL ? sl >= en : sl <= en
            sl := slX
            slWhy := "sweep extreme"
        float risk = math.abs(en - sl)
        bool slOk = risk > 0 and (isL ? sl < en : sl > en)
        // base model from the structure; reversals split into RB (rebalance) and RV (reversal) by their draw
        string mb = msSt == d ? "C" : msSt == -d ? "R" : "?"
        string mdl = mb
        // draw on liquidity, per model (HRL skipped unless "Flag only")
        float tp = na
        string tpN = ""
        bool tpH = false
        float tpFar = na
        float edP = na
        string edN = ""
        float edRef = na
        if slOk
            float minP = isL ? en + iMinR * risk : en - iMinR * risk
            [eP, eNm, eFr, eRf] = f_edge(isL, d)
            edP := eP
            edN := eNm
            edRef := eRf
            if mb == "R"
                // rebalance: the 15m FVG left on the move; else the full reversal to the HTF DOL
                [a1, b1, c1, d1] = f_draw(isL, d, minP, "ltf")
                if not na(a1)
                    tp := a1
                    tpN := b1
                    tpH := c1
                    tpFar := d1
                    mdl := "RB"
                else
                    [a2, b2, c2, d2] = f_draw(isL, d, minP, "htf")
                    tp := a2
                    tpN := b2
                    tpH := c2
                    tpFar := d2
                    mdl := "RV"
            else if mb == "C" and not na(eP) and (isL ? eP >= minP : eP <= minP)
                // continuation: the key level price is edging
                tp := eP
                tpN := eNm + " · edged"
                tpFar := eFr
            else
                [a3, b3, c3, d3] = f_draw(isL, d, minP, "any")
                tp := a3
                tpN := b3
                tpH := c3
                tpFar := d3
        bool dol = not na(tp)
        // LRL: untaken failure swings between entry and the far edge of TP1 (staircase leading to it + taps at it)
        int lrLk = math.max(10, int(iLrlLook * 60 / math.max(cs, 1)))
        array<float> lrP = array.new<float>()
        array<int> lrB = array.new<int>()
        if dol
            array<float> ap = isL ? lrHp : lrLp
            array<int> ab = isL ? lrHb : lrLb
            if ap.size() > 0
                for i = 0 to ap.size() - 1
                    float pp = ap.get(i)
                    int pb = ab.get(i)
                    bool inZ = isL ? pp > en and pp <= math.max(tp, tpFar) : pp < en and pp >= math.min(tp, tpFar)
                    if inZ and pb < bar_index and bar_index - pb <= lrLk
                        lrP.push(pp)
                        lrB.push(pb)
        int lrN = lrP.size()
        // the nearest HRL between entry and the draw: protected, can block the move
        float blkPx = na
        string blkN = ""
        if dol
            for v in lvs
                if v.hrl and v.hi == isL and (isL ? v.px > en and v.px < tp : v.px < en and v.px > tp)
                    if na(blkPx) or (isL ? v.px < blkPx : v.px > blkPx)
                        blkPx := v.px
                        blkN := v.nm
        // management: BE at the nearest internal structure before TP1, TP2 = next draw beyond TP1 (runner)
        float beP = na
        string beN = ""
        float tp2 = na
        string tp2N = ""
        if dol
            for v in lvs
                if v.hi == isL
                    if isL ? v.px > en and v.px < tp : v.px < en and v.px > tp
                        if na(beP) or (isL ? v.px < beP : v.px > beP)
                            beP := v.px
                            beN := v.nm + (v.hrl ? " · HRL" : "")
            [t2a, t2b, t2c, t2d] = f_draw(isL, d, isL ? tp + 0.5 * risk : tp - 0.5 * risk, "htf")
            tp2 := t2a
            tp2N := t2b
        bool intTk = false
        array<int> tsb = isL ? hiSwB : loSwB
        if tsb.size() > 0
            for bb in tsb
                if bb > s.extB and bb <= bar_index
                    intTk := true
        float r1 = dol and risk > 0 ? math.abs(tp - en) / risk : na
        float p2R = isL ? en + 2 * risk : en - 2 * risk
        // rulebook checks
        bool vsh = bar_index - s.extB <= iVMax
        float body = math.abs(close - open)
        float rng = high - low
        bool dispB = (isL ? close > open : close < open) and rng > 0 and body >= iDispAtr * atr and body / rng >= 0.55
        // the close must also be clearly beyond the trigger level (FVG far edge or CISD level)
        float trgL = isL ? g.top : g.bot
        float clr = isL ? close - trgL : trgL - close
        bool clrOk = clr >= math.max(iClrAtr * atr, 2 * syminfo.mintick)
        bool disp = dispB and clrOk
        bool htf = false
        string htfN = ""
        int htfRk = 0
        for z in zs
            if z.dir == d and z.tf != "5m" and not z.breached and s.ext <= z.top + 0.25 * atr and s.ext >= z.bot - 0.25 * atr
                int zr = f_zRank(z.tf)
                htf := true
                if zr > htfRk
                    htfRk := zr
                    htfN := z.tf + " FVG"
        // CISD: close beyond the open of the run that made the extreme
        [cLvl, cOffX] = f_cisd(isL, offX)
        bool cisd = cd or (not na(cLvl) and (isL ? close > cLvl : close < cLvl))
        // volume divergence: price takes the level, the money flow does not follow
        bool div = false
        int oRef = bar_index - s.lvB
        if s.lvB >= 0 and oRef > offX and oRef < 990
            float m1 = mfi[oRef]
            float m2 = mfi[offX]
            div := not na(m1) and not na(m2) and (isL ? m2 > m1 : m2 < m1)
        // SMT: the pair did not take its own matching level
        bool smt = smtOn and not na(s.op) and not s.oTk and not na(s.pairX) and (isL ? s.pairX >= s.op : s.pairX <= s.op)
        // TTrades Fractal Model: the last closed HTF candle (C2) confirms the swing
        // C2 closure: swept the previous candle's low (high) and closed back inside · C3 closure: no sweep, closed beyond the body of the previous candle
        // the entry wick (sweep extreme) formed inside the T-Spot of the HTF candle
        // PSP: the same HTF candle closed a different colour on the pair
        bool smtP = smt
        // time based exits: the next 15m / 30m / 1H closes
        int nx15 = int(math.ceil(time_close / 900000.0)) * 900000
        int nx30 = int(math.ceil(time_close / 1800000.0)) * 1800000
        int nx60 = int(math.ceil(time_close / 3600000.0)) * 3600000
        bool pre = str.contains(s.nm, "PRE")
        float trig = high - low
        // a higher timeframe gap still open in the leg (read safely, pd can be na)
        bool hiOk = na(pd)
        string pdTxt = ""
        string pdTf = ""
        if not hiOk
            pdTf := pd.tf
            pdTxt := " · " + pd.tf + " gap still open " + f_prc(pd.bot) + " - " + f_prc(pd.top)
        // reversals (RB / RV) only in NY AM (rulebook section 2), from 1H+ (or 15m if allowed)
        bool isR = mb == "R"
        bool rBad = isR and not inAm
        int lrNeed = isR ? 3 : 2
        bool delOk = isR ? htfRk >= (iRvDel == "15m allowed (more setups)" ? 2 : 3) : htf
        bool lrOk = lrN >= lrNeed
        bool bOk = iBias == "Neutral" or (iBias == "Bullish") == isL
        bool scBad = cd and not inAm
        int miss = (delOk ? 0 : 1) + (vsh or cd ? 0 : 1) + (disp ? 0 : 1) + (dol ? 0 : 1)
        int gN = miss == 0 ? 2 : miss == 1 ? 1 : 0
        if gN == 2 and pre and inMacro and isR
            gN := 3
        // internal sweep: counts only when it happens inside an HTF FVG (continuation stop-hunt 6.1, or a reversal off the HTF PD array)
        bool intSw = not s.key and htf
        if not s.key and not intSw
            gN := 0
        if not bOk
            gN := 0
        // rulebook blocks: reversal or Sweep + CISD outside NY AM = not allowed
        bool hardB = iHard and (rBad or scBad)
        if hardB
            gN := 0
        // a reversal needs SMT
        if iSmtR and isR and smtOn and not smt and gN > 0
            gN := gN == 3 ? 1 : gN - 1
        int conf = (cisd ? 1 : 0) + (div ? 1 : 0) + (smtP ? 1 : 0)
        float triggerPx = isL ? g.top : g.bot
        bool duplicate = f_isDuplicate(d, triggerPx, s.b0, mdl)
        if duplicate
            dedupBars.push(bar_index)
            if dedupBars.size() > 30
                dedupBars.shift()
        bool show = slOk and gN >= minG and (okWin or iOut == "Dim") and not duplicate
        // Store only the most recent evaluated trigger on this bar; never alter the setup/alert gates.
        if iStageRow
            string why = not slOk ? "STOP" : not (s.key or intSw) ? "SWEEP" : not bOk ? "BIAS" : hardB ? "NY RULEBOOK" : not delOk ? "NO HTF" : not (vsh or cd) ? "V-SHAPE" : not disp ? "DISPLACEMENT" : not dol ? "NO TARGET" : iSmtR and isR and smtOn and not smt ? "SMT" : duplicate ? "DUPLICATE" : not okWin ? (inNews ? "NEWS" : "WINDOW") : "BELOW " + iMinG
            bool eligible = show and okWin and (not hardB or iAlBlockedB) and iAlConfirmed and f_alertAllowed()
            string noAlert = not okWin ? (inNews ? "NEWS" : "WINDOW") : hardB and not iAlBlockedB ? "RULEBOOK B" : not iAlOn ? "ALERTS OFF" : not iAlConfirmed ? "CONFIRMED OFF" : "ALERT WINDOW"
            ui.stageB := bar_index
            ui.stageMsg := (isL ? "L " : "S ") + (cd ? "CISD" : g.tf + " iFVG") + " · " + (show ? "CONF " + f_gT(gN) + (eligible ? (hardB ? " · STUDY ELIGIBLE" : " · ELIGIBLE") : " · NO ALERT " + noAlert) : "BLOCK " + why)
        if show
            sigKeys.push(SigKey.new(d, triggerPx, s.b0, bar_index, mdl))
            while sigKeys.size() > 30
                sigKeys.shift()
            float riskUsd = gN >= 2 ? iRiskP : iRiskA
            int n = syminfo.pointvalue > 0 ? int(math.floor(riskUsd / (risk * syminfo.pointvalue))) : 0
            bool wide = maxStop > 0 and risk > maxStop
            string gT = f_gT(gN)
            // simple tooltip: plan + only what is missing
            string miss2 = ""
            if not (s.key or intSw)
                miss2 += "\n✖ internal sweep outside any HTF FVG"
            if not delOk
                miss2 += "\n✖ HTF delivery" + (htf ? " (" + htfN + ", a reversal needs " + (iRvDel == "15m allowed (more setups)" ? "15m+" : "1H+") + ")" : "")
            if not dol
                miss2 += "\n✖ no draw at " + str.tostring(iMinR) + "R or more"
            if dol and not lrOk
                miss2 += "\n✖ LRL " + str.tostring(lrN) + " / " + str.tostring(lrNeed)
            if tpH
                miss2 += "\n✖ the draw is HRL (protected)"
            if not vsh and not cd
                miss2 += "\n✖ V-shape (" + str.tostring(bar_index - s.extB) + " candles)"
            if not disp
                miss2 += "\n✖ displacement" + (clrOk ? " (weak body)" : " (close only " + str.tostring(clr, "#.##") + " pts beyond the trigger)")
            if not cd and not hiOk
                miss2 += "\n✖ highest TF iFVG (" + pdTf + " gap still open)"
            if intTk
                miss2 += "\n✖ internal liquidity already swept"
            if isR and smtOn and not smt
                miss2 += "\n✖ reversal without SMT"
            if rBad or scBad
                miss2 += "\n✖ not allowed outside NY AM"
            if not bOk
                miss2 += "\n✖ against your bias"
            if wide
                miss2 += "\n✖ stop wider than " + str.tostring(maxStop) + " pts"
            if not na(blkPx)
                miss2 += "\n⚠ HRL in the way at " + f_prc(blkPx) + " (" + str.tostring(math.abs(blkPx - en) / risk, "#.#") + "R): BE / partial there"
            string tipS = (hardB ? "NOT ALLOWED · " : "") + (isL ? "LONG " : "SHORT ") + gT + " · " + mdl + (cd ? " · CISD" : " · iFVG " + g.tf) + " · confluence " + str.tostring(conf) + "/3" + (okWin ? "" : inNews ? " · NEWS" : " · outside windows")
            tipS += "\n\nentry " + f_prc(en) + " · stop " + f_prc(sl) + " (" + str.tostring(risk, "#.##") + " pts) · size " + str.tostring(n) + " (" + syminfo.ticker + ") at $" + str.tostring(riskUsd) + " budget"
            tipS += dol ? "\nTP1 " + f_prc(tp) + " · " + tpN + " · " + str.tostring(math.abs(tp - en) / risk, "#.#") + "R" : "\nno TP1 draw"
            tipS += (na(beP) ? "" : "\nBE at " + f_prc(beP)) + (na(tp2) ? "" : "\nTP2 " + f_prc(tp2) + " (" + str.tostring(math.abs(tp2 - en) / risk, "#.#") + "R)")
            if n == 0
                miss2 += "\n✖ SIZE 0 · check risk budget and chart point value; not a tradable size"
            tipS += miss2 == "" ? "\n\n✔ every check passed" : "\n" + miss2
            tipS += "\n\nswept: " + s.dt
            // Full keeps a compact checklist and plan instead of compiling a second,
            // mostly duplicated long-form explanation for every setup path.
            string tip = tipS
            if iDet == "Full"
                tip += "\n\nCHECKS"
                tip += "\n" + f_ck(s.key or intSw) + "sweep " + s.dt
                tip += "\n" + f_ck(hiOk or cd) + "highest iFVG" + pdTxt
                tip += "\n" + f_ck(vsh or cd) + "V-shape " + str.tostring(bar_index - s.extB) + " bars"
                tip += "\n" + f_ck(disp) + "displacement · " + str.tostring(body, "#.##") + " pts body, " + str.tostring(clr, "#.##") + " pts clear"
                tip += "\n" + f_ck(delOk) + "HTF delivery" + (htf ? " · " + htfN : "")
                tip += "\n" + f_ck(dol) + "target" + (dol ? " · " + tpN : "")
                tip += "\n" + f_ck(lrOk) + "LRL " + str.tostring(lrN) + "/" + str.tostring(lrNeed)
                tip += "\n" + f_ck(not intTk) + "internal liq. untouched"
                tip += "\n" + f_ck(cisd) + "CISD" + (na(cLvl) ? "" : " " + f_prc(cLvl))
                tip += "\n" + f_ck(div) + "volume divergence"
                tip += "\n" + f_ck(smtP) + "SMT" + (smtOn ? " " + pairRoot : " (off)")
                if smtOn and iEsChk
                    [esOk, esN] = f_esDel(d, s.pairX)
                    int fs = cd ? 2 : f_fsmt(g.bull, g.b, g.tf)
                    tip += "\n" + f_ck(esOk) + pairRoot + " delivery" + (esOk ? " " + esN : "")
                    tip += fs == 2 ? "" : "\n" + f_ck(fs == 1) + "pair printed gap"
                tip += "\n" + f_ck(bOk) + "bias" + (pre ? " · PRE" : "") + (inMacro ? " · macro" : "")
                tip += "\nstop " + slWhy + " · BE " + (na(beP) ? "none" : beN + " " + f_prc(beP))
                tip += "\npartial " + (dol ? (r1 >= 1.5 ? "half TP1" : "half 2R " + f_prc(p2R)) : "no target")
                tip += "\nexits 15m " + str.format_time(nx15, "HH:mm", NY) + " · 30m " + str.format_time(nx30, "HH:mm", NY) + " · 1H " + str.format_time(nx60, "HH:mm", NY)
                tip += "\n" + str.tostring(n) + " contracts" + (wide ? " · WIDE STOP" : "")

            color c = not okWin ? color.gray : isL ? iLong : iShort
            St st = St.new(ln = array.new<line>(), tl = array.new<label>(), tc = array.new<label>())
            st.stopPx := sl
            st.dir := d
            st.madeB := bar_index
            st.bx := box.new(g.t0, g.top, time, g.bot, xloc = xloc.bar_time, border_color = color.new(c, 100), bgcolor = color.new(c, 85))
            // iFVG tag with hover info
            int gOff = math.min(bar_index - g.b, 989)
            float gMid = (g.top + g.bot) / 2
            string gTip = cd ? "CISD · " + (isL ? "close above the open of the bearish run → long" : "close below the open of the bullish run → short") : g.tf + " iFVG · " + (g.bull ? "bullish gap inversed → short" : "bearish gap inversed → long")
            if cd
                gTip += "\n\nCISD level " + f_prc(isL ? g.top : g.bot) + " · run started " + str.format_time(time[gOff], "HH:mm", NY) + " · closed through " + str.format_time(time, "HH:mm", NY)
            else
                gTip += "\n\nrange " + f_prc(g.bot) + " - " + f_prc(g.top) + " · " + str.tostring(g.top - g.bot, "#.##") + " pts"
                gTip += "\nCE (50%) " + f_prc(gMid)
                gTip += "\ngap confirmed " + str.format_time(time[gOff], "HH:mm", NY) + " · inversed " + str.format_time(time, "HH:mm", NY)
            gTip += "\n" + str.tostring(bar_index - s.extB) + " candles from the extreme (V-shape max " + str.tostring(iVMax) + ")"
            gTip += "\ntrigger body " + str.tostring(body, "#.##") + " pts · " + (disp ? "displacement ✔" : "no displacement ✖")
            gTip += cd ? "" : "\n\n" + f_ck(hiOk) + "highest TF iFVG in the leg" + pdTxt
            st.tl.push(label.new(g.t0, gMid, (cd ? "CISD" : g.tf + " iFVG"), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 100), textcolor = c, size = size.tiny, tooltip = gTip, text_font_family = font.family_monospace))
            string lbTxt = (isL ? "▲ " : "▼ ") + gT + " " + str.tostring(conf) + "/3 " + mdl + (rBad or scBad ? "✖" : "") + (cd ? " CISD" : "") + (inNews ? " NEWS" : "")
            bool pill = iLbl == "Pills"
            st.lb := label.new(bar_index, isL ? low : high, lbTxt, xloc = xloc.bar_index, yloc = isL ? yloc.belowbar : yloc.abovebar, style = pill ? (isL ? label.style_label_up : label.style_label_down) : label.style_none, color = color.new(c, not pill ? 100 : gN >= 2 ? 0 : 35), textcolor = color.new(pill ? f_on(c) : c, 0), size = f_sz(), tooltip = tip, text_font_family = font.family_monospace)
            // older setup: keep label and iFVG box, drop its trade lines
            if iTrade == "Last setup" and sts.size() > 0
                St prv = sts.last()
                for l in prv.ln
                    l.delete()
                prv.ln.clear()
                while prv.tl.size() > 1
                    prv.tl.pop().delete()
                if not na(prv.tc)
                    for l in prv.tc
                        l.delete()
                    prv.tc.clear()
            if iTrade != "Off"
                int x2 = bar_index + 15
                color nc = color.new(c, 100)
                st.ln.push(line.new(bar_index, en, x2, en, color = c, width = 2))
                st.ln.push(line.new(bar_index, sl, x2, sl, color = c, style = line.style_dotted))
                st.tl.push(label.new(x2, sl, "SL " + str.tostring(risk, "#") + " pts" + (wide ? " · wide" : ""), style = label.style_label_left, color = nc, textcolor = c, size = size.tiny, text_font_family = font.family_monospace))
                if dol
                    st.ln.push(line.new(bar_index, tp, x2, tp, color = c, style = line.style_dotted))
                    st.tl.push(label.new(x2, tp, "TP " + str.tostring(math.abs(tp - en) / risk, "#.#") + "R · " + tpN, style = label.style_label_left, color = nc, textcolor = c, size = size.tiny, text_font_family = font.family_monospace))
                if iBe and not na(beP)
                    st.ln.push(line.new(bar_index, beP, x2, beP, color = color.new(c, 40), style = line.style_dashed))
                    st.tl.push(label.new(x2, beP, "BE · " + beN, style = label.style_label_left, color = nc, textcolor = color.new(c, 30), size = size.tiny, text_font_family = font.family_monospace))
                if iTp2 and not na(tp2)
                    st.ln.push(line.new(bar_index, tp2, x2, tp2, color = color.new(c, 40), style = line.style_dotted))
                    st.tl.push(label.new(x2, tp2, "TP2 " + str.tostring(math.abs(tp2 - en) / risk, "#.#") + "R · " + tp2N, style = label.style_label_left, color = nc, textcolor = color.new(c, 30), size = size.tiny, text_font_family = font.family_monospace))
            if iLrlMk and iTrade != "Off" and lrN > 0
                for i = 0 to lrN - 1
                    st.tc.push(label.new(lrB.get(i), lrP.get(i), "○", xloc = xloc.bar_index, yloc = yloc.price, style = isL ? label.style_label_down : label.style_label_up, color = color.new(c, 100), textcolor = color.new(c, 20), size = size.small, tooltip = "LRL touch " + str.tostring(i + 1) + " · " + f_prc(lrP.get(i))))
            // MX Lite keeps older records and tracker references, but prevents later outcome text from resurfacing hidden tags.
            // auto outcome: a new setup flips any open opposite one (rule 10.7), then is tracked itself
            if iTrack and okWin
                for t in trs
                    if not t.done and t.d != d and bar_index > t.b0
                        float rc = t.d == 1 ? (close - t.en) / t.risk : (t.en - close) / t.risk
                        f_trkEnd(t, t.part ? t.bank + 0.5 * rc : rc, "flip (opposite setup)")
                if risk > 0
                    float pL = dol ? (r1 >= 1.5 ? tp : p2R) : na
                    bool openRule = false
                    for t in trs
                        if t.rule and not t.done
                            openRule := true
                    bool allowed = not openRule and ui.nTk < 2 and ui.nLoss < 2
                    if allowed
                        ui.nTk += 1
                    Tr nt = Tr.new(d, en, sl, risk, pL, tp2, beP, slC, slE, bar_index, time, st.lb, lbTxt, tip)
                    nt.rule := allowed
                    nt.tagVisible := true
                    trs.push(nt)
                    while trs.size() > 60
                        trs.shift()
            if okWin
                if gN >= 2
                    ui.nAp += 1
                else if gN == 1
                    ui.nA += 1
            sts.push(st)
            while sts.size() > iKeep
                f_stDel(sts.shift())
            ui.grade := gT + " · " + str.tostring(conf) + "/3"
            ui.dir := (isL ? "LONG" : "SHORT") + " " + mdl + (rBad ? "✖" : "")
            ui.swept := s.nm
            ui.tm := str.format_time(time, "dd MMM HH:mm", NY)
            if okWin
                ui.lastB := bar_index
                ui.lastL := isL
                ui.lastG := gT
            ui.fv := cd ? "CISD" : g.tf + (hiOk ? "" : " · " + pdTf + " open")
            ui.fvOk := hiOk
            ui.when := inNews ? "news" : not inWin ? "outside windows" : inMacro ? "macro" : "in window"
            ui.okD := delOk and (s.key or intSw) ? 1 : 0
            ui.sD := htf ? htfN : "no HTF FVG"
            ui.okT := dol and lrOk and not tpH ? 1 : 0
            ui.sT := dol ? tpN + " " + str.tostring(math.abs(tp - en) / risk, "#.#") + "R" : "no draw"
            ui.okE := (vsh or cd) and disp and (hiOk or cd) and not intTk ? 1 : 0
            ui.sE := cd ? "CISD" : "iFVG " + g.tf
            pv.clear()
            pv.push(vsh ? 1 : 0)
            pv.push(disp ? 1 : 0)
            pv.push(htf ? 1 : 0)
            pv.push(dol ? 1 : 0)
            pv.push(cisd ? 1 : 0)
            pv.push(div ? 1 : 0)
            pv.push(smtOn ? (smtP ? 1 : 0) : 2)
            ui.intL := intTk ? 0 : 1
            ui.lrl := dol ? str.tostring(lrN) + " / " + str.tostring(lrNeed) : "-"
            ui.lrOk := dol ? (lrOk ? 1 : 0) : 2
            // A displayed rulebook-blocked B is informational by default; the explicit
            // study override keeps the original alert windows and marks the payload.
            if okWin and (not hardB or iAlBlockedB)
                ui.alMsg := "SNM+ " + (hardB ? "STUDY BLOCKED · " : "") + (isL ? "LONG " : "SHORT ") + gT + " " + str.tostring(conf) + "/3 " + (mdl == "C" ? "CONTINUATION" : mdl == "RB" ? "REBALANCE" : mdl == "RV" ? "REVERSAL" : "") + (cd ? " SWEEP+CISD" : "") + (rBad ? " (outside NY AM)" : "") + " · " + syminfo.ticker + " · swept " + s.nm + " · entry " + f_prc(en) + " · stop " + f_prc(sl) + " (" + str.tostring(risk, "#") + " pts) · " + (dol ? "TP " + f_prc(tp) + " " + tpN : "no draw") + " · " + str.tostring(n) + " contracts"
    true
// ───────── engine, closed bars only
// only the recent history is calculated: much faster loading
bool calc = time >= last_bar_time - iDays * 86400000
Gp candS = na
Gp candL = na
Gp pendS = na
Gp pendL = na
Gp noPend = na
Gp cisdS = na
Gp cisdL = na
int dirCS = 0
int dirCL = 0
if barstate.isconfirmed and calc
    if newDay
        ui.nAp := 0
        ui.nA := 0
        ui.dR := 0.0
        ui.nOut := 0
        ui.nTk := 0
        ui.nLoss := 0
    // T-Spot history: a new HTF candle opens → close the last one (wick dot), open a new box if there is a closure
    // auto outcome: follow the open setups on this candle, before any new one
    if iTrack and trs.size() > 0
        for t in trs
            f_trk(t)
        // closed trackers are finished: drop them so the loop stays short
        for i = trs.size() - 1 to 0
            if trs.get(i).done
                trs.remove(i)
    // Visual-only invalidation of an older confirmed setup. Never test its own trigger bar;
    // stop-first ambiguity and any historical R result belong to the optional outcome tracker.
    if iInvalidDraw != "Keep" and sts.size() > 0
        for st in sts
            if not st.invalid and st.madeB < bar_index and not na(st.stopPx)
                bool touched = iInvalidTouch == "Wick" ? (st.dir == 1 ? low <= st.stopPx : high >= st.stopPx) : (st.dir == 1 ? close < st.stopPx : close > st.stopPx)
                if touched
                    st.invalid := true
                    f_stFade(st, iInvalidDraw == "Hide")
    // ES gaps on the chart timeframe (FVG SMT)
    if esBu
        esBuB.push(bar_index)
        if esBuB.size() > 200
            esBuB.shift()
    if esBe
        esBeB.push(bar_index)
        if esBeB.size() > 200
            esBeB.shift()
    if not na(ph5)
        lastPhB := bar_index - 5
        if iSw
            f_addSw(ph5, true, bar_index - 5, oH[5])
        if smtOn and not na(oH[5])
            if iSmtDiv and not na(prevPhH) and not na(prevPhP) and ph5 > prevPhH and oH[5] < prevPhP
                label.new(bar_index - 5, ph5, "SMT-", style = label.style_label_up, color = color.new(iShort, 0), textcolor = color.white, size = size.tiny, tooltip = "SMT bearish divergence: chart made a higher high but " + pairRoot + " made a lower high. Informational only.")
            prevPhH := ph5
            prevPhP := oH[5]
    // a failure swing taken by more than the equal tolerance is no longer liquidity
    if lrHp.size() > 0
        for i = lrHp.size() - 1 to 0
            if high > lrHp.get(i) + eqTol
                lrHp.remove(i)
                lrHb.remove(i)
    if lrLp.size() > 0
        for i = lrLp.size() - 1 to 0
            if low < lrLp.get(i) - eqTol
                lrLp.remove(i)
                lrLb.remove(i)
    if not na(ph2) and not hiSwB.includes(bar_index - 2)
        lrHp.push(ph2)
        lrHb.push(bar_index - 2)
        if lrHp.size() > 80
            lrHp.shift()
            lrHb.shift()
    if not na(pl2) and not loSwB.includes(bar_index - 2)
        lrLp.push(pl2)
        lrLb.push(bar_index - 2)
        if lrLp.size() > 80
            lrLp.shift()
            lrLb.shift()
    if not na(pl5)
        lastPlB := bar_index - 5
        if iSw
            f_addSw(pl5, false, bar_index - 5, oL[5])
        if smtOn and not na(oL[5])
            if iSmtDiv and not na(prevPlL) and not na(prevPlP) and pl5 < prevPlL and oL[5] > prevPlP
                label.new(bar_index - 5, pl5, "SMT+", style = label.style_label_down, color = color.new(iLong, 0), textcolor = color.white, size = size.tiny, tooltip = "SMT bullish divergence: chart made a lower low but " + pairRoot + " made a higher low. Informational only.")
            prevPlL := pl5
            prevPlP := oL[5]

    // Completed session highs/lows enter the common active-liquidity registry.
    // NY is one continuous 09:30–16:00 range; NY AM rulebook timing stays separate.
    array<bool> inS = array.from(iAs and inAs, iLo and inLo, iPr and inPr, iNy and inNy)
    array<string> sNm = array.from("ASIA", "LON", "PRE", "NY")
    for s = 0 to 3
        bool cur = inS.get(s)
        bool was = sWas.get(s)
        if cur and not was
            sH.set(s, high)
            sL.set(s, low)
            sHb.set(s, bar_index)
            sLb.set(s, bar_index)
            sHt.set(s, time)
            sLt.set(s, time)
            qH.set(s, oH)
            qL.set(s, oL)
        else if cur
            if high > sH.get(s)
                sH.set(s, high)
                sHb.set(s, bar_index)
                sHt.set(s, time)
            if low < sL.get(s)
                sL.set(s, low)
                sLb.set(s, bar_index)
                sLt.set(s, time)
            if not na(oH)
                qH.set(s, na(qH.get(s)) ? oH : math.max(qH.get(s), oH))
                qL.set(s, na(qL.get(s)) ? oL : math.min(qL.get(s), oL))
        else if was
            f_addLv(sH.get(s), true, f_sessionLevelName(sNm.get(s), true, sHt.get(s)), sHb.get(s), qH.get(s), true, false)
            f_addLv(sL.get(s), false, f_sessionLevelName(sNm.get(s), false, sLt.get(s)), sLb.get(s), qL.get(s), true, false)
        sWas.set(s, cur)

    if iPD and not na(pdh) and pdh != pdh[1]
        f_addLv(pdh, true, "PDH", -1, opdh, true, false)
        f_addLv(pdl, false, "PDL", -1, opdl, true, false)
    if iPW and not na(pwh) and pwh != pwh[1]
        f_addLv(pwh, true, "PWH", -1, opwh, true, false)
        f_addLv(pwl, false, "PWL", -1, opwl, true, false)
    if iH1 and not na(hT) and hT != hT[1]
        int hb = math.max(0, bar_index - int((time - hT) / (cs * 1000)))
        int nb = int(3600 / cs) + 2
        if not na(hH)
            f_addLv(hH, true, "1H H", f_exact(true, hH, hb, nb), ohH, false, false)
        if not na(hL)
            f_addLv(hL, false, "1H L", f_exact(false, hL, hb, nb), ohL, false, false)

    // higher timeframe gaps
    if iZ15 and (iZMode != "Auto" or timeframe.in_seconds(zTF1) > cs) and k15 != k15[1]
        if u15
            f_zAdd(1, ut15, ub15, zNm1, k15, 1)
        if e15
            f_zAdd(-1, et15, eb15, zNm1, k15, 1)
    if iZ60 and (iZMode != "Auto" or timeframe.in_seconds(zTF2) > cs) and k60 != k60[1]
        if u60
            f_zAdd(1, ut60, ub60, zNm2, k60, 2)
        if e60
            f_zAdd(-1, et60, eb60, zNm2, k60, 2)
    if iZ240 and (iZMode != "Auto" or timeframe.in_seconds(zTF3) > cs) and k240 != k240[1]
        if u240
            f_zAdd(1, ut240, ub240, zNm3, k240, 3)
        if e240
            f_zAdd(-1, et240, eb240, zNm3, k240, 3)
    if zs.size() > 0
        for i = zs.size() - 1 to 0
            Zn z = zs.get(i)
            bool beyondChart = z.dir == 1 ? close < z.bot : close > z.top
            // A manually selected equal/lower slot has no reliable nested HTF close here;
            // preserve chart-close invalidation rather than keep an unconfirmable box.
            int slotSeconds = z.slot == 1 ? zSec1 : z.slot == 2 ? zSec2 : z.slot == 3 ? zSec3 : 0
            if iZInvalid == "Hybrid (HTF close)" and z.slot > 0 and slotSeconds > cs
                bool rolled = z.slot == 1 ? k15 != k15[1] : z.slot == 2 ? k60 != k60[1] : k240 != k240[1]
                float htfClose = z.slot == 1 ? zClose1 : z.slot == 2 ? zClose2 : zClose3
                bool beyondHtf = z.dir == 1 ? htfClose < z.bot : htfClose > z.top
                if rolled and not na(htfClose) and beyondHtf
                    zs.remove(i)
                else
                    // Only a confirmed source-TF reclaim can clear the pending state.
                    if rolled and not na(htfClose)
                        z.breached := false
                    if beyondChart
                        if not z.breached
                            z.tapB := -1
                        z.breached := true
            else if beyondChart
                zs.remove(i)
        // taps: price trading into a gap that still holds (session map)
        for z in zs
            if not z.breached and low <= z.top and high >= z.bot
                z.tapB := bar_index
                // how deep price has filled the gap: from the top down for FVG+, from the bottom up for FVG-
                if z.dir == 1
                    z.mit := na(z.mit) ? math.max(low, z.bot) : math.min(z.mit, math.max(low, z.bot))
                else
                    z.mit := na(z.mit) ? math.min(high, z.top) : math.max(z.mit, math.min(high, z.top))
    // ES higher timeframe gaps
    if smtOn and iEsChk
        if fk15 != fk15[1]
            if fu15
                f_zAddE(1, fut15, fub15, "15m", fk15)
            if fe15
                f_zAddE(-1, fet15, feb15, "15m", fk15)
        if fk60 != fk60[1]
            if fu60
                f_zAddE(1, fut60, fub60, "1H", fk60)
            if fe60
                f_zAddE(-1, fet60, feb60, "1H", fk60)
        if fk240 != fk240[1]
            if fu240
                f_zAddE(1, fut240, fub240, "4H", fk240)
            if fe240
                f_zAddE(-1, fet240, feb240, "4H", fk240)
        if zsE.size() > 0 and not na(oC)
            for i = zsE.size() - 1 to 0
                Zn z = zsE.get(i)
                if z.dir == 1 ? oC < z.bot : oC > z.top
                    zsE.remove(i)

    // sweeps
    if lvs.size() > 0
        for i = lvs.size() - 1 to 0
            Lv v = lvs.get(i)
            if v.b < bar_index
                if v.hi ? high > v.px : low < v.px
                    f_sweep(v)
                    f_lvHitAdd(v)
                    lvs.remove(i)
                else if smtOn and not na(v.op) and not na(oH) and (v.hi ? oH > v.op : oL < v.op)
                    v.oTk := true
    f_swUpd(swS, true)
    f_swUpd(swL, false)

    // rejected trigger: the candle traded through an ARMED setup's trigger but closed back (wick, no confirmation)
    if iRej and iPrev
        for side = 0 to 1
            Sw sv = side == 0 ? swS : swL
            int dv = side == 0 ? -1 : 1
            bool isL = dv == 1
            if sv.on and not sv.xl and (okWin or iOut == "Dim")
                [pg, pm, ptr, ptt, ptrH, pttH, pcl, psl, prk, ptp, ptpN, pfs, pes, pesN] = f_preview(dv, sv)
                if pg >= math.max(minG, 1) and not na(ptr)
                    bool thru = isL ? high > ptr : low < ptr
                    bool back = isL ? close <= ptr : close >= ptr
                    if thru and back
                        // did the wick take the liquidity on the target side?
                        bool liqTk = (isL ? hiSwB : loSwB).includes(bar_index)
                        if liqTk
                            sv.xl := true
                        if iStageRow and barstate.isconfirmed
                            ui.stageB := bar_index
                            ui.stageMsg := (isL ? "L " : "S ") + "REJECTED · " + (liqTk ? "LIQ TAKEN" : "CLOSE BACK")
                        float wk = isL ? high : low
                        string rt = "✖ REJECTED · " + (isL ? "LONG " : "SHORT ") + f_gT(pg) + " " + pm
                        rt += "\n\ntraded through trigger " + f_prc(ptr) + " (" + ptt + ") to " + f_prc(wk) + " closed back " + f_prc(close) + ": no confirmation"
                        rt += "\nwick beyond: " + str.tostring(math.abs(wk - ptr), "#.##") + " body " + str.tostring(math.abs(close - open), "#.##")
                        rt += liqTk ? "\n\nwick took target liquidity → cancelled (rule 1.6)" : "\n\nsetup stays armed: later close can confirm"
                        color rc = liqTk ? cWarn : cNeu
                        // full tag only when it matters: target liquidity taken, or an A+ whose wick went clearly through; otherwise a small ×
                        bool deep = math.abs(wk - ptr) >= math.max(iClrAtr * atr, 2 * syminfo.mintick)
                        bool full = liqTk or (pg >= 2 and deep)
                        rjLb.push(full ? label.new(bar_index, ptr, liqTk ? "✖ rejected · liq taken" : "✖ rejected", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(rc, 10), textcolor = f_on(rc), size = size.tiny, tooltip = rt, text_font_family = font.family_monospace) : label.new(bar_index, ptr, "×", xloc = xloc.bar_index, style = label.style_none, textcolor = cMu, size = size.small, tooltip = rt))
                        while rjLb.size() > 20
                            rjLb.shift().delete()
                        if okWin and iAlRejected and f_alertAllowed()
                            alert("SNM+ REJECTED " + (isL ? "LONG " : "SHORT ") + f_gT(pg) + " · " + syminfo.ticker + " · through " + f_prc(ptr) + " closed back" + (liqTk ? " · liq taken, cancelled" : ""), alert.freq_once_per_bar_close)

    // Inspect registered gap close-throughs before removing them. A raw gap that
    // failed size or was never formed is not in this registry (see guide).
    if gps.size() > 0
        for i = gps.size() - 1 to 0
            Gp g = gps.get(i)
            if g.b < bar_index
                if g.bull and close < g.bot
                    if swS.on and bar_index - swS.extB <= iInvMax and g.b >= swS.extB - 30 and g.rk > swS.rk
                        if na(candS)
                            candS := g
                        else if g.rk > candS.rk or (g.rk == candS.rk and g.top - g.bot > candS.top - candS.bot)
                            candS := g
                    gps.remove(i)
                else if not g.bull and close > g.top
                    if swL.on and bar_index - swL.extB <= iInvMax and g.b >= swL.extB - 30 and g.rk > swL.rk
                        if na(candL)
                            candL := g
                        else if g.rk > candL.rk or (g.rk == candL.rk and g.top - g.bot > candL.top - candL.bot)
                            candL := g
                    gps.remove(i)
                else if bar_index - g.b > 120
                    gps.remove(i)
    // a higher timeframe gap still open in the leg keeps the sweep alive for its own inversion
    if not na(candS)
        pendS := f_pend(true, candS, swS)
    if not na(candL)
        pendL := f_pend(false, candL, swL)
    // Sweep + CISD (rulebook 6.6): the CISD close comes first, no inverted gap on that candle; one per sweep
    if iSc and na(candS) and swS.on and not swS.cd and bar_index > swS.extB and bar_index - swS.extB <= cdBars
        [cS, oS] = f_cisd(false, bar_index - swS.extB)
        if not na(cS) and close < cS and close[1] >= cS
            dirCS := -1
            cisdS := Gp.new(true, cS + 0.1 * atr, cS, time[oS], bar_index - oS, "CISD", 0)
    if iSc and na(candL) and swL.on and not swL.cd and bar_index > swL.extB and bar_index - swL.extB <= cdBars
        [cL, oL2] = f_cisd(true, bar_index - swL.extB)
        if not na(cL) and close > cL and close[1] <= cL
            dirCL := 1
            cisdL := Gp.new(false, cL, cL - 0.1 * atr, time[oL2], bar_index - oL2, "CISD", 0)

// Evaluate the setup helper on every chart calculation. A zero direction is a no-op;
// qualified calls stay in the same order relative to sweep-state updates.
f_setup(not na(candS) ? -1 : 0, candS, swS, pendS, false)
if not na(candS)
    if na(pendS)
        swS.on := false
    else
        swS.rk := candS.rk
f_setup(not na(candL) ? 1 : 0, candL, swL, pendL, false)
if not na(candL)
    if na(pendL)
        swL.on := false
    else
        swL.rk := candL.rk
f_setup(dirCS, cisdS, swS, noPend, true)
if dirCS != 0
    swS.cd := true
f_setup(dirCL, cisdL, swL, noPend, true)
if dirCL != 0
    swL.cd := true

if barstate.isconfirmed and calc
    // new chart gaps
    float gMin = math.max(iGapMin * atr, 2 * syminfo.mintick)
    if low > high[2] and low - high[2] >= gMin
        gps.push(Gp.new(true, low, high[2], time[2], bar_index, cTf, cm))
    if high < low[2] and low[2] - high >= gMin
        gps.push(Gp.new(false, low[2], high, time[2], bar_index, cTf, cm))
    if iT2 and cm < 2 and k2 != k2[1]
        f_gAdd(u2, e2, ub2, ut2, et2, eb2, k2, "2m", 2, gMin)
    if iT3 and cm < 3 and k3 != k3[1]
        f_gAdd(u3, e3, ub3, ut3, et3, eb3, k3, "3m", 3, gMin)
    if iT5 and cm < 5 and k5 != k5[1]
        f_gAdd(u5, e5, ub5, ut5, et5, eb5, k5, "5m", 5, gMin)
    while gps.size() > 60
        gps.shift()

if barstate.isconfirmed and ui.alMsg != ""
    if iAlConfirmed and f_alertAllowed()
        alert(ui.alMsg, alert.freq_once_per_bar_close)
    ui.alMsg := ""

// ───────── nearest levels and gaps, redrawn on the last bar only
var array<line> dLn = array.new<line>()
var array<label> dLb = array.new<label>()
var array<box> dBx = array.new<box>()
// minutes left in the trading window that contains the current candle ("HHMM-HHMM" sessions, NY)
f_left(string sess) =>
    int hh = int(str.tonumber(str.substring(sess, 5, 7)))
    int mm = int(str.tonumber(str.substring(sess, 7, 9)))
    int endT = timestamp(NY, year(time, NY), month(time, NY), dayofmonth(time, NY), hh, mm)
    if endT <= time
        endT += 86400000
    int nowT = barstate.isrealtime ? timenow : time_close
    int(math.max(0, (endT - nowT) / 60000))
int minLeft = inAs ? f_left(sAs) : inLo ? f_left(sLo) : inAm ? f_left(sNyRule) : na
color ribC = inNews ? color.new(cBad, 10) : inMacro ? color.new(cWarn, 35) : inWin ? color.new(cOk, 75) : na
plotshape(iRib and not na(ribC), "Timing ribbon", shape.square, location.bottom, ribC, size = size.tiny, display = display.pane)
var table mt = table.new(position.top_center, 2, 1, border_width = 2)
var array<line> pLn = array.new<line>()
var array<label> pLb = array.new<label>()
var int armS = -1
var int armL = -1
var int formB = -1
if barstate.islast
    for l in pLn
        l.delete()
    for l in pLb
        l.delete()
    pLn.clear()
    pLb.clear()
    if iPrev
        for side = 0 to 1
            Sw sv = side == 0 ? swS : swL
            int dv = side == 0 ? -1 : 1
            bool isL = dv == 1
            if sv.on and not sv.xl and (okWin or iOut == "Dim")
                [pg, pm, ptr, ptt, ptrH, pttH, pcl, psl, prk, ptp, ptpN, pfs, pes, pesN] = f_preview(dv, sv)
                if pg >= math.max(minG, 1) and not na(ptr)
                    bool form = isL ? close > ptr : close < ptr
                    color pc = not okWin ? color.gray : isL ? iLong : iShort
                    string pgT = f_gT(pg)
                    int pn = syminfo.pointvalue > 0 and prk > 0 ? int(math.floor((pg >= 2 ? iRiskP : iRiskA) / (prk * syminfo.pointvalue))) : 0
                    int secs = barstate.isrealtime ? int(math.max(0, (time_close - timenow) / 1000)) : na
                    string head = (form ? "⚡ FORMING " : "◔ ARMED ") + (isL ? "LONG " : "SHORT ") + pgT + " " + pm
                    string ptip = head + " · not confirmed"
                    ptip += "\n\nswept: " + sv.dt
                    ptip += "\ntrigger: a close " + (isL ? "above " : "below ") + f_prc(ptr) + " (" + ptt + ")"
                    if not na(ptrH) and ptrH != ptr
                        ptip += "\nhighest TF trigger: " + f_prc(ptrH) + " (" + pttH + ")"
                    if not na(pcl) and ptt != "CISD"
                        ptip += "\nCISD level: " + f_prc(pcl)
                    ptip += "\nstop " + f_prc(psl) + " (" + str.tostring(prk, "#.##") + " pts) · " + str.tostring(pn) + " contracts"
                    ptip += "\nTP1 " + (na(ptp) ? "· no draw" : f_prc(ptp) + " " + ptpN + " (" + str.tostring(math.abs(ptp - ptr) / prk, "#.#") + "R from the trigger)")
                    if smtOn and iEsChk
                        ptip += "\n" + (pes ? "✔ " + pairRoot + " delivering from " + pesN : "✖ " + pairRoot + " not in an HTF FVG at its extreme")
                        ptip += pfs == 1 ? "\n✔ " + pairRoot + " printed the same gap" : pfs == 0 ? "\n✖ FVG SMT: " + pairRoot + " has no matching gap → low probability (rulebook: skip)" : ""
                    ptip += "\n\ngrade if it closes with displacement: " + pgT + (na(secs) ? "" : "\ncandle closes in " + str.tostring(secs) + " s")
                    ptip += "\nprepare: size, stop and target ready. enter only on the close."
                    pLn.push(line.new(sv.extB, ptr, bar_index + 8, ptr, color = color.new(pc, form ? 0 : 40), style = line.style_dashed, width = form ? 2 : 1))
                    pLn.push(line.new(sv.extB, psl, bar_index + 8, psl, color = color.new(pc, 60), style = line.style_dotted))
                    pLb.push(label.new(bar_index + 8, ptr, head + " · close " + (isL ? "> " : "< ") + f_prc(ptr), style = label.style_label_left, color = color.new(pc, form ? 0 : 82), textcolor = form ? f_on(pc) : cTx, size = size.small, tooltip = ptip, text_font_family = font.family_monospace))
                    // alerts: once when armed, once per candle while forming
                    int ak = sv.extB
                    if barstate.isrealtime and okWin and iAlPreview and f_alertAllowed()
                        if (isL ? armL : armS) != ak
                            alert("SNM+ ARMED " + (isL ? "LONG " : "SHORT ") + pgT + " " + pm + " · " + syminfo.ticker + " · trigger close " + (isL ? "> " : "< ") + f_prc(ptr) + " (" + ptt + ") · stop " + f_prc(psl), alert.freq_all)
                            if isL
                                armL := ak
                            else
                                armS := ak
                        if form and formB != bar_index
                            alert("SNM+ FORMING " + (isL ? "LONG " : "SHORT ") + pgT + " " + pm + " · " + syminfo.ticker + " · beyond " + f_prc(ptr) + " · wait for the close", alert.freq_all)
                            formB := bar_index
    for l in dLn
        l.delete()
    for l in dLb
        l.delete()
    for b in dBx
        b.delete()
    dLn.clear()
    dLb.clear()
    dBx.clear()
    color lc = cTx
    // the last setup's entry / SL / TP / BE / TP2 labels sit right of the level labels, so they never overlap
    if iTrade != "Off" and sts.size() > 0 and ui.lastB >= 0 and bar_index - ui.lastB <= int(7200 / math.max(cs, 1))
        St lst = sts.last()
        int xT = bar_index + 35
        for l in lst.ln
            l.set_x2(math.max(l.get_x2(), xT))
        if lst.tl.size() > 1
            for k = 1 to lst.tl.size() - 1
                lst.tl.get(k).set_x(math.max(lst.tl.get(k).get_x(), xT))
    if iLvShow and lvs.size() > 0
        array<int> used = array.new<int>()
        array<float> dPx = array.new<float>()
        int otherLimit = iLvN
        for side = 0 to 1
            int otherDrawn = 0
            int tries = 0
            bool coreDone = not iLvCore
            while tries < 80 and (not coreDone or otherDrawn < otherLimit)
                tries += 1
                bool corePass = iLvCore and not coreDone
                int best = -1
                float bd = na
                for i = 0 to lvs.size() - 1
                    Lv v = lvs.get(i)
                    bool core = f_isCoreLevel(v.nm)
                    bool wanted = corePass ? core : (not iLvCore or not core)
                    if (v.px > close) == (side == 1) and not used.includes(i) and wanted
                        float dd = math.abs(v.px - close)
                        if na(bd) or dd < bd
                            bd := dd
                            best := i
                if best < 0
                    if corePass
                        coreDone := true
                    else
                        break
                else
                    used.push(best)
                    Lv v = lvs.get(best)
                    string tx = v.nm + (v.hrl ? " · HRL" : f_isDatedSessionLevel(v.nm) ? "" : " $$$")
                    // levels within the equal tolerance share one line and one label
                    int mi = -1
                    if dPx.size() > 0
                        for j = 0 to dPx.size() - 1
                            if math.abs(dPx.get(j) - v.px) <= eqTol
                                mi := j
                    if mi >= 0
                        label lb = dLb.get(mi)
                        lb.set_text(lb.get_text() + " / " + tx)
                    else
                        int x1 = v.b >= 0 ? math.max(v.b, bar_index - 400) : math.max(0, bar_index - 60)
                        dLn.push(line.new(x1, v.px, bar_index + 10, v.px, color = color.new(lc, v.hrl ? 20 : 40), style = v.hrl ? line.style_solid : line.style_dotted))
                        dLb.push(label.new(bar_index + 10, v.px, tx, style = label.style_label_left, color = color.new(lc, 100), textcolor = color.new(lc, 20), size = size.tiny, text_font_family = font.family_monospace))
                        dPx.push(v.px)
                        if not corePass
                            otherDrawn += 1
    // HTF candles on the right (TTrades view): 3 closed + the one forming, at real prices, tagged C2 → C3 → C4
    if iZShow and zs.size() > 0
        array<int> zUsed = array.new<int>()
        // the gaps price is trading inside (max 2): where it delivers from now
        int nIn = 0
        if iZIn
            // When several gaps contain price, show pending breaches first: their dashed
            // label explains why a visible HTF FVG earns no delivery credit.
            for pass = 0 to 1
                for i = 0 to zs.size() - 1
                    Zn z = zs.get(i)
                    if nIn < 2 and z.breached == (pass == 0) and z.top >= close and z.bot <= close
                        zUsed.push(i)
                        nIn += 1
        // then the nearest ones above and below
        for side = 0 to 1
            for pass = 1 to iZN
                int best = -1
                float bd = na
                for i = 0 to zs.size() - 1
                    Zn z = zs.get(i)
                    if not zUsed.includes(i) and (side == 1 ? z.bot > close : z.top < close)
                        float dd = side == 1 ? z.bot - close : close - z.top
                        if na(bd) or dd < bd
                            bd := dd
                            best := i
                if best >= 0
                    zUsed.push(best)
        for i in zUsed
            Zn z = zs.get(i)
            color zc = iZst == "Tinted" ? (z.dir == 1 ? iLong : iShort) : lc
            // unfilled part only
            float zT = z.top
            float zB = z.bot
            if iZTrim and not z.breached and not na(z.mit)
                if z.dir == 1
                    zT := math.min(z.top, z.mit)
                else
                    zB := math.max(z.bot, z.mit)
            if (z.breached or (zT - zB >= 2 * syminfo.mintick and f_fill(z) < iFillMax))
                int zX1 = math.max(z.t0, time - iZBack * cs * 1000)
                int zX2 = time + 15 * cs * 1000
                string zTx = str.upper(z.tf) + " FVG" + (z.dir == 1 ? "+" : "-") + (z.breached ? " · BREACHED · WAIT " + str.upper(z.tf) + " CLOSE" : "")
                if iZst == "Edges only"
                    dLn.push(line.new(zX1, zT, zX2, zT, xloc = xloc.bar_time, color = color.new(lc, 55), style = z.breached ? line.style_dashed : line.style_solid))
                    dLn.push(line.new(zX1, zB, zX2, zB, xloc = xloc.bar_time, color = color.new(lc, 55), style = z.breached ? line.style_dashed : line.style_solid))
                    dBx.push(box.new(zX1, zT, zX2, zB, xloc = xloc.bar_time, border_color = color.new(lc, 100), bgcolor = color.new(lc, 100), text = zTx, text_size = size.tiny, text_color = color.new(lc, 35), text_halign = text.align_right, text_valign = text.align_bottom))
                else
                    dBx.push(box.new(zX1, zT, zX2, zB, xloc = xloc.bar_time, border_color = z.breached ? color.new(cNeu, 40) : iZst == "Tinted" ? color.new(zc, 70) : color.new(lc, 100), border_style = z.breached ? line.style_dashed : line.style_solid, border_width = 1, bgcolor = z.breached ? color.new(cNeu, 92) : color.new(zc, iZst == "Tinted" ? 93 : 94), text = zTx, text_size = size.tiny, text_color = color.new(zc, iZst == "Tinted" ? 20 : 35), text_halign = text.align_right, text_valign = text.align_bottom))

// ───────── session map (rulebook section 3)
if barstate.islast and iMap
    int mapBars = math.max(1, int(iMapMin * 60 / math.max(cs, 1)))
    Zn rz = na
    Zn up = na
    Zn dn = na
    for z in zs
        if not z.breached
            if z.tapB >= 0 and (na(rz) or z.tapB > rz.tapB)
                rz := z
            if z.dir == -1 and z.bot > close and (na(up) or z.bot < up.bot)
                up := z
            if z.dir == 1 and z.top < close and (na(dn) or z.top > dn.top)
                dn := z
    bool resp = not na(rz) and bar_index - rz.tapB <= mapBars
    string sug = "No trade"
    string mTxt = ""
    if resp
        sug := rz.dir == 1 ? "Bullish" : "Bearish"
        mTxt := (rz.dir == 1 ? "LONGS ONLY · respecting " : "SHORTS ONLY · respecting ") + rz.tf + (rz.dir == 1 ? " FVG+ " : " FVG- ") + f_prc(rz.bot) + " – " + f_prc(rz.top) + (rz.dir == 1 ? " · invalid on a close below " + f_prc(rz.bot) : " · invalid on a close above " + f_prc(rz.top))
    else
        string dnT = "-"
        string upT = "-"
        if not na(dn)
            dnT := dn.tf + " FVG+ " + f_prc(dn.top)
        if not na(up)
            upT := up.tf + " FVG- " + f_prc(up.bot)
        mTxt := "NO TRADE · between " + dnT + " and " + upT + " · wait for a tap"
    // ── status line: first state that applies wins
    string dirn = iBias != "Neutral" ? iBias : sug
    int dd = dirn == "Bullish" ? 1 : dirn == "Bearish" ? -1 : 0
    bool dL = dd == 1
    color dc = dd == 1 ? iLong : dd == -1 ? iShort : cNeu
    string sTx = ""
    color sBg = cNeu
    // next window opening
    int nxW = na
    for w in str.split(iWin, ",")
        string ws = str.trim(w)
        if str.length(ws) >= 9
            int sh = int(str.tonumber(str.substring(ws, 0, 2)))
            int sm = int(str.tonumber(str.substring(ws, 2, 4)))
            int st0 = timestamp(NY, year(time, NY), month(time, NY), dayofmonth(time, NY), sh, sm)
            if st0 <= time
                st0 += 86400000
            nxW := na(nxW) ? st0 : math.min(nxW, st0)
    // the last closed HTF candle's closure direction (TTFM)
    // delivery zone in the bias direction: price inside it, or the nearest one ahead
    Zn dz = na
    bool inZ = false
    if dd != 0
        for z in zs
            if not z.breached and z.dir == dd
                if close <= z.top + 0.25 * atr and close >= z.bot - 0.25 * atr
                    dz := z
                    inZ := true
                else if not inZ and (dL ? z.top < close : z.bot > close)
                    if na(dz) or (dL ? z.top > dz.top : z.bot < dz.bot)
                        dz := z
    // the nearest liquidity a sweep should take inside the zone (shorts: a high above, longs: a low below)
    float swP = na
    string swN = ""
    if dd != 0
        for v in lvs
            if v.hi != dL and (dL ? v.px < close : v.px > close) and (na(swP) or math.abs(v.px - close) < math.abs(swP - close))
                swP := v.px
                swN := v.nm
    // an armed setup in the bias direction
    Sw sa = dL ? swL : swS
    int ag = -1
    float atr0 = na
    float asl = na
    float ark = na
    if dd != 0 and sa.on and not sa.xl
        [pg2, pm2, ptr2, ptt2, ph2x, pt2x, pc2x, psl2, prk2, ptp2, ptpN2, pfs2, pes2, pesN2] = f_preview(dd, sa)
        ag := pg2
        atr0 := ptr2
        asl := psl2
        ark := prk2
    int an = not na(ark) and ark > 0 and syminfo.pointvalue > 0 ? int(math.floor((ag >= 2 ? iRiskP : iRiskA) / (ark * syminfo.pointvalue))) : 0
    if not inWin
        sTx := "OUTSIDE WINDOWS · no trade" + (na(nxW) ? "" : " · next window opens in " + str.tostring(math.floor((nxW - time) / 3600000)) + "h " + str.tostring(math.floor(((nxW - time) % 3600000) / 60000)) + "m")
        sBg := cNeu
    else if inNews
        sTx := "NEWS · " + newsWhy + " · no trade until the blackout ends"
        sBg := cWarn
    else if iTrack and (ui.nTk >= 2 or ui.nLoss >= 2)
        sTx := "TRACKER LIMIT · " + str.tostring(ui.nTk) + " trades / " + str.tostring(ui.nLoss) + " losses · indicator still prints/alerts"
        sBg := cNeu
    else if dirn == "No trade"
        sTx := mTxt
        sBg := cNeu
    else if iBias == "Neutral"
        sTx := "SET BIAS · the map says " + sug + " (" + mTxt + ")"
        sBg := cWarn
    else if sug != "No trade" and iBias != sug
        sTx := "CHECK BIAS · yours is " + iBias + ", the map says " + sug + " · recheck your IF/THEN"
        sBg := cWarn
        sBg := cWarn
    else if ui.lastB >= 0 and bar_index - ui.lastB <= 3 and ui.lastL == dL
        sTx := ui.lastG + (dL ? " LONG" : " SHORT") + " CONFIRMED · run your checklist · max 2 trades today"
        sBg := dc
    else if ag >= math.max(minG, 1)
        sTx := "ARMED " + (dL ? "LONG " : "SHORT ") + f_gT(ag) + " · close " + (dL ? "> " : "< ") + f_prc(atr0) + " · stop " + f_prc(asl) + " (" + str.tostring(ark, "#") + " pts) · " + (an == 0 ? "SIZE 0 · check budget / point value" : "size " + str.tostring(an) + " (" + syminfo.ticker + ")")
        sBg := dc
    else if inZ
        sTx := (dL ? "LONGS ONLY" : "SHORTS ONLY") + " · at the " + dz.tf + (dL ? " FVG+ " : " FVG- ") + f_prc(dz.bot) + " – " + f_prc(dz.top) + " · wait for a sweep" + (na(swP) ? "" : " of " + swN + " " + f_prc(swP))
        sBg := color.new(dc, 25)
    else if not na(dz)
        sTx := (dL ? "LONGS ONLY" : "SHORTS ONLY") + " · wait for price at the " + dz.tf + (dL ? " FVG+ " : " FVG- ") + f_prc(dL ? dz.top : dz.bot) + " (" + str.tostring(math.abs(close - (dL ? dz.top : dz.bot)), "#") + " pts away)"
        sBg := color.new(dc, 45)
    else
        sTx := (dL ? "LONGS ONLY" : "SHORTS ONLY") + " · no " + (dL ? "bullish" : "bearish") + " HTF FVG in reach · wait"
        sBg := color.new(dc, 45)
    mt.cell(0, 0, sTx, text_color = f_on(sBg), bgcolor = sBg, text_size = pSz, text_font_family = font.family_monospace)
    // the clock SNM+ really uses (New York), so a chart set to another time zone is obvious at a glance
    int nyNow = barstate.isrealtime ? timenow : time
    mt.cell(1, 0, "NY " + str.format_time(nyNow, "HH:mm", NY), text_color = cTx, bgcolor = color.new(cPan, 0), text_size = pSz, text_font_family = font.family_monospace)

// ───────── checklist panel (ManipulationX style)
string stageText = ""
color stageColor = cMu
if barstate.islast and iPanel and iStageRow
    if ui.stageB == bar_index and barstate.isconfirmed
        stageText := ui.stageMsg
        stageColor := str.contains(stageText, "BLOCK") or str.contains(stageText, "NO ALERT") or str.contains(stageText, "REJECTED") or str.contains(stageText, "STUDY") ? cWarn : cOk
    else if ui.stageB >= 0 and ui.stageB == bar_index - 1
        // Closed-bar state persists across realtime rollback; never label a live evaluation confirmed.
        stageText := "PREV CLOSE · " + ui.stageMsg
        stageColor := cMu
    else if inNews
        stageText := "WAIT · NEWS BLACKOUT"
    else if not inWin
        stageText := "WAIT · OUTSIDE WINDOW"
    else
        bool sActive = swS.on and not swS.xl
        bool lActive = swL.on and not swL.xl
        if sActive or lActive
            bool isL = lActive and (not sActive or swL.extB >= swS.extB)
            // Reuse the existing preview drawing, not another f_preview() evaluation.
            string previewText = pLb.size() > 0 ? label.get_text(pLb.last()) : ""
            stageText := previewText != "" ? str.substring(previewText, 0, math.min(32, str.length(previewText))) : (isL ? "L " : "S ") + "SWEEP · WAIT TRIGGER"
            stageColor := previewText != "" ? cOk : cMu
        else
            stageText := "WAIT · NO ACTIVE SWEEP"
// A table is screen-anchored; the auto corner follows chart TF, not the viewport's empty right margin.
panelPosition = iPos == "Top Right" ? position.top_right : iPos == "Top Left" ? position.top_left : iPos == "Middle Right" or (iPos == "Auto" and cm <= 5) ? position.middle_right : iPos == "Bottom Left" ? position.bottom_left : position.bottom_right
var table tb = table.new(position.bottom_right, 2, 21, border_width = 0)
if barstate.islast and iPanel and iDet == "Simple"
    tb.clear(0, 0, 1, 20)
    tb.set_position(panelPosition)
    tb.set_bgcolor(cPan)
    tb.set_frame_color(cFrm)
    tb.set_frame_width(1)
    color hc2 = str.startswith(ui.dir, "LONG") ? iLong : str.startswith(ui.dir, "SHORT") ? iShort : cNeu
    tb.cell(0, 0, "SNM+ " + ui.dir, text_color = f_on(hc2), bgcolor = hc2, text_size = hSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 0, ui.grade, text_color = f_on(hc2), bgcolor = hc2, text_size = hSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    tb.cell(0, 1, "LAST SETUP", text_color = cMu, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 1, "", text_size = pSz)
    array<string> rv = array.from(ui.sD, ui.sT, ui.sE)
    array<int> ro = array.from(ui.okD, ui.okT, ui.okE)
    tb.cell(0, 3, "D  delivery", text_color = cTx, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 3, rv.get(0) + (ro.get(0) == 1 ? "  ✔" : ro.get(0) == 0 ? "  ✖" : "  –"), text_color = ro.get(0) == 1 ? cOk : ro.get(0) == 0 ? cBad : cMu, text_size = pSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    tb.cell(0, 4, "T  target", text_color = cTx, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 4, rv.get(1) + (ro.get(1) == 1 ? "  ✔" : ro.get(1) == 0 ? "  ✖" : "  –"), text_color = ro.get(1) == 1 ? cOk : ro.get(1) == 0 ? cBad : cMu, text_size = pSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    tb.cell(0, 5, "E  execution", text_color = cTx, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 5, rv.get(2) + (ro.get(2) == 1 ? "  ✔" : ro.get(2) == 0 ? "  ✖" : "  –"), text_color = ro.get(2) == 1 ? cOk : ro.get(2) == 0 ? cBad : cMu, text_size = pSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    tb.cell(0, 6, "Today", text_color = cTx, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 6, "A+ " + str.tostring(ui.nAp) + " · A " + str.tostring(ui.nA) + " · max 2 trades", text_color = ui.nAp + ui.nA > 2 ? cWarn : cTx, text_size = pSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    if iStageRow
        tb.cell(0, 7, "NOW", text_color = cTx, text_size = pSz, text_halign = text.align_left)
        tb.cell(1, 7, stageText, text_color = stageColor, text_size = pSz, text_halign = text.align_right, tooltip = "Now = current close, else PREV CLOSE (1 bar), else live wait/preview. ELIGIBLE is not alert delivery.")
if barstate.islast and iPanel and iDet == "Full"
    tb.set_position(panelPosition)
    color tx = cTx
    color mu = cMu
    tb.set_bgcolor(cPan)
    tb.set_frame_color(cFrm)
    tb.set_frame_width(1)
    color hc = str.startswith(ui.dir, "LONG") ? iLong : str.startswith(ui.dir, "SHORT") ? iShort : cNeu
    array<string> nm = array.from("V-shape", "Displacement", "HTF delivery", "Draw on liquidity", "CISD", "Volume divergence", "SMT")
    tb.cell(0, 0, "SNM+ " + ui.dir, text_color = f_on(hc), bgcolor = hc, text_size = hSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 0, ui.grade, text_color = f_on(hc), bgcolor = hc, text_size = hSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    tb.cell(0, 1, "LAST SETUP", text_color = mu, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 1, "", text_size = pSz)
    tb.cell(0, 2, "Bias", text_color = tx, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 2, iBias, text_color = iBias == "Bullish" ? iLong : iBias == "Bearish" ? iShort : tx, text_size = pSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    tb.cell(0, 3, "Swept", text_color = tx, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 3, ui.swept, text_color = tx, text_size = pSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    tb.cell(0, 4, "iFVG", text_color = tx, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 4, pv.size() > 0 ? ui.fv + (ui.fvOk ? " ✔" : " ✖") : "–", text_color = pv.size() > 0 and not ui.fvOk ? cBad : cOk, text_size = pSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    for r = 0 to 6
        int v = r < pv.size() ? pv.get(r) : 2
        int row = r < 4 ? 5 + r : 10 + (r - 4)
        tb.cell(0, row, nm.get(r), text_color = r < 4 ? tx : mu, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
        tb.cell(1, row, v == 1 ? "✔" : v == 0 ? "✖" : v == 3 ? "n/a" : "–", text_color = v == 1 ? cOk : v == 0 ? cBad : mu, text_size = pSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    tb.cell(0, 9, "confluence", text_color = mu, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 9, "", text_size = pSz)
    tb.cell(0, 14, "When", text_color = tx, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 14, ui.tm + (ui.when == "-" ? "" : " · " + ui.when), text_color = tx, text_size = pSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    tb.cell(0, 14, "NOW", text_color = tx, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(0, 16, "LRL touches", text_color = tx, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 16, ui.lrl + (ui.lrOk == 1 ? " ✔" : ui.lrOk == 0 ? " ✖" : ""), text_color = ui.lrOk == 1 ? cOk : ui.lrOk == 0 ? cBad : mu, text_size = pSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    tb.cell(0, 15, "Internal liq.", text_color = tx, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 15, ui.intL == 1 ? "untouched ✔" : ui.intL == 0 ? "taken ✖" : "–", text_color = ui.intL == 1 ? cOk : ui.intL == 0 ? cBad : mu, text_size = pSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    tb.cell(0, 17, "Today", text_color = tx, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 17, "A+ " + str.tostring(ui.nAp) + " · A " + str.tostring(ui.nA) + " · max 2 trades", text_color = ui.nAp + ui.nA > 2 ? cWarn : tx, text_size = pSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    tb.cell(0, 18, iTrack ? "Auto R today" : "", text_color = tx, text_size = pSz, text_halign = text.align_left, text_font_family = font.family_monospace)
    tb.cell(1, 18, iTrack ? (ui.dR >= 0 ? "+" : "") + str.tostring(ui.dR, "#.##") + "R · " + str.tostring(ui.nTk) + " / 2 trades" : "", text_color = ui.dR >= 0 ? cOk : cBad, text_size = pSz, text_halign = text.align_right, text_font_family = font.family_monospace)
    if iStageRow
        tb.cell(0, 20, "NOW", text_color = tx, text_size = pSz, text_halign = text.align_left)
        tb.cell(1, 20, stageText, text_color = stageColor, text_size = pSz, text_halign = text.align_right, tooltip = "Now = current close, else PREV CLOSE (1 bar), else live wait/preview. ELIGIBLE is not alert delivery.")
    tb.cell(1, 14, (inNews ? "NEWS" : inMacro ? "macro" : inWin ? "in window" : "outside windows") + (inWin and not na(minLeft) ? " · " + str.tostring(minLeft) + " min left" : ""), text_color = inNews ? cWarn : inWin ? cOk : mu, text_size = pSz, text_halign = text.align_right, text_font_family = font.family_monospace)
