//@version=6
indicator("CISD Ultimate Balanced", "CISD Ult", true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 80, behind_chart = false)

// ═══════════════════════════════════════════════════════════════════
// PRESET SYSTEM
// ═══════════════════════════════════════════════════════════════════
preset = input.string("5min", "Timeframe Preset", options=["3min", "5min", "15min", "30min", "Custom"], group="======= PRESET =======")

// ═══════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════
tolerence_inp          = input.float(0.60, "Noise Filter", group="Calculations", maxval=1, minval=0, step=0.05)
len_inp                = input.int(10, "Swing Period", group="Calculations")
expiry_bars            = input.int(60, "Expiry Bars", group="Calculations")
liquidity_lookback     = input.int(12, "Liquidity Lookback", group="Calculations")

grp_conf = "======= Core Confluences ======="
require_liq_sweep   = input.bool(false, "Require Liquidity Sweep", group=grp_conf)
require_fvg         = input.bool(false, "Require FVG / iFVG", group=grp_conf)
require_strong_disp = input.bool(false, "Require Strong Displacement", group=grp_conf)
require_htf_bias    = input.bool(false, "Require HTF Bias Alignment", group=grp_conf)
htf_tf              = input.timeframe("60", "HTF for Bias", group=grp_conf)
strong_disp_mult    = input.float(0.78, "Strong Displacement Threshold", minval=0.5, maxval=1.0, step=0.05, group=grp_conf)

grp_elite = "======= Elite Confluences ======="
require_ob          = input.bool(false, "Require Order Block", group=grp_elite)
require_prem_disc   = input.bool(false, "Require Premium/Discount", group=grp_elite)
require_ifvg        = input.bool(false, "Prefer Inversion FVG", group=grp_elite)
require_body_pct    = input.bool(false, "Require Strong Body %", group=grp_elite)
body_pct_min        = input.float(0.58, "Min Body % of Range", minval=0.4, maxval=0.9, step=0.05, group=grp_elite)

grp_q = "======= Quality & Risk ======="
min_score_inp       = input.int(2, "Minimum Score for BEST", minval=1, maxval=5, group=grp_q)
show_risk_levels    = input.bool(true, "Show Entry / SL / TP", group=grp_q)
show_liquidity_tgt  = input.bool(true, "Show Auto Liquidity Target", group=grp_q)
rr_target           = input.float(2.0, "Risk:Reward Target", minval=1.0, step=0.1, group=grp_q)
atr_mult_sl_inp     = input.float(0.35, "SL Buffer (ATR)", minval=0.1, step=0.05, group=grp_q)
cooldown_inp        = input.int(6, "Signal Cooldown (bars)", minval=0, group=grp_q)
auto_invalidate     = input.bool(true, "Auto-Invalidate on Origin Break", group=grp_q)
sweepStrict = input.bool(true, "Sweep = wick through AND close back inside", group=grp_q, tooltip="02-liquidity/liquidity-sweep.md: a sweep wicks, BOS closes. Measured on this file's own test, 89% of what counted as a sweep closed straight through the level, i.e. was a break, and 1% met the definition - which diluted the one confluence the 2022 model hangs on. Off reproduces the original behaviour exactly.")
sweepWick   = input.float(0.60, "Min wick as share of the candle range", minval=0.0, maxval=1.0, step=0.05, group=grp_q, tooltip="asian-range-sweep.md uses wick_top_pct >= 0.6 for the high side. Only read when the strict test is on.")
strictRatio = input.bool(false, "Strict displacement ratio (repairs the Noise Filter)", group=grp_q, tooltip="OFF by default because this is the core of the model, not a decoration: tools/cisd-audit.md section 1a shows the ratio is >= 1 by construction and the denominator degenerates to one tick on the bear side 54% of the time, so the Noise Filter cannot reject anything and the walk is 47x asymmetric. On = a repaired denominator that can fail. Try it and compare the funnel, do not trust my word for it.")
clean_after_bars    = input.int(35, "Delete old BEST after X bars", minval=10, group=grp_q)

grp_form = "======= Forming Setup Visuals ======="
show_live_fvgs      = input.bool(true, "Show Live FVGs", group=grp_form)
show_live_obs       = input.bool(true, "Show Live Order Blocks", group=grp_form)
show_live_ifvgs     = input.bool(true, "Show Live iFVGs", group=grp_form)
max_fvgs_inp        = input.int(2, "Max FVGs per side", minval=1, maxval=4, group=grp_form)
max_obs_inp         = input.int(1, "Max OBs per side", minval=1, maxval=2, group=grp_form)
fvg_transparency    = input.int(88, "FVG Transparency", minval=70, maxval=95, group=grp_form)
ob_transparency     = input.int(85, "OB Transparency", minval=70, maxval=95, group=grp_form)
only_near_price     = input.bool(true, "Only show zones near current price", group=grp_form)
near_mult_inp       = input.float(2.2, "Near price = ATR ×", minval=1.0, step=0.3, group=grp_form)
min_fvg_atr         = input.float(0.40, "Min FVG size (ATR)", minval=0.2, step=0.05, group=grp_form)
zoneCd_inp          = input.int(1, "Bars between new zones (per side)", minval=0, maxval=12, group=grp_form, tooltip="This file shared ONE 3-bar counter across both directions, so at 09:30 - when gold prints several gaps either way within minutes - it kept about one in four and the bull side suppressed the bear side and vice versa.")

grp_kz = "======= Time engine (optional) ======="
timeMode = input.string("Killzone", "Trading window", options=["All day", "Killzone", "Killzone + Macro", "Silver Bullet only", "Macro only"], group=grp_kz, tooltip="Minute-accurate on purpose: every window that decides these setups is shorter than an hour, and this file used to compare whole hours only. Killzone = the canonical windows you switch on below. Killzone + Macro = only inside a ~20-minute macro core AND inside a killzone, which is where the library puts the highest-confluence trades. All day does not mean worse - it means unfiltered.")
kzSet      = input.string("Public 2022 set", "Killzone set", options=["Public 2022 set", "2017 mentorship set"], group=grp_kz, tooltip="10-killzones/killzone-times-table.md records TWO sets and notes ICT rejects the 02:00 reading by name while teaching it: the April-2017 mentorship set starts London at 01:00 and runs NY 07:00-10:00. Both are offered here rather than argued about.")
kz_london  = input.bool(true, "London open", group=grp_kz, tooltip="02:00-05:00 NY (01:00-05:00 on the 2017 set).")
kz_ny      = input.bool(true, "New York AM", group=grp_kz, tooltip="08:00-11:00 NY (07:00-10:00 on the 2017 set).")
kz_asia    = input.bool(false, "Asia", group=grp_kz, tooltip="20:00-00:00 NY, the killzone. This is NOT the Asian range used for targets, which still runs 18:00-02:00 exactly as this file had it - that block is untouched.")
kz_loncls  = input.bool(false, "London close", group=grp_kz, tooltip="10:00-12:00 NY. Missing from the version this came from, and it overlaps the NY AM Silver Bullet hour.")
kz_nypm    = input.bool(false, "New York PM", group=grp_kz, tooltip="13:30-16:00 NY. Also missing before; contains the 14:00-15:00 Silver Bullet and two macro cores.")
use_killzones = input.bool(true, "Only signal inside the trading window", group=grp_kz)
useSb    = input.bool(true, "Mark the Silver Bullet hours", group=grp_kz, tooltip="03:00-04:00 / 10:00-11:00 / 14:00-15:00 NY. Window is item 1 of 8 in 11-silver-bullet/silver-bullet-rules.md and non-negotiable there, so it is stamped on the zones and labels rather than hidden.")
useMacro = input.bool(true, "Mark the five macro cores", group=grp_kz, tooltip="00:50-01:10, 02:50-03:10, 09:50-10:10, 13:50-14:10, 14:50-15:10 NY (04-time-cycles/macro-times-overview.md).")
stopHour = input.int(16, "No new signals after this NY hour", minval=0, maxval=23, group=grp_kz, tooltip="16 keeps the whole day; 11 is the strict NY AM read, on the argument that the AM delivery is what the open is for.")

grp_or = "======= NY AM open range (optional) ======="
useOR    = input.bool(false, "Use the 08:00 opening range as a pool", group=grp_or, tooltip="31-models/ny-am-open-range-model.md: the first 30-60 minutes of NY AM become the day's BSL/SSL pair, and the bound taken after the window is the trigger event.")
orLenMin = input.int(30, "Range length (min from 08:00 NY)", minval=15, maxval=120, step=5, group=grp_or, tooltip="30 for the short OR, 60 for the long one - the page offers both.")
orSweepA = input.int(9, "Sweep window from (NY hour)", minval=8, maxval=13, group=grp_or)
orSweepB = input.int(11, "Sweep window to (NY hour)", minval=9, maxval=16, group=grp_or)
orGate   = input.bool(false, "Require an opening-range sweep before signalling", group=grp_or, tooltip="Off = the range is drawn and its taken-state shown, but nothing is gated on it. Off is the default because the CISD core in this file is not an open-range model; switching this on turns it into one.")

grp_crt = "======= 4H candle range (optional) ======="
crtOn       = input.bool(false, "Use a reference candle's range as the day's grid", group=grp_crt, tooltip="OFF by default, and nothing in the CISD core consults this layer until you also switch crtGateCore on. Source note: tools/crt-candle-range-study.md. Bounds are the reference candle's wicks; the test is 02-liquidity/liquidity-sweep.md's wick-plus-close-back-inside, which is also 20-turtle-soup/turtle-soup.md's failure condition.")
crtRef      = input.string("Prev 4H candle", "Reference range", options=["Prev 4H candle", "Prev daily candle", "Intra-anchor (provisional bounds)"], group=grp_crt, tooltip="'Prev 4H candle' is candle 1 of the classic definition (LuxAlgo's library page: mark candle 1's high/low, candle 2 does the raid). 'Intra-anchor' reads the bounds of a candle that is still printing - it is here because a shifting boundary is named as the most common cause of failed candle-range trades, not because the reading is right. 'Prev daily candle' is the daily CRT variant and costs no new data.")
crtAnchorH  = input.int(1, "Anchor candle opens at this NY hour", minval=0, maxval=23, group=grp_crt, tooltip="1 = the 01:00 NY 4H candle in your screenshots ('4h 1 AM CRT', 'Key Timing 01:30 Liquidity sweep'); the chart clock is pinned to New York by the 17/21/1 labels, see the study section 2. 01:00 is also the April-2017 mentorship London open, which the Killzone set switch already knows.")
crtAnchorLen= input.int(240, "Reference candle length (min)", minval=15, maxval=1440, step=15, group=grp_crt, tooltip="240 = the 4H anchor the screenshots use. 60 covers the HOURLY anchors 21-crt/crt-rules.md lists (02:00 / 03:00 / 05:00 / 09:00 / 13:00 NY) - the same machine on a shorter candle, which is what those hours are normally measured on. Ignored by the daily reference, which is 1440 by definition.")
crtWinOpen  = input.int(0, "Sweep window opens N min after the anchor open", minval=0, maxval=360, group=grp_crt)
crtWinLen   = input.int(90, "Sweep window length (min)", minval=15, maxval=360, group=grp_crt, tooltip="30 covers their printed 01:30 exactly; 90 covers the 01:00-02:30 first hour and a half. The window does not wrap past midnight.")
crtTimeHard = input.bool(true, "No raid inside the window = no setup", group=grp_crt, tooltip="@MadoCRT, posted 2026-10-08: 'If the price condition is there but the time condition doesn't align, do absolutely nothing.' On, that is the rule rather than a preference.")
crtDraw     = input.bool(true, "Draw the range, its bounds and the live setup", group=grp_crt, tooltip="Nine objects in total, created once and moved - not nine per day. That is why this layer can live in this script at all.")
crtAccept   = input.string("Close back inside", "Re-entry test", options=["Touch only", "Close back inside", "Close + body back inside"], group=grp_crt, tooltip="The close is the test: 'a close beyond the extreme says the opposite, and the CRT is void in that direction' (LuxAlgo). One tick back over the level is a touch, not acceptance, so the body variant is offered.")
crtStrictC2 = input.bool(false, "Acceptance is C2's own close (textbook C1/C2)", group=grp_crt, tooltip="LuxAlgo's sentence: 'candle 2 must close back above candle 1's low'. Off (default) the acceptance is judged on any bar inside the sweep window, which is the read the screenshots actually show - they entered at 01:30, hours before C2 closed, and @SpeculatorFL's own post says '3am entry'. On, the raid is remembered, the stop sits behind its deepest tap rather than behind the bar that happened to close back inside, and the test is settled only when C2 closes. Needs a sub-daily reference and a close-based acceptance; with Touch only it has nothing to settle. In the provisional mode every new extreme inside the candle is by construction a raid of its own bound, which is the cleanest demonstration of why the model waits for the close.")
crtC3Only   = input.bool(false, "Enter only inside C3, the delivery candle", group=grp_crt, tooltip="C1 = the range, C2 = the raid and its close, C3 = the delivery. On, an armed setup cannot be entered until C2 has closed, so the trigger is a retest in the delivery candle rather than a fill in the raid candle. It will cost entries and add 'armed, never triggered' voids - worth measuring, because abandoning is their own step 3, not a failure of the model.")
crtBias     = input.string("HTF bias", "Direction filter", options=["None", "HTF bias", "Above/below prior-day close", "HTF bias + prior-day close"], group=grp_crt, tooltip="'Trading CRTs against the higher-timeframe trend is the largest win-rate killer in the entire framework'. 'None' exists so you can measure what the pattern does unfiltered, which is the honest way to find out what the filter is worth.")
crtEntry    = input.string("Anchor open retest", "Entry trigger", options=["On the close back inside", "Anchor open retest", "Range 50% retest", "Live OB tap", "iFVG tap"], group=grp_crt, tooltip="The levels the breakdowns actually mark: @SpeculatorFL's posts use a 15m order block, the '4H Key' in these panels is the anchor candle's open. 'iFVG tap' reuses this script's inverted-zone machinery - same tap-and-reject grammar, different level.")
crtObAge    = input.int(12, "Live-OB freshness for that tap (bars)", minval=1, maxval=60, group=grp_crt)
crtTgt      = input.string("Opposite bound", "Target", options=["Opposite bound", "50% of the range", "50% then opposite bound", "R multiple"], group=grp_crt, tooltip="Candle-range theory targets the OPPOSITE EXTREME of the candle; the 50%-then-bound ladder with the stop to breakeven at 50% is the worked example on crttrading.com section 12. '+3RR' is the poster's label, and on the prices printed in the same image the box reaches about 2.2R - so 'R multiple' is here to be compared against, not trusted by default.")
crtDeliverH = input.int(8, "Void unless reached within N hours of the anchor open", minval=0, maxval=24, group=grp_crt, tooltip="The model has a delivery window (candle 3), not 'eventually'. Price that never delivers is a failed reading and has to be counted as one, not left open on the chart until it happens to work. 0 = no expiry.")
crtStop     = input.string("Sweep extreme", "Stop", options=["Sweep extreme", "Sweep extreme + ATR buffer"], group=grp_crt, tooltip="'The stop always goes below the sweep low / above the sweep high. No closer, no farther' - the manipulation wick is the defence. The ATR buffer is what the rest of this file uses, so it is offered second rather than first.")
crtMinRiskT = input.int(10, "Skip if the risk is under this many ticks", minval=0, maxval=200, group=grp_crt, tooltip="A box whose risk is a handful of ticks is a spread, not a trade: tools/cisd-audit.md section 11 lost 0.216R after friction and small boxes were where it came from.")
crtSA       = input.bool(true, "Apply the 2017 stand-aside list", group=grp_crt, tooltip="15-sessions/london-session-avoidance.md (ICT-2017-AVOID-LONDON) - same year and same session as this model's 01:00 anchor, and a list of conditions that disqualify the session BEFORE any setup is looked for. ICT's own framing: ignoring it does not lower your expectancy, it inverts it.")
crtAdrMult  = input.float(2.0, "Stand aside if the prior day's range exceeded this x its 5-day ADR", minval=1.0, maxval=4.0, step=0.1, group=grp_crt, tooltip="'Typically there'll be a consolidation, or it could go choppy' the day after a large range day.")
crtCbdrMax  = input.float(50.0, "CBDR cap (pips, 14:00-20:00 NY)", minval=0.0, step=5.0, group=grp_crt, tooltip="Note the number: the stand-aside limit is 50, NOT the 40-pip qualification limit used for CBDR projections. Two rules, two numbers, commonly conflated - see the Common Mistakes section of that page. 0 disables this check.")
crtAsiaMax  = input.float(40.0, "Asian range cap (pips, 20:00-00:00 NY)", minval=0.0, step=5.0, group=grp_crt, tooltip="Over this the standard profile is off and only the delayed-protraction profile qualifies, 'but it has to meet every one of those criteria... otherwise I'll move to the sidelines'. 0 disables.")
crtTrendFrac= input.float(0.5, "Stand aside if the move from 20:00 NY exceeds this x the 5-day ADR", minval=0.0, maxval=2.0, step=0.1, group=grp_crt, tooltip="'A sustained rally or decline from 20:00... is usually a poor indication of a London session' - the real event started at zero GMT and keeps going through. 0 disables.")
crtTightFrac= input.float(0.25, "Overnight consolidation must stay under this x the 5-day ADR", minval=0.0, maxval=1.0, step=0.05, group=grp_crt, tooltip="The master condition: 'CBDR and/or Asian range must trade down into a small tight consolidation range. If we don't see that - if it's trending in both or either - it makes the London session highly suspect.' 0 disables.")
crtFri      = input.string("Mark only", "First Friday of the month (NFP day)", options=["Off", "Mark only", "Stand aside"], group=grp_crt, tooltip="'Typically the first Friday... we are not trading London session at all on that Friday.' Pine cannot read an economic calendar, so first-Friday-of-month is the proxy and 'Mark only' is the default: the panel tells you, you decide.")
crtRangeMin = input.float(0.30, "Skip if the reference range is under this fraction of the 5-day ADR", minval=0.0, maxval=1.0, step=0.05, group=grp_crt, tooltip="A doji anchor has a range that means nothing, and 'most failed CRT trades are actually range-definition errors'. 0 disables.")
crtRangeMax = input.float(1.20, "Skip if it is over this fraction (that candle already IS the day)", minval=0.2, maxval=3.0, step=0.1, group=grp_crt)
crtOneShot  = input.bool(true, "One setup per anchor candle", group=grp_crt, tooltip="Their own checklist ends in 'No = stop' and 'No = abandon', and the top reply under it names what happens without this rule: 'somehow the no always gets negotiated into a yes when you're bored'.")
crtGateCore = input.bool(false, "Let this layer veto the CISD score", group=grp_crt, tooltip="Off (the default) = the CISD core behaves exactly as before and this is a second, parallel read on the same chart. On = a bullish signal also needs an armed bullish reference setup, and vice versa.")
scCrt       = input.bool(false, "Count an armed reference setup as a score point", group=grp_crt, tooltip="Off by default because it can only ever be one point of seven and the anchor candle says nothing about the strength of the delivery - but it is a fact about the bar, so counting it is defensible.")

grp_if = "======= iFVG engine (optional) ======="
ifvgMode = input.string("Track only", "iFVG layer", options=["Off", "Track only", "Track + score", "Track + score + gate"], group=grp_if, tooltip="Polarity as 06-fair-value-gaps/inversion-fvg.md defines it: the gap a candle CLOSES THROUGH is the one that flips role, and the zone drawn is that gap - not the opposite side's, not the opposite colour. Track only fixes the picture; score and gate are opt-in, and Off removes every object and every point this layer produces.")
ifvgDisp  = input.float(0.80, "Invalidation needs a body of (ATR x)", minval=0.0, maxval=3.0, step=0.1, group=grp_if, tooltip="The page wants the break decisive, not a wick and a recovery: 0.8 ATR of body on the breaking candle. 0 accepts any close through.")
ifvgMax   = input.int(2, "Live inverted zones per side", minval=1, maxval=4, group=grp_if, tooltip="The version this came from allowed exactly one iFVG object, created only when the list was empty and never invalidated - so it showed the first one of the day and then lied for the rest of the session.")
ifvgAge   = input.int(180, "Inverted zone expiry (bars)", minval=20, maxval=900, group=grp_if)
ifvgEntry = input.string("CE (50%)", "Entry level in the inverted zone", options=["CE (50%)", "Near edge", "Far edge"], group=grp_if, tooltip="06-fair-value-gaps/ce-as-primary-entry.md makes CE the default depth in the 2025 framing; Near edge is the shallow retest, Far edge the full rebalance.")
ifvgWin   = input.bool(true, "Take inverted entries only inside the trading window", group=grp_if)
ifvgDraw  = input.bool(true, "Draw entry / stop / target for an inverted entry", group=grp_if)
ifvgAlert = input.bool(true, "Alert on inverted-zone entries", group=grp_if)

grp_sc = "======= Score composition ======="
scDisp  = input.bool(true, "Count displacement in the score", group=grp_sc, tooltip="Careful: the ratio this is built on passes 87.6% of the time (tools/cisd-audit.md section 1a), which makes it a free point and 'A' nearly free. Off = the score only contains things that can actually fail.")
scPrem  = input.bool(false, "Count premium / discount in the score", group=grp_sc, tooltip="It was computed and then left out of the score, so it could only ever veto and never reward.")
scBody  = input.bool(false, "Count strong body % in the score", group=grp_sc)
scIfvg  = input.bool(true, "Count a live inverted zone on this side in the score", group=grp_sc, tooltip="Only applies when the iFVG layer is Track + score or stronger.")

green = input.color(#00ffbb, "Bullish", group="Appearance")
red   = input.color(#ff1100, "Bearish", group="Appearance")
t1    = input.int(90, "Body Transparency", maxval=100, group="Appearance")
t2    = input.int(40, "Wick Transparency", maxval=100, group="Appearance")
show_candles = input.bool(true, "Overlay painted candles in the trend colour", group="Appearance", tooltip="v1's gimmick: it plots the whole series again, tinted by the trend, and it costs one plot per bar. Off leaves your own candles alone.")
hide_expired_levels   = input.bool(true, "Hide Expired Levels", group="Appearance")
spentMax     = input.int(24, "Keep up to N spent levels visible", minval=0, maxval=200, group="Appearance", tooltip="The leak this replaces: taken levels were dropped from the array but only deleted from the chart when 'Hide Mitigated Levels' was on, which defaulted to off - so every taken level stayed on the chart forever, up to max_lines_count, after which TradingView starts evicting the OLDEST objects, live ones included. 0 = delete on take, as it should have been.")
show_dashboard        = input.bool(true, "Show Dashboard", group="Appearance")

// ═══════════════════════════════════════════════════════════════════
// APPLY PRESET
// ═══════════════════════════════════════════════════════════════════
float tolerence = tolerence_inp
int   len = len_inp
int   min_score_for_best = min_score_inp
int   signal_cooldown = cooldown_inp
float atr_mult_sl = atr_mult_sl_inp
float near_atr_mult = near_mult_inp
int   max_fvgs_per_side = max_fvgs_inp
int   max_obs_per_side = max_obs_inp

if preset == "3min"
    tolerence := 0.55
    len := 8
    min_score_for_best := 2
    signal_cooldown := 5
    atr_mult_sl := 0.40
    near_atr_mult := 2.5
    max_fvgs_per_side := 2
    max_obs_per_side := 1
else if preset == "5min"
    tolerence := 0.60
    len := 10
    min_score_for_best := 2
    signal_cooldown := 6
    atr_mult_sl := 0.35
    near_atr_mult := 2.2
    max_fvgs_per_side := 2
    max_obs_per_side := 1
else if preset == "15min"
    tolerence := 0.63
    len := 11
    min_score_for_best := 2
    signal_cooldown := 7
    atr_mult_sl := 0.30
    near_atr_mult := 2.0
    max_fvgs_per_side := 2
    max_obs_per_side := 1
else if preset == "30min"
    tolerence := 0.66
    len := 12
    min_score_for_best := 2
    signal_cooldown := 9
    atr_mult_sl := 0.28
    near_atr_mult := 1.8
    max_fvgs_per_side := 1
    max_obs_per_side := 1

// ═══════════════════════════════════════════════════════════════════
// KEY LEVELS
// ═══════════════════════════════════════════════════════════════════
// One call, eight values: the four prices of the prior daily candle for the OLHC/OHLC ladder the
// screenshots name, plus the two ranges and the two streak tests the 2017 stand-aside list needs.
// Folding them in here (rather than adding calls) keeps the security budget where the audit left it.
[pd_high, pd_low, pd_open, pd_close, pd_rng, adr5, dUp3, dDn3] = request.security(syminfo.tickerid, "D", [high[1], low[1], open[1], close[1], high[1] - low[1], ta.sma(high - low, 5)[1], close > close[1] and close[1] > close[2] and close[2] > close[3], close < close[1] and close[1] < close[2] and close[2] < close[3]], lookahead=barmerge.lookahead_on)

ny_hour = hour(time, "America/New_York")

isAsia   = ny_hour >= 18 or ny_hour < 2
isLondon = ny_hour >= 2 and ny_hour < 8

var float asiaHigh = na
var float asiaLow  = na
var float lonHigh  = na
var float lonLow   = na
var bool  asiaActive = false
var bool  lonActive  = false

if isAsia
    if not asiaActive
        asiaActive := true
        asiaHigh   := high
        asiaLow    := low
    else
        asiaHigh := math.max(asiaHigh, high)
        asiaLow  := math.min(asiaLow, low)
else
    asiaActive := false

if isLondon
    if not lonActive
        lonActive := true
        lonHigh   := high
        lonLow    := low
    else
        lonHigh := math.max(lonHigh, high)
        lonLow  := math.min(lonLow, low)
else
    lonActive := false

// ═══════════════════════════════════════════════════════════════════
// SWING LIQUIDITY
// ═══════════════════════════════════════════════════════════════════
// The source is named on purpose. ta.pivothigh(len, len) defaults to hlc3, while the level drawn
// and later tested for a sweep is high[len] / low[len] - detector and painted pool were not the same
// object, so a pivot could be flagged on the average price at a level nothing had ever traded.
pivlow  = ta.pivotlow(low, len, len)
pivhigh = ta.pivothigh(high, len, len)

var line[] swinghighs = array.new_line()
var line[] swinglows  = array.new_line()

if not na(pivhigh)
    array.unshift(swinghighs, line.new(bar_index-len, high[len], bar_index, high[len], color=color.new(chart.fg_color, 60)))
if not na(pivlow)
    array.unshift(swinglows, line.new(bar_index-len, low[len], bar_index, low[len], color=color.new(chart.fg_color, 60)))

var float last_wicked_high_level = na
var float last_wicked_low_level  = na

bool wicked_high = false
bool wicked_low  = false

// A taken level is not deleted by the sweep test, it is retired: it leaves the live array so it
// cannot be swept twice, and joins a bounded spent list, dimmed, where it stays readable as a pool
// the day has already used. What this file did instead was drop the line from the array while
// leaving it on the chart whenever "Hide Mitigated Levels" was off - its default - so taken levels
// piled up until max_lines_count, after which TradingView evicts the OLDEST objects, live ones
// included. spentMax = 0 is plain delete-on-take.
//
// The strict test is 02-liquidity/liquidity-sweep.md's arithmetic - "a sweep wicks; BOS closes" -
// and it is the difference between a confluence and a coin flip: measured on the old test, 89% of
// what this script called a sweep had closed straight through the level, i.e. was a break.
f_sweepHi(float lvl) =>
    high >= lvl and (not sweepStrict or (close < lvl and high - math.max(open, close) >= sweepWick * math.max(high - low, syminfo.mintick)))

f_sweepLo(float lvl) =>
    low <= lvl and (not sweepStrict or (close > lvl and math.min(open, close) - low >= sweepWick * math.max(high - low, syminfo.mintick)))

f_retire(line l) =>
    if spentMax > 0
        line.set_x2(l, bar_index)
        line.set_color(l, color.new(chart.fg_color, 76))
        line.set_style(l, line.style_dotted)
    else
        line.delete(l)

var line[] spentHi = array.new_line()
var line[] spentLo = array.new_line()

if array.size(swinghighs) > 0
    for i = array.size(swinghighs)-1 to 0
        // clamped: a counted for takes its direction from start vs end, so an empty bound
        // still runs the body once with a bad index - skip it
        if i < 0 or i >= array.size(swinghighs)
            continue
        line l = array.get(swinghighs, i)
        if bar_index - line.get_x1(l) < expiry_bars
            float lvl = line.get_y1(l)
            line.set_x2(l, bar_index)
            if f_sweepHi(lvl) and barstate.isconfirmed
                array.remove(swinghighs, i)
                wicked_high := true
                last_wicked_high_level := lvl
                f_retire(l)
                if spentMax > 0
                    array.unshift(spentHi, l)
        else
            if hide_expired_levels
                line.delete(l)
            array.remove(swinghighs, i)

if array.size(swinglows) > 0
    for i = array.size(swinglows)-1 to 0
        // clamped: a counted for takes its direction from start vs end, so an empty bound
        // still runs the body once with a bad index - skip it
        if i < 0 or i >= array.size(swinglows)
            continue
        line l = array.get(swinglows, i)
        if bar_index - line.get_x1(l) < expiry_bars
            float lvl = line.get_y1(l)
            line.set_x2(l, bar_index)
            if f_sweepLo(lvl) and barstate.isconfirmed
                array.remove(swinglows, i)
                wicked_low := true
                last_wicked_low_level := lvl
                f_retire(l)
                if spentMax > 0
                    array.unshift(spentLo, l)
        else
            if hide_expired_levels
                line.delete(l)
            array.remove(swinglows, i)

while array.size(swinghighs) > 40
    line.delete(array.pop(swinghighs))
while array.size(spentHi) > spentMax
    line.delete(array.shift(spentHi))
while array.size(spentLo) > spentMax
    line.delete(array.shift(spentLo))
while array.size(swinglows) > 40
    line.delete(array.pop(swinglows))

int bars_since_high = ta.barssince(wicked_high)
int bars_since_low  = ta.barssince(wicked_low)

// ═══════════════════════════════════════════════════════════════════
// LIVE ZONES – STRICT
// ═══════════════════════════════════════════════════════════════════
float atr = ta.atr(14)
float near_dist = atr * near_atr_mult
float min_fvg_size = atr * min_fvg_atr

bool bull_fvg = low > high[2] and (low - high[2]) >= min_fvg_size
bool bear_fvg = high < low[2] and (low[2] - high) >= min_fvg_size

var box[]   live_bull_fvgs   = array.new_box()
var box[]   live_bear_fvgs   = array.new_box()
var box[]   live_bull_obs    = array.new_box()
var box[]   live_bear_obs    = array.new_box()
var label[] live_fvg_labels  = array.new_label()
var label[] live_ob_labels   = array.new_label()

var float last_bull_fvg_top    = na
var float last_bull_fvg_bottom = na
var int   last_bull_fvg_bar    = na
var float last_bear_fvg_top    = na
var float last_bear_fvg_bottom = na
var int   last_bear_fvg_bar    = na

var int last_bull_ob_created = 0
var int last_bear_ob_created = 0
var int last_bull_fvg_created = 0
var int last_bear_fvg_created = 0

// Gap memory. The visual layer deletes a box the first time price TOUCHES its far edge, which is
// right for a "live zone" picture and useless for an inversion - the inversion needs the CLOSE
// through, which happens later. So the model keeps its own list of gaps and does not borrow the
// picture's. 31-models/06-fair-value-gaps: an FVG is a reference until it is rebalanced or run
// through, and which of the two happened is the whole difference between support and resistance.
var array<float> fvTop = array.new_float()
var array<float> fvBot = array.new_float()
var array<int>   fvDir = array.new_int()
var array<int>   fvBar = array.new_int()

is_near(float top, float bottom) =>
    not only_near_price or math.abs(close - (top + bottom)/2) <= near_dist

int zoneCd = zoneCd_inp
if bull_fvg and show_live_fvgs and is_near(low, high[2]) and bar_index - last_bull_fvg_created >= zoneCd
    box b = box.new(bar_index-2, low, bar_index+12, high[2], bgcolor=color.new(green, fvg_transparency), border_color=color.new(green, 60), border_width=1)
    array.unshift(live_bull_fvgs, b)
    label lb = label.new(bar_index-1, (low+high[2])/2, "FVG", style=label.style_label_left, color=color.new(green, 80), textcolor=color.white, size=size.tiny)
    array.unshift(live_fvg_labels, lb)
    last_bull_fvg_top := low
    last_bull_fvg_bottom := high[2]
    last_bull_fvg_bar := bar_index
    last_bull_fvg_created := bar_index

if bear_fvg and show_live_fvgs and is_near(low[2], high) and bar_index - last_bear_fvg_created >= zoneCd
    box b = box.new(bar_index-2, low[2], bar_index+12, high, bgcolor=color.new(red, fvg_transparency), border_color=color.new(red, 60), border_width=1)
    array.unshift(live_bear_fvgs, b)
    label lb = label.new(bar_index-1, (low[2]+high)/2, "FVG", style=label.style_label_left, color=color.new(red, 80), textcolor=color.white, size=size.tiny)
    array.unshift(live_fvg_labels, lb)
    last_bear_fvg_top := low[2]
    last_bear_fvg_bottom := high
    last_bear_fvg_bar := bar_index
    last_bear_fvg_created := bar_index

if bull_fvg and barstate.isconfirmed
    array.unshift(fvTop, low)
    array.unshift(fvBot, high[2])
    array.unshift(fvDir, 1)
    array.unshift(fvBar, bar_index)

if bear_fvg and barstate.isconfirmed
    array.unshift(fvTop, low[2])
    array.unshift(fvBot, high)
    array.unshift(fvDir, -1)
    array.unshift(fvBar, bar_index)

while array.size(fvTop) > 8
    array.shift(fvTop)
    array.shift(fvBot)
    array.shift(fvDir)
    array.shift(fvBar)

if array.size(live_bull_fvgs) > 0
    for i = array.size(live_bull_fvgs)-1 to 0
        // clamped: a counted for takes its direction from start vs end, so an
        // empty bound still runs the body once with a bad index — skip it
        if i < 0 or i >= array.size(live_bull_fvgs)
            continue
        box b = array.get(live_bull_fvgs, i)
        box.set_right(b, bar_index+3)
        if low < box.get_bottom(b) or not is_near(box.get_top(b), box.get_bottom(b))
            box.delete(b)
            array.remove(live_bull_fvgs, i)
            if i < array.size(live_fvg_labels)
                label.delete(array.get(live_fvg_labels, i))
                array.remove(live_fvg_labels, i)

if array.size(live_bear_fvgs) > 0
    for i = array.size(live_bear_fvgs)-1 to 0
        // clamped: a counted for takes its direction from start vs end, so an
        // empty bound still runs the body once with a bad index — skip it
        if i < 0 or i >= array.size(live_bear_fvgs)
            continue
        box b = array.get(live_bear_fvgs, i)
        box.set_right(b, bar_index+3)
        if high > box.get_top(b) or not is_near(box.get_top(b), box.get_bottom(b))
            box.delete(b)
            array.remove(live_bear_fvgs, i)
            if i < array.size(live_fvg_labels)
                label.delete(array.get(live_fvg_labels, i))
                array.remove(live_fvg_labels, i)

while array.size(live_bull_fvgs) > max_fvgs_per_side
    box.delete(array.pop(live_bull_fvgs))
    if array.size(live_fvg_labels) > 0
        label.delete(array.pop(live_fvg_labels))
while array.size(live_bear_fvgs) > max_fvgs_per_side
    box.delete(array.pop(live_bear_fvgs))
    if array.size(live_fvg_labels) > 0
        label.delete(array.pop(live_fvg_labels))

var float last_bull_ob_high = na
var float last_bull_ob_low  = na
var int   last_bull_ob_bar  = na
var float last_bear_ob_high = na
var float last_bear_ob_low  = na
var int   last_bear_ob_bar  = na

bool can_create_bull_ob = bar_index - last_bull_ob_created > 6
bool can_create_bear_ob = bar_index - last_bear_ob_created > 6

if close > open and close[1] < open[1] and show_live_obs and can_create_bull_ob and is_near(high[1], low[1])
    if array.size(live_bull_obs) > 0
        for i = array.size(live_bull_obs)-1 to 0
            // clamped: a counted for takes its direction from start vs end, so an
            // empty bound still runs the body once with a bad index — skip it
            if i < 0 or i >= array.size(live_bull_obs)
                continue
            box.delete(array.get(live_bull_obs, i))
            array.remove(live_bull_obs, i)
        if array.size(live_ob_labels) > 0
            for i = array.size(live_ob_labels)-1 to 0
                // clamped: a counted for takes its direction from start vs end, so an
                // empty bound still runs the body once with a bad index — skip it
                if i < 0 or i >= array.size(live_ob_labels)
                    continue
                label.delete(array.get(live_ob_labels, i))
                array.remove(live_ob_labels, i)
    last_bull_ob_high := high[1]
    last_bull_ob_low  := low[1]
    last_bull_ob_bar  := bar_index[1]
    last_bull_ob_created := bar_index
    box b = box.new(bar_index[1], high[1], bar_index+12, low[1], bgcolor=color.new(green, ob_transparency), border_color=color.new(green, 50))
    array.unshift(live_bull_obs, b)
    label lb = label.new(bar_index[1]+1, (high[1]+low[1])/2, "OB", style=label.style_label_left, color=color.new(green, 60), textcolor=color.white, size=size.tiny)
    array.unshift(live_ob_labels, lb)

if close < open and close[1] > open[1] and show_live_obs and can_create_bear_ob and is_near(high[1], low[1])
    if array.size(live_bear_obs) > 0
        for i = array.size(live_bear_obs)-1 to 0
            // clamped: a counted for takes its direction from start vs end, so an
            // empty bound still runs the body once with a bad index — skip it
            if i < 0 or i >= array.size(live_bear_obs)
                continue
            box.delete(array.get(live_bear_obs, i))
            array.remove(live_bear_obs, i)
        if array.size(live_ob_labels) > 0
            for i = array.size(live_ob_labels)-1 to 0
                // clamped: a counted for takes its direction from start vs end, so an
                // empty bound still runs the body once with a bad index — skip it
                if i < 0 or i >= array.size(live_ob_labels)
                    continue
                label.delete(array.get(live_ob_labels, i))
                array.remove(live_ob_labels, i)
    last_bear_ob_high := high[1]
    last_bear_ob_low  := low[1]
    last_bear_ob_bar  := bar_index[1]
    last_bear_ob_created := bar_index
    box b = box.new(bar_index[1], high[1], bar_index+12, low[1], bgcolor=color.new(red, ob_transparency), border_color=color.new(red, 50))
    array.unshift(live_bear_obs, b)
    label lb = label.new(bar_index[1]+1, (high[1]+low[1])/2, "OB", style=label.style_label_left, color=color.new(red, 60), textcolor=color.white, size=size.tiny)
    array.unshift(live_ob_labels, lb)

if array.size(live_bull_obs) > 0
    for i = array.size(live_bull_obs)-1 to 0
        // clamped: a counted for takes its direction from start vs end, so an
        // empty bound still runs the body once with a bad index — skip it
        if i < 0 or i >= array.size(live_bull_obs)
            continue
        box b = array.get(live_bull_obs, i)
        box.set_right(b, bar_index+2)
        if close < box.get_bottom(b) or not is_near(box.get_top(b), box.get_bottom(b))
            box.delete(b)
            array.remove(live_bull_obs, i)
            if i < array.size(live_ob_labels)
                label.delete(array.get(live_ob_labels, i))
                array.remove(live_ob_labels, i)

if array.size(live_bear_obs) > 0
    for i = array.size(live_bear_obs)-1 to 0
        // clamped: a counted for takes its direction from start vs end, so an
        // empty bound still runs the body once with a bad index — skip it
        if i < 0 or i >= array.size(live_bear_obs)
            continue
        box b = array.get(live_bear_obs, i)
        box.set_right(b, bar_index+2)
        if close > box.get_top(b) or not is_near(box.get_top(b), box.get_bottom(b))
            box.delete(b)
            array.remove(live_bear_obs, i)
            if i < array.size(live_ob_labels)
                label.delete(array.get(live_ob_labels, i))
                array.remove(live_ob_labels, i)

// ═══════════════════════════════════════════════════════════════════
// PREMIUM / DISCOUNT + HTF + KILLZONE
// ═══════════════════════════════════════════════════════════════════
float recent_high = ta.highest(high, 25)
float recent_low  = ta.lowest(low, 25)
float equilibrium = (recent_high + recent_low) / 2
bool in_discount = close < equilibrium
bool in_premium  = close > equilibrium

float htf_close = request.security(syminfo.tickerid, htf_tf, close[1], lookahead = barmerge.lookahead_on)
float htf_ema   = request.security(syminfo.tickerid, htf_tf, ta.ema(close, 50)[1], lookahead = barmerge.lookahead_on)
bool htf_bull  = htf_close > htf_ema
bool htf_bear  = htf_close < htf_ema

// ═════════════════════════════════════
// TIME ENGINE
// ═════════════════════════════════════
// Minutes, not hours. Everything that separates an A+ open from ordinary chop - the Silver Bullet
// hour, the macro cores, the opening range - is narrower than the hour granularity this file used.
int nyMin = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")

f_win(int a, int b) =>
    b >= a ? nyMin >= a and nyMin < b : nyMin >= a or nyMin < b

int lonA = kzSet == "2017 mentorship set" ? 60 : 120
int nyA  = kzSet == "2017 mentorship set" ? 420 : 480
int nyB  = kzSet == "2017 mentorship set" ? 600 : 660

bool wLondon = kz_london and f_win(lonA, 300)
bool wNyAm   = kz_ny and f_win(nyA, nyB)
bool wAsiaKz = kz_asia and f_win(1200, 1440)
bool wLonCls = kz_loncls and f_win(600, 720)
bool wNyPm   = kz_nypm and f_win(810, 960)
bool inKz    = wLondon or wNyAm or wAsiaKz or wLonCls or wNyPm

// 11-silver-bullet + 04-time-cycles: the sub-windows are stamped onto zones and labels whether or
// not they gate anything, so a zone's provenance is readable on the chart instead of inferred.
bool inSb  = useSb and (f_win(180, 240) or f_win(600, 660) or f_win(840, 900))
bool inMac = useMacro and (f_win(50, 70) or f_win(170, 190) or f_win(590, 610) or f_win(830, 850) or f_win(890, 910))
string winTag = inSb and inMac ? " SB+MACRO" : inSb ? " SB" : inMac ? " MACRO" : wNyAm ? " NYAM" : wLondon ? " LON" : wNyPm ? " NYP" : wLonCls ? " LC" : ""

bool inWindow = not use_killzones ? true : timeMode == "All day" ? true : timeMode == "Killzone" ? inKz : timeMode == "Killzone + Macro" ? inKz and inMac : timeMode == "Silver Bullet only" ? inSb : inMac
bool clockOk  = nyMin <= stopHour * 60

// NY AM opening range (31-models/ny-am-open-range-model.md). The range IS the day's first pair of
// pools; what is tradeable is which bound is taken after the window, and how that sits against bias.
bool inOrBuild = useOR and nyMin >= 480 and nyMin < 480 + orLenMin
var float orHi = na
var float orLo = na
var bool  orHiTaken = false
var bool  orLoTaken = false
if useOR and nyMin < 480
    orHi := na
    orLo := na
    orHiTaken := false
    orLoTaken := false
if inOrBuild
    orHi := na(orHi) ? high : math.max(orHi, high)
    orLo := na(orLo) ? low : math.min(orLo, low)
bool orWatch = useOR and not inOrBuild and not na(orHi) and nyMin >= orSweepA * 60 and nyMin < orSweepB * 60
if orWatch and not orHiTaken and high >= orHi and close < orHi
    orHiTaken := true
if orWatch and not orLoTaken and low <= orLo and close > orLo
    orLoTaken := true
bool orTapHi = orWatch and high >= orHi
bool orTapLo = orWatch and low <= orLo
bool orOkBull = not orGate or orLoTaken
bool orOkBear = not orGate or orHiTaken


// ═══════════════════════════════════════════════════════════════════
// 4H CANDLE RANGE - part 1: the reference candle, its bounds, and the
// overnight state that decides whether the day is tradeable at all
// ═══════════════════════════════════════════════════════════════════
// Everything here is inert until crtOn. 'Pips' for the 2017 filters means 0.0001 on a 5-digit feed
// and 0.01 on a 3-digit JPY feed, i.e. ten ticks - which is the unit those numbers were written in.
float pipSz = syminfo.mintick * (math.abs(syminfo.mintick - 0.01) < 1e-9 ? 1.0 : 10.0)
bool  newNyDay = nz(nyMin[1]) > nyMin

// The 2017 list measures CBDR as 14:00-20:00 NY and the Asian range as 20:00-00:00 NY. This file's
// own Asian range (used for targets) runs 18:00-02:00, so reusing it would be checking a different
// window against a number from another rule. Separate accumulators, deliberately.
bool  inCbdrWin = crtOn and nyMin >= 840 and nyMin < 1200
bool  inAsia20  = crtOn and nyMin >= 1200 and nyMin < 1440
var float cbdrHi    = na
var float cbdrLo    = na
var float asia20Hi  = na
var float asia20Lo  = na
var float nightOpen = na
var bool  overnightTrend = false
if newNyDay
    cbdrHi := na
    cbdrLo := na
    asia20Hi := na
    asia20Lo := na
    nightOpen := na
    overnightTrend := false
if inCbdrWin
    cbdrHi := na(cbdrHi) ? high : math.max(cbdrHi, high)
    cbdrLo := na(cbdrLo) ? low  : math.min(cbdrLo, low)
if inAsia20
    if na(nightOpen)
        nightOpen := open
    asia20Hi := na(asia20Hi) ? high : math.max(asia20Hi, high)
    asia20Lo := na(asia20Lo) ? low  : math.min(asia20Lo, low)
    overnightTrend := crtTrendFrac > 0 and math.abs(close - nightOpen) > crtTrendFrac * adr5
// The overnight measurements. The 2017 list says these are "checked at midnight NY", i.e. they
// are DAILY facts, so they are computed once per day into vars instead of being re-derived on
// every bar: same reading at the moment the source asks for it, and it cannot drift mid-session.
var float cbdrPips = na
var float asiaPips = na
var bool  saTight = true

// The clock the whole layer hangs on: minutes since the anchor candle opened, New York, wrapped so
// an anchor in the evening still measures forward correctly.
int  crtAnchorMin = crtRef == "Prev daily candle" ? 0 : crtAnchorH * 60
// One length drives four things: the reference build window, the provisional span, the C2-close
// boundary and the C3 entry gate. Hardcoding 240 in three places is how an hourly-anchor reading
// would silently use a 4H candle's timing.
int  crtLenMin = crtRef == "Prev daily candle" ? 1440 : crtAnchorLen
int  crtSinceA    = (nyMin - crtAnchorMin + 1440) % 1440
bool crtInWin     = crtSinceA >= crtWinOpen and crtSinceA < crtWinOpen + crtWinLen
bool crtExpired   = crtDeliverH > 0 and crtSinceA >= crtDeliverH * 60

// Candle 1. Built by accumulating chart bars inside the reference window instead of by asking for a
// "240" bar, so it is independent of where your chart's 4H candles happen to start (a 17:00-anchored
// template and a 00:00-anchored one would otherwise disagree about which candle is which).
bool  crtRefBuild = not crtOn ? false : crtRef == "Prev 4H candle" ? crtSinceA >= 1440 - crtLenMin : crtRef == "Intra-anchor (provisional bounds)" ? crtSinceA < crtLenMin : false
var bool  crtRefActive = false
var float crtRefHi = na
var float crtRefLo = na
var float crtRefOp = na
// The bound as it stood BEFORE this bar. In provisional mode the running high/low already contains
// the bar being tested, so "low < running low" is unsatisfiable and "the raid" is never seen: the
// level has to be the one price actually took from the earlier bars of the candle.
var float crtPrevHi = na
var float crtPrevLo = na
var float crtRefCl = na
if crtRefBuild
    if not crtRefActive
        crtRefActive := true
        crtRefOp := open
        crtRefHi := high
        crtRefLo := low
        crtPrevHi := na
        crtPrevLo := na
    else
        crtPrevHi := crtRefHi
        crtPrevLo := crtRefLo
        crtRefHi := math.max(crtRefHi, high)
        crtRefLo := math.min(crtRefLo, low)
    crtRefCl := close
else
    crtRefActive := false

float crtHi = crtRef == "Prev daily candle" ? pd_high : crtRefHi
float crtLo = crtRef == "Prev daily candle" ? pd_low  : crtRefLo
float crtOp = crtRef == "Prev daily candle" ? pd_open : crtRefOp
float crtMid = na(crtHi) or na(crtLo) ? na : (crtHi + crtLo) / 2
float crtRange = na(crtHi) or na(crtLo) ? na : crtHi - crtLo
bool  crtProv  = crtRef == "Intra-anchor (provisional bounds)"
bool  crtReady = crtOn and not na(crtHi) and not na(crtLo) and (crtProv or not crtRefActive)
bool  crtTfOk  = crtRef == "Prev daily candle" or timeframe.in_seconds() <= 14400
// The disqualifiers, evaluated once per day. They are kept as a single reason string instead of
// six booleans that are then OR-ed, so the gate and the panel read the same value and cannot
// disagree about whether the day is off - and the chart says which condition it is standing
// aside for instead of just going quiet. Three of the source's eight are calendar facts Pine has
// no access to (a specific holiday, an unscheduled driver, the count of scheduled events);
// those are left out on purpose rather than approximated from a date field.
var bool   isNfpFri      = false
var bool   crtBlockBull  = false
var bool   crtBlockBear  = false
var bool   crtStandAside = false
var string crtSaWhy      = ''
if newNyDay or barstate.isfirst
    cbdrPips := na(cbdrHi) ? na : (cbdrHi - cbdrLo) / pipSz
    asiaPips := na(asia20Hi) ? na : (asia20Hi - asia20Lo) / pipSz
    saTight := na(cbdrHi) or na(asia20Hi) or crtTightFrac == 0 ? true : math.max(cbdrHi, asia20Hi) - math.min(cbdrLo, asia20Lo) < crtTightFrac * adr5
    isNfpFri := dayofweek(time, "America/New_York") == dayofweek.friday and dayofmonth(time, "America/New_York") <= 7
    crtBlockBull := crtSA and dUp3
    crtBlockBear := crtSA and dDn3
    crtSaWhy := ''
    if crtSA
        if not na(pd_rng) and not na(adr5) and pd_rng > crtAdrMult * adr5
            crtSaWhy := crtSaWhy + (crtSaWhy == '' ? '' : ' + ') + 'prior day ' + str.tostring(pd_rng / pipSz, "#") + 'p = ' + str.tostring(pd_rng / adr5, "#.#") + 'x ADR5'
        if crtFri == "Stand aside" and isNfpFri
            crtSaWhy := crtSaWhy + (crtSaWhy == '' ? '' : ' + ') + 'first Friday (NFP day)'
        if not na(cbdrPips) and crtCbdrMax > 0 and cbdrPips > crtCbdrMax
            crtSaWhy := crtSaWhy + (crtSaWhy == '' ? '' : ' + ') + 'CBDR ' + str.tostring(cbdrPips, "#") + 'p over ' + str.tostring(crtCbdrMax, "#")
        if not na(asiaPips) and crtAsiaMax > 0 and asiaPips > crtAsiaMax
            crtSaWhy := crtSaWhy + (crtSaWhy == '' ? '' : ' + ') + 'Asian range ' + str.tostring(asiaPips, "#") + 'p over ' + str.tostring(crtAsiaMax, "#")
        if overnightTrend
            crtSaWhy := crtSaWhy + (crtSaWhy == '' ? '' : ' + ') + 'a move was already running from 20:00'
        if crtTightFrac > 0 and not saTight
            crtSaWhy := crtSaWhy + (crtSaWhy == '' ? '' : ' + ') + 'overnight never tightened'
    crtStandAside := crtSaWhy != ''
bool crtRangeOk   = crtRangeMin == 0 and crtRangeMax == 0 or na(crtRange) or na(adr5) or (crtRange >= crtRangeMin * adr5 and (crtRangeMax == 0 or crtRange <= crtRangeMax * adr5))

// ═════════════════════════════════════
// iFVG ENGINE
// ═════════════════════════════════════
// 06-fair-value-gaps/inversion-fvg.md, read literally: the gap a candle CLOSES THROUGH, decisively,
// is the one that flips role - and the zone you then trade is THAT gap. The layer this file shipped
// named `bull_ifvg` the case where price closed BELOW a bullish gap (a bearish event), drew the
// opposite side's box, coloured it the wrong way, allowed exactly one object created only when the
// list was empty, and never invalidated it - so the panel read "iFVG ACTIVE" from the first one of
// the day onward. All of that is replaced here; `ifvgMode` = Off removes every object and point it
// produces, and "Track only" (the default) changes nothing about the signals.
//
// role +1 = a bearish gap closed through upward, now support under price.
// role -1 = a bullish gap closed through downward, now resistance above price.
var array<float> ivTop  = array.new_float()
var array<float> ivBot  = array.new_float()
var array<int>   ivRole = array.new_int()
var array<int>   ivBar  = array.new_int()
var array<int>   ivUsed = array.new_int()
var array<box>   ivBox  = array.new_box()
var array<label> ivLbl  = array.new_label()

f_ivAlive() =>
    int(array.size(ivTop))

// A gap either ages out, gets rebalanced (price trades back into it and holds, so it stays a gap
// of record and nothing flips), or gets closed through - and only the last of those inverts it.
f_ivPush(float top, float bot, int role) =>
    int n0 = array.size(ivTop)
    bool dup = false
    for j = n0 - 1 to 0
        if j < 0 or j >= n0
            continue
        if not dup
            dup := array.get(ivRole, j) == role and math.abs(array.get(ivTop, j) - top) <= syminfo.mintick and math.abs(array.get(ivBot, j) - bot) <= syminfo.mintick
    if not dup and array.size(ivTop) < ifvgMax * 2
        array.unshift(ivTop, top)
        array.unshift(ivBot, bot)
        array.unshift(ivRole, role)
        array.unshift(ivBar, bar_index)
        array.unshift(ivUsed, 0)
        array.unshift(ivBox, na)
        array.unshift(ivLbl, na)
    bool(not dup)

if ifvgMode != "Off"
    int fn = array.size(fvTop)
    for j = fn - 1 to 0
        if j < 0 or j >= fn
            continue
        int dir0 = array.get(fvDir, j)
        float gt = array.get(fvTop, j)
        float gb = array.get(fvBot, j)
        bool decisive = math.abs(close - open) >= ifvgDisp * atr
        bool flippedUp = dir0 < 0 and close > gt and decisive
        bool flippedDn = dir0 > 0 and close < gb and decisive
        if flippedUp or flippedDn
            f_ivPush(gt, gb, flippedUp ? 1 : -1)
            array.remove(fvTop, j)
            array.remove(fvBot, j)
            array.remove(fvDir, j)
            array.remove(fvBar, j)
        else if bar_index - array.get(fvBar, j) > expiry_bars
            array.remove(fvTop, j)
            array.remove(fvBot, j)
            array.remove(fvDir, j)
            array.remove(fvBar, j)

// Inverted zones: live until the price closes back through the FAR edge (the inversion failed),
// until expiry, or until the entry has been taken and the zone has done its job.
bool ivLiveBull = false
bool ivLiveBear = false
bool ifvg_bull  = false
bool ifvg_bear  = false
float iv_entry  = na
float iv_sl     = na
float iv_tp     = na
int   iv_entry_role = 0

if ifvgMode != "Off"
    int mn = array.size(ivTop)
    for k = mn - 1 to 0
        if k < 0 or k >= mn
            continue
        int role = array.get(ivRole, k)
        float zt = array.get(ivTop, k)
        float zb = array.get(ivBot, k)
        int   born = array.get(ivBar, k)
        int   used = array.get(ivUsed, k)
        bool failed = role > 0 ? close < zb : close > zt
        if failed or bar_index - born > ifvgAge
            box xb = array.get(ivBox, k)
            label xl = array.get(ivLbl, k)
            if not na(xb)
                box.delete(xb)
            if not na(xl)
                label.delete(xl)
            array.remove(ivTop, k)
            array.remove(ivBot, k)
            array.remove(ivRole, k)
            array.remove(ivBar, k)
            array.remove(ivUsed, k)
            array.remove(ivBox, k)
            array.remove(ivLbl, k)
            continue
        if role > 0
            ivLiveBull := true
        else
            ivLiveBear := true
        if used > 0
            continue
        // The entry is a tap of the level and a close back on the correct side of it - a reaction,
        // not a proximity. This is the part the old layer never had: it flagged the inversion event
        // and left the retest to your eyes.
        bool wantEntry = ifvgMode != "Track only"
        float lvl = ifvgEntry == "Near edge" ? (role > 0 ? zt : zb) : ifvgEntry == "Far edge" ? (role > 0 ? zb : zt) : (zt + zb) / 2
        bool tap = role > 0 ? low <= lvl and close > lvl and close > open : high >= lvl and close < lvl and close < open
        if wantEntry and tap and barstate.isconfirmed and (not ifvgWin or inWindow) and (not clockOk or true)
            array.set(ivUsed, k, 1)
            if role > 0
                ifvg_bull := true
                iv_entry := lvl
                iv_sl := zb - atr * atr_mult_sl
                iv_tp := lvl + (lvl - iv_sl) * rr_target
            else
                ifvg_bear := true
                iv_entry := lvl
                iv_sl := zt + atr * atr_mult_sl
                iv_tp := lvl - (iv_sl - lvl) * rr_target
            iv_entry_role := role
        if not show_live_ifvgs
            continue
        box zb2 = array.get(ivBox, k)
        label zl2 = array.get(ivLbl, k)
        string ztag = "iFVG " + (role > 0 ? "support" : "resist") + winTag
        if na(zb2)
            array.set(ivBox, k, box.new(born, zt, bar_index + 6, zb, bgcolor = color.new(role > 0 ? green : red, 84), border_color = color.new(role > 0 ? green : red, 60), border_width = 1))
        else
            box.set_right(zb2, bar_index + 6)
            box.set_top(zb2, zt)
            box.set_bottom(zb2, zb)
        if na(zl2)
            array.set(ivLbl, k, label.new(bar_index + 6, role > 0 ? zb : zt, ztag, style = role > 0 ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = role > 0 ? green : red, size = size.tiny))
        else
            label.set_text(zl2, ztag)
            label.set_x(zl2, bar_index + 6)
            label.set_y(zl2, role > 0 ? zb : zt)

// Entry marks are tracked so they can be retired: three lines and a label per entry, deleted once
// the list passes 12 entries. Created-and-forgotten is exactly how the mitigated levels leaked in
// the version this came from, and past max_lines_count TradingView starts evicting the oldest
// objects, live ones included.
var line[]   ivEls = array.new_line()
var label[]  ivLbs = array.new_label()

if ifvgDraw and (ifvg_bull or ifvg_bear)
    array.push(ivEls, line.new(bar_index, iv_entry, bar_index + 18, iv_entry, color = color.white, width = 1, style = line.style_dashed))
    array.push(ivEls, line.new(bar_index, iv_sl, bar_index + 18, iv_sl, color = red, width = 1))
    array.push(ivEls, line.new(bar_index, iv_tp, bar_index + 18, iv_tp, color = green, width = 1))
    array.push(ivLbs, label.new(bar_index, iv_entry, (ifvg_bull ? "iFVG LONG " : "iFVG SHORT ") + ifvgEntry + " | SL " + str.tostring(iv_sl, format.mintick) + " | TP " + str.tostring(iv_tp, format.mintick), style = ifvg_bull ? label.style_label_up : label.style_label_down, color = color.new(ifvg_bull ? green : red, 20), textcolor = color.black, size = size.tiny))

while array.size(ivEls) > 36
    line.delete(array.shift(ivEls))
while array.size(ivLbs) > 12
    label.delete(array.shift(ivLbs))

if ifvgAlert and (ifvg_bull or ifvg_bear)
    alert("iFVG " + (ifvg_bull ? "LONG" : "SHORT") + " | " + ifvgEntry + " | entry " + str.tostring(iv_entry, format.mintick) + " | SL " + str.tostring(iv_sl, format.mintick) + " | TP " + str.tostring(iv_tp, format.mintick) + " | " + syminfo.ticker + winTag, alert.freq_once_per_bar)

// One place decides whether the machine may run at all, so every guard is visible together.
crtActGate() =>
    crtOn and crtTfOk and crtReady and not crtStandAside and crtRangeOk


// ═══════════════════════════════════════════════════════════════════
// 4H CANDLE RANGE - part 2: the state machine, its outcome, and why it did not fire
// ═══════════════════════════════════════════════════════════════════
// The states ARE the failure list. A layer that reports only 'armed' reproduces what both X accounts
// publish - winners with the box drawn afterwards - while every attempt to put a number on the raw
// pattern puts it near a coin flip (crttrading.com s13: ~45% raw, ~60% with a HTF filter, ~70% with
// killzone plus structure shift; tradingwyckoff's table is the same shape; fundingpips' read of the
// independent Silver Bullet backtests is 50-65% against the 70-80% in the marketing). So: the raid,
// the acceptance, the trigger, the delivery and the standing-aside all get their own counter, and the
// panel says which one it is stuck on.
var int   crtState    = 0     // 0 idle, 1 watching, 2 armed, 3 live, 4 delivered, 5 stopped, 6 void
var int   crtDir      = 0
var float crtSweep    = na
var float crtEntryP   = na
var float crtSlP      = na
var float crtTpP      = na
var float crtTp1      = na
var float crtInitRisk = na
var int   crtEntryBar = na
var bool  crtBe       = false
var bool  crtUsedToday = false
var string crtNote    = ''
// A machine-readable twin of crtNote: the panel reads the sentence, the harness can only read a
// number, and 'which void did it take' is the difference between a test and a guess.
var int   crtWhyCode  = 0
var int   crtSeen     = 0
var int   crtSweeps   = 0
var int   crtEntries  = 0
var int   crtWins     = 0
var int   crtLosses   = 0
var int   crtPushes   = 0
var int   crtVoids    = 0
var int   crtFiltered = 0
var int   crtSkips    = 0
var float crtNetR     = 0.0
var float crtRBoundSum = 0.0
var int   crtRBoundN  = 0
bool crtEvArm   = false
bool crtEvEntry = false
bool crtEvOut   = false
bool crtEvVoid  = false

var box   crtBox       = na
var line  crtLineHi    = na
var line  crtLineLo    = na
var line  crtLineOp    = na
var line  crtLineEntry = na
var line  crtLineSl    = na
var line  crtLineTp    = na
var label crtLblTag    = na
var label crtLblOut    = na

if newNyDay
    crtState := 0
    crtDir := 0
    crtUsedToday := false
    crtSweep := na
    crtEntryP := na
    crtSlP := na
    crtTpP := na
    crtTp1 := na
    crtInitRisk := na
    crtBe := false

bool crtWinOK = not crtTimeHard or crtInWin
// Strict mode is only meaningful where there IS a C2 close to wait for and a close to judge.
bool crtStrictOn = crtStrictC2 and crtAccept != "Touch only" and crtRef != "Prev daily candle"
var bool  crtTapLo = false
var bool  crtTapHi = false
var float crtTapLoPx = na
var float crtTapHiPx = na
if newNyDay
    crtTapLo := false
    crtTapHi := false
    crtTapLoPx := na
    crtTapHiPx := na
bool crtBiasBull = crtBias == "None" ? true : crtBias == "HTF bias" ? htf_bull : crtBias == "Above/below prior-day close" ? close > pd_close : htf_bull and close > pd_close
bool crtBiasBear = crtBias == "None" ? true : crtBias == "HTF bias" ? htf_bear : crtBias == "Above/below prior-day close" ? close < pd_close : htf_bear and close < pd_close
float crtBuf = crtStop == "Sweep extreme + ATR buffer" ? atr * atr_mult_sl : 0.0

if crtOn and crtStandAside
    crtSkips := crtSkips + (newNyDay ? 1 : 0)

if crtActGate()
    // Provisional mode raids and settles against the level that EXISTED (crtPrev*), while the target
    // stays the candle's actual opposite bound: a raid of a bound you moved yourself is not a raid,
    // and freezing the acceptance against a moving line is what makes the option self-fulfilling.
    float crtLoTest = crtProv ? nz(crtPrevLo, crtLo) : crtLo
    float crtHiTest = crtProv ? nz(crtPrevHi, crtHi) : crtHi
    bool touchLo  = crtProv ? not na(crtPrevLo) and low  < crtLoTest : low  <= crtLo
    bool touchHi  = crtProv ? not na(crtPrevHi) and high > crtHiTest : high >= crtHi
    bool testLo   = crtAccept == "Touch only" ? touchLo : crtAccept == "Close back inside" ? touchLo and close > crtLo : touchLo and close > crtLo and close > open
    bool testHi   = crtAccept == "Touch only" ? touchHi : crtAccept == "Close back inside" ? touchHi and close < crtHi : touchHi and close < crtHi and close < open

    if crtState == 0
        crtState := 1
        crtSeen  := crtSeen + 1

    if crtState == 1
        if crtExpired
            crtState := 6
            crtWhyCode := 1
            crtNote  := 'no raid before the delivery window closed - the day was a range, not a setup'
            crtVoids := crtVoids + 1
            crtEvVoid := true
        else if crtStrictOn
            // Candle 2's wick is the event; candle 2's CLOSE is the test. Both halves of the source's
            // sentence, in the order the source puts them in.
            if crtInWin and touchLo
                crtTapLo := true
                crtTapLoPx := na(crtTapLoPx) ? low : math.min(crtTapLoPx, low)
            if crtInWin and touchHi
                crtTapHi := true
                crtTapHiPx := na(crtTapHiPx) ? high : math.max(crtTapHiPx, high)
            if crtSinceA >= crtLenMin
                bool needBody = crtAccept == "Close + body back inside"
                bool okLo = crtTapLo and close > crtLoTest and (not needBody or close > open)
                bool okHi = crtTapHi and close < crtHiTest and (not needBody or close < open)
                bool bullSideS = okLo and not crtTapHi
                bool bearSideS = okHi and not crtTapLo
                if not crtUsedToday and (bullSideS and crtBiasBull and not crtBlockBull or bearSideS and crtBiasBear and not crtBlockBear)
                    crtState := 2
                    crtDir := bullSideS ? 1 : -1
                    crtSweep := bullSideS ? crtTapLoPx : crtTapHiPx
                    crtSweeps := crtSweeps + 1
                    crtEvArm := true
                    crtNote := 'C2 closed back inside after raiding the ' + (bullSideS ? 'low' : 'high') + ' - settled on the candle, not the bar'
                    if crtTgt == "50% then opposite bound"
                        crtTp1 := crtMid
                else if crtTapLo and crtTapHi
                    crtState := 6
                    crtVoids := crtVoids + 1
                    crtEvVoid := true
                    crtWhyCode := 5
                    crtNote := 'both bounds taken inside C2 - a two-way candle, nothing to deliver to'
                else if (crtTapLo and close < crtLoTest) or (crtTapHi and close > crtHiTest)
                    crtState := 6
                    crtVoids := crtVoids + 1
                    crtEvVoid := true
                    crtWhyCode := 6
                    crtNote := 'C2 closed outside the bound it raided - the break held, so the model is void'
                else if crtTapLo or crtTapHi
                    crtState := 6
                    crtFiltered := crtFiltered + 1
                    crtEvVoid := true
                    crtWhyCode := 7
                    crtNote := 'raid at C2 close rejected by the ' + (crtBlockBull or crtBlockBear ? 'daily streak rule' : 'bias filter') + ' - skipped'
                else
                    crtState := 6
                    crtVoids := crtVoids + 1
                    crtEvVoid := true
                    crtWhyCode := 8
                    crtNote := 'C2 closed without ever taking a bound - no raid, no model'
        else if crtWinOK and (testLo or testHi)
            bool bullSide = testLo and not testHi
            bool bearSide = testHi and not testLo
            if not crtUsedToday and (bullSide and crtBiasBull and not crtBlockBull or bearSide and crtBiasBear and not crtBlockBear)
                crtState := 2
                crtDir   := bullSide ? 1 : -1
                crtSweep := bullSide ? low : high
                crtSweeps := crtSweeps + 1
                crtEvArm := true
                crtTapLo := false
                crtTapHi := false
                crtNote  := (bullSide ? 'raided the low and closed back inside' : 'raided the high and closed back inside') + ' at ' + str.tostring(math.floor(nyMin / 60.0), "00") + ':' + str.tostring(nyMin % 60, "00") + ' NY'
                if crtTgt == "50% then opposite bound"
                    crtTp1 := crtMid
            else if bullSide or bearSide
                crtFiltered := crtFiltered + 1
                crtNote := 'raid ' + (bullSide ? 'below' : 'above') + ' against the ' + (crtBlockBull or crtBlockBear ? 'daily streak rule' : 'bias filter') + ' - skipped'

    if crtState == 2
        if crtDir == 1 ? close < crtLo : close > crtHi
            crtState := 6
            crtWhyCode := 2
            crtNote  := 'accepted outside the range: the model is void in that direction'
            crtVoids := crtVoids + 1
            crtEvVoid := true
        else if (crtDir == 1 ? touchHi : touchLo) and not na(crtSweep)
            crtState := 6
            crtWhyCode := 3
            crtNote  := 'both bounds raided - a seek-and-destroy day, not a delivery day'
            crtVoids := crtVoids + 1
            crtEvVoid := true
        else if crtExpired
            crtState := 6
            crtWhyCode := 4
            crtNote  := 'armed, but no trigger before the window closed - abandon, per the checklist'
            crtVoids := crtVoids + 1
            crtEvVoid := true
        else
            bool trig = crtEntry == "On the close back inside" ? true : crtEntry == "Anchor open retest" ? crtDir == 1 ? low <= crtOp and close > crtOp : high >= crtOp and close < crtOp : crtEntry == "Range 50% retest" ? crtDir == 1 ? low <= crtMid and close > crtMid : high >= crtMid and close < crtMid : crtEntry == "Live OB tap" ? crtDir == 1 ? not na(last_bull_ob_bar) and bar_index - last_bull_ob_bar <= crtObAge and low <= last_bull_ob_high and close > last_bull_ob_low : not na(last_bear_ob_bar) and bar_index - last_bear_ob_bar <= crtObAge and high >= last_bear_ob_low and close < last_bear_ob_high : crtDir == 1 ? ifvg_bull : ifvg_bear
            bool c3Ok = not crtC3Only or crtSinceA >= crtLenMin
            if trig and c3Ok
                float entryPx = crtEntry == "Anchor open retest" ? crtOp : crtEntry == "Range 50% retest" ? crtMid : close
                float slP = crtDir == 1 ? crtSweep - crtBuf : crtSweep + crtBuf
                float risk = math.abs(entryPx - slP)
                bool sideOk = crtDir == 1 ? slP < entryPx : slP > entryPx
                bool bigEnough = risk >= crtMinRiskT * syminfo.mintick
                bool notHuge = not na(crtRange) ? risk <= crtRange * 1.5 : true
                if sideOk and bigEnough and notHuge
                    crtEntryP := entryPx
                    crtSlP := slP
                    crtInitRisk := risk
                    crtTpP := crtTgt == "50% of the range" ? crtMid : crtTgt == "R multiple" ? crtDir == 1 ? entryPx + risk * rr_target : entryPx - risk * rr_target : crtDir == 1 ? crtHi : crtLo
                    crtState := 3
                    crtEntryBar := bar_index
                    crtEntries := crtEntries + 1
                    crtUsedToday := crtOneShot
                    crtEvEntry := true
                    float rB = crtDir == 1 ? (crtHi - entryPx) / risk : (entryPx - crtLo) / risk
                    if not na(rB) and rB > 0
                        crtRBoundSum := crtRBoundSum + rB
                        crtRBoundN := crtRBoundN + 1
                    crtNote := (crtDir == 1 ? 'LONG ' : 'SHORT ') + str.tostring(entryPx, format.mintick) + ' stop ' + str.tostring(slP, format.mintick) + ' target ' + str.tostring(crtTgt == "50% of the range" ? crtMid : crtTpP, format.mintick)
                    alert('CRT ' + (crtDir == 1 ? 'long' : 'short') + ' ' + str.tostring(entryPx, format.mintick) + ' | ref ' + crtRef + ' anchor ' + str.tostring(crtAnchorH) + ':00 NY | stop ' + str.tostring(slP, format.mintick) + ' | target ' + str.tostring(crtTpP, format.mintick) + ' | ' + str.tostring(risk / pipSz, "#.#") + ' pips risk | ' + syminfo.ticker)
                else
                    crtWhyCode := not sideOk ? 10 : not bigEnough ? 11 : 12
                    crtNote := 'raid valid, entry refused: ' + (not sideOk ? 'the stop is not on the far side of the entry' : not bigEnough ? 'risk under the tick floor (that is a spread, not a trade)' : 'risk larger than the reference range')

    if crtState == 3 and bar_index != crtEntryBar
        bool hitTgt = crtDir == 1 ? high >= crtTpP : low <= crtTpP
        bool hitStop = crtDir == 1 ? low <= crtSlP : high >= crtSlP
        if not na(crtTp1) and not crtBe and (crtDir == 1 ? high >= crtTp1 : low <= crtTp1)
            crtBe := true
            crtSlP := crtEntryP
            crtNote := '50% of the range reached, stop to breakeven'
        if hitStop
            crtState := 5
            if crtBe
                crtPushes := crtPushes + 1
                crtNote := 'stopped at breakeven after the 50% tag - 0R'
            else
                crtLosses := crtLosses + 1
                crtNetR := crtNetR - 1.0
                crtNote := 'stop taken - the raid held and price continued'
            crtEvOut := true
        else if hitTgt
            crtState := 4
            float rGot = not na(crtInitRisk) and crtInitRisk > 0 ? math.abs(crtTpP - crtEntryP) / crtInitRisk : 0.0
            crtWins := crtWins + 1
            crtNetR := crtNetR + rGot
            crtNote := 'target reached at ' + str.tostring(rGot, "#.#") + 'R'
            crtEvOut := true
        else if crtExpired
            crtState := 6
            crtVoids := crtVoids + 1
            crtWhyCode := 9
            crtNote := 'in the trade, but nothing delivered inside the window - counted, not left open'
            crtEvVoid := true

// The picture. One box, one set of lines, moved rather than rebuilt: nine objects, whatever the
// timeframe, which is the whole reason this layer can live in this file instead of its own.
if crtOn and crtDraw
    if na(crtBox)
        crtBox := box.new(bar_index, close, bar_index + 1, close, border_color=color.new(color.gray, 60), bgcolor=color.new(color.gray, 92), border_width=1)
        crtLineHi := line.new(bar_index, close, bar_index + 1, close, color=color.new(color.orange, 25), width=2)
        crtLineLo := line.new(bar_index, close, bar_index + 1, close, color=color.new(color.orange, 25), width=2)
        crtLineOp := line.new(bar_index, close, bar_index + 1, close, color=color.new(color.white, 45), width=1, style=line.style_dashed)
        crtLineEntry := line.new(bar_index, close, bar_index + 1, close, color=color.new(color.white, 10), width=1, style=line.style_dotted)
        crtLineSl := line.new(bar_index, close, bar_index + 1, close, color=color.new(color.red, 10), width=1)
        crtLineTp := line.new(bar_index, close, bar_index + 1, close, color=color.new(color.green, 10), width=2)
        crtLblTag := label.new(bar_index, close, '', style=label.style_label_down, color=color.new(color.gray, 75), textcolor=color.white, size=size.tiny)
        crtLblOut := label.new(bar_index, close, '', style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.white, size=size.tiny)
    if crtReady and not na(crtBox)
        box.set_top(crtBox, crtHi)
        box.set_bottom(crtBox, crtLo)
        int xRef = math.max(0, bar_index - (crtRef == "Prev daily candle" ? 78 : 16) - (crtProv ? 16 : 0))
        box.set_left(crtBox, xRef)
        box.set_right(crtBox, bar_index)
        line.set_y1(crtLineHi, crtHi)
        line.set_y2(crtLineHi, crtHi)
        line.set_y1(crtLineLo, crtLo)
        line.set_y2(crtLineLo, crtLo)
        line.set_y1(crtLineOp, crtOp)
        line.set_y2(crtLineOp, crtOp)
        line.set_x1(crtLineHi, xRef)
        line.set_x2(crtLineHi, bar_index + 6)
        line.set_x1(crtLineLo, xRef)
        line.set_x2(crtLineLo, bar_index + 6)
        line.set_x1(crtLineOp, xRef)
        line.set_x2(crtLineOp, bar_index + 6)
        label.set_xy(crtLblTag, xRef, crtHi)
        label.set_text(crtLblTag, (crtProv ? 'PROVISIONAL ' : '') + 'ref ' + str.tostring(crtRange / pipSz, "#.#") + 'p' + (crtStandAside ? ' STAND ASIDE' : ''))
    if crtState >= 3 and not na(crtLineEntry)
        line.set_y1(crtLineEntry, crtEntryP)
        line.set_y2(crtLineEntry, crtEntryP)
        line.set_y1(crtLineSl, crtSlP)
        line.set_y2(crtLineSl, crtSlP)
        line.set_y1(crtLineTp, crtTpP)
        line.set_y2(crtLineTp, crtTpP)
        int xT = math.max(0, bar_index - 8)
        line.set_x1(crtLineEntry, xT)
        line.set_x2(crtLineEntry, bar_index + 8)
        line.set_x1(crtLineSl, xT)
        line.set_x2(crtLineSl, bar_index + 8)
        line.set_x1(crtLineTp, xT)
        line.set_x2(crtLineTp, bar_index + 8)
    if crtState >= 4 and not na(crtLblOut)
        label.set_xy(crtLblOut, bar_index, crtDir == 1 ? crtTpP : crtSlP)
        label.set_text(crtLblOut, crtState == 4 ? 'CRT +' + str.tostring(crtNetR, "#.#") + 'R' : crtState == 5 ? (crtBe ? 'CRT BE' : 'CRT -1R') : 'CRT void')
        label.set_color(crtLblOut, crtState == 4 ? color.new(green, 20) : crtState == 5 ? color.new(red, 20) : color.new(color.gray, 20))

// Both strings are table text and nothing else, so they are built once, on the last bar, instead
// of once per bar for a reader that does not exist: str.tostring in the main loop is how a layer
// that costs nothing to think about stops costing nothing to run.
var string crtStateTxt = ''
var string crtPerf = ''
if show_dashboard and barstate.islast
    crtStateTxt := not crtOn ? 'layer off' : not crtTfOk ? 'needs a 4H-or-finer chart' : crtState == 1 ? (crtStandAside ? 'STAND ASIDE: ' + crtSaWhy : crtWinOK ? 'watching the bounds' : 'outside the time window') : crtState == 2 ? 'armed - waiting for the trigger' : crtState == 3 ? 'live' : crtState == 4 ? 'delivered' : crtState == 5 ? 'stopped' : crtState == 6 ? 'void' : crtReady ? 'watching the bounds' : 'no closed reference candle yet'
    crtPerf := ''
    if crtSeen > 0
        crtPerf := str.tostring(crtWins) + 'W/' + str.tostring(crtLosses) + 'L/' + str.tostring(crtPushes) + 'be/' + str.tostring(crtVoids) + 'void ' + str.tostring(crtNetR, "#.#") + 'R'
        if crtEntries > 0
            crtPerf := crtPerf + ' | ' + str.tostring(100.0 * crtWins / crtEntries, "#") + '% off ' + str.tostring(crtEntries)
        if crtRBoundN > 0
            crtPerf := crtPerf + ' | avg ' + str.tostring(crtRBoundSum / crtRBoundN, "#.#") + 'R to the bound'
bool crtOkBull = crtOn and crtDir == 1 and (crtState == 2 or crtState == 3 or crtState == 4)
bool crtOkBear = crtOn and crtDir == -1 and (crtState == 2 or crtState == 3 or crtState == 4)

// ═══════════════════════════════════════════════════════════════════
// CISD CORE
// ═══════════════════════════════════════════════════════════════════
var float[] bear_potential = array.new_float()
var float[] bull_potential = array.new_float()

if close[1] < open[1] and close > open
    array.unshift(bear_potential, bar_index)
    array.unshift(bear_potential, open)
if close[1] > open[1] and close < open
    array.unshift(bull_potential, bar_index)
    array.unshift(bull_potential, open)

int cisd = 0
float origin_lvl = 0.0
float origin_idx = 0.0
float cisd_ratio = 0.0

if array.size(bear_potential) > 0
    bool inloop = true
    while inloop
        if close < array.first(bear_potential)
            float highest = 0.0
            for i = 0 to bar_index - array.get(bear_potential, 1)
                highest := math.max(highest, close[i])
            bool running = true
            int init = bar_index - int(array.get(bear_potential, 1)) + 1
            float top = 0.0
            while running
                if close[init] < open[init]
                    top := open[init]
                    init += 1
                else
                    running := false
            float ratio = (highest - array.first(bear_potential)) / math.max(top - array.first(bear_potential), syminfo.mintick)
            // Strict mode, off by default because it changes what the model counts as a shift: the
            // denominator becomes the larger of the run's own extent and the origin candle's range,
            // and a walk that exits before finding a candle of the expected colour FAILS instead of
            // dividing by one tick and auto-passing. That degenerate path runs on 54% of
            // evaluations and exists only on the bear side - the source of the 47x long/short
            // asymmetry in tools/cisd-audit.md section 1a.
            float lvl0 = array.first(bear_potential)
            int off0 = bar_index - int(array.get(bear_potential, 1))
            float ratioB = top > lvl0 ? (highest - lvl0) / math.max(top - lvl0, math.max(high[off0] - low[off0], syminfo.mintick)) : -1.0
            float eff = strictRatio ? ratioB : ratio
            if eff > tolerence
                origin_lvl := array.first(bear_potential)
                origin_idx := array.get(bear_potential, 1)
                cisd_ratio := eff
                array.clear(bear_potential)
                cisd := 1
                inloop := false
            else
                array.shift(bear_potential)
                array.shift(bear_potential)
                if array.size(bear_potential) == 0
                    inloop := false
        else
            inloop := false

if array.size(bull_potential) > 0
    bool inloop = true
    while inloop
        if close > array.first(bull_potential)
            float lowest = close
            for i = 0 to bar_index - array.get(bull_potential, 1)
                lowest := math.min(lowest, close[i])
            bool running = true
            int init = bar_index - int(array.get(bull_potential, 1)) + 1
            float bottom = 0.0
            while running
                if close[init] > open[init]
                    bottom := open[init]
                    init += 1
                else
                    running := false
            float ratio = (array.first(bull_potential) - lowest) / math.max(array.first(bull_potential) - bottom, syminfo.mintick)
            // Strict mode: symmetric with the bear side, so a degenerate walk fails here too instead
            // of failing quietly because the denominator happened to be the whole price level.
            float lvl0 = array.first(bull_potential)
            int off0 = bar_index - int(array.get(bull_potential, 1))
            float ratioB = bottom < lvl0 ? (lvl0 - lowest) / math.max(lvl0 - bottom, math.max(high[off0] - low[off0], syminfo.mintick)) : -1.0
            float eff = strictRatio ? ratioB : ratio
            if eff > tolerence
                origin_lvl := array.first(bull_potential)
                origin_idx := array.get(bull_potential, 1)
                cisd_ratio := eff
                array.clear(bull_potential)
                cisd := 2
                inloop := false
            else
                array.shift(bull_potential)
                array.shift(bull_potential)
                if array.size(bull_potential) == 0
                    inloop := false
        else
            inloop := false

// ═══════════════════════════════════════════════════════════════════
// BEST SIGNAL + SMART TARGETS + ALERTS
// ═══════════════════════════════════════════════════════════════════
var int trend = 0
var int last_signal_bar = 0

var line[]   active_origin_lines = array.new_line()
var line[]   active_entry_lines  = array.new_line()
var line[]   active_sl_lines     = array.new_line()
var line[]   active_tp_lines     = array.new_line()
var line[]   active_liq_lines    = array.new_line()
var label[]  active_labels       = array.new_label()
var label[]  active_liq_labels   = array.new_label()
var float[]  active_origins      = array.new_float()
var int[]    active_dirs         = array.new_int()
var int[]    active_bars         = array.new_int()

bool bearish_sweep = false
bool bullish_sweep = false
bool best_bear = false
bool best_bull = false
int score = 0
string grade = ""

bool can_signal = bar_index - last_signal_bar >= signal_cooldown and inWindow and clockOk
float body_pct = math.abs(close - open) / math.max(high - low, syminfo.mintick)

// hoisted: a ta.* call inside an if/else only updates on the bars that take that
// branch, so its series is not comparable across bars (CONDITIONAL_SERIES).
liqHi18 = ta.highest(high, 18)
liqLo18 = ta.lowest(low, 18)

get_liq_target(bool is_bull) =>
    float target = na
    string name = ""
    if is_bull
        if not na(pd_high) and pd_high > close
            target := pd_high
            name := "PDH"
        else if not na(asiaHigh) and asiaHigh > close
            target := asiaHigh
            name := "Asia H"
        else if not na(lonHigh) and lonHigh > close
            target := lonHigh
            name := "Lon H"
        else
            target := liqHi18
            name := "Swing H"
    else
        if not na(pd_low) and pd_low < close
            target := pd_low
            name := "PDL"
        else if not na(asiaLow) and asiaLow < close
            target := asiaLow
            name := "Asia L"
        else if not na(lonLow) and lonLow < close
            target := lonLow
            name := "Lon L"
        else
            target := liqLo18
            name := "Swing L"
    [target, name]

if cisd == 1 and can_signal
    trend := -1
    bool liq_ok  = bars_since_high <= liquidity_lookback and close < nz(last_wicked_high_level, high)
    bool fvg_ok  = (not na(last_bear_fvg_bar) and bar_index - last_bear_fvg_bar <= 10) or bear_fvg or ivLiveBear
    bool ifvg_ok = ivLiveBear
    bool disp_ok = cisd_ratio >= strong_disp_mult
    bool htf_ok  = htf_bear
    bool ob_ok   = not na(last_bear_ob_bar) and bar_index - last_bear_ob_bar <= 12 and close <= last_bear_ob_high
    bool pd_ok   = in_premium
    bool body_ok = body_pct >= body_pct_min

    int sMax = 4 + (scDisp ? 1 : 0) + (scPrem ? 1 : 0) + (scBody ? 1 : 0) + (scIfvg and ifvgMode != "Off" ? 1 : 0) + (scCrt ? 1 : 0) + (scCrt ? 1 : 0)
    score := (liq_ok ? 1 : 0) + (fvg_ok ? 1 : 0) + (scDisp and disp_ok ? 1 : 0) + (htf_ok ? 1 : 0) + (ob_ok ? 1 : 0) + (scPrem and pd_ok ? 1 : 0) + (scBody and body_ok ? 1 : 0) + (scIfvg and ifvgMode != "Off" and ifvg_ok ? 1 : 0) + (scCrt and crtOkBull ? 1 : 0) + (scCrt and crtOkBear ? 1 : 0)
    float sFrac = sMax > 0 ? 1.0 * score / sMax : 0.0
    grade := sFrac >= 0.999 ? "A+" : sFrac >= 0.80 ? "A" : sFrac >= 0.60 ? "B" : "C"

    if liq_ok
        bearish_sweep := true

    bool filters_ok = (not require_liq_sweep or liq_ok) and (not require_fvg or fvg_ok) and (not require_strong_disp or disp_ok) and (not require_htf_bias or htf_ok) and (not require_ob or ob_ok) and (not require_prem_disc or pd_ok) and (not require_body_pct or body_ok) and (not require_ifvg or ifvg_ok) and (ifvgMode != "Track + score + gate" or ifvg_ok) and orOkBear and (not crtGateCore or crtOkBear)
    best_bear := filters_ok and score >= min_score_for_best

    if best_bear
        last_signal_bar := bar_index
        int line_width = score >= 3 ? 5 : 3
        line origin_line = line.new(int(origin_idx), origin_lvl, bar_index, origin_lvl, color=red, width=line_width)
        array.push(active_origin_lines, origin_line)
        array.push(active_origins, origin_lvl)
        array.push(active_dirs, -1)
        array.push(active_bars, bar_index)

        string star = score >= 3 ? "★ " : ""
        label lbl = label.new(bar_index, high, star + "BEST " + grade + " ▼", style=label.style_label_down, color=red, textcolor=color.white, size=size.normal)
        array.push(active_labels, lbl)

        float b_entry = close
        float b_sl = high + atr * atr_mult_sl
        float b_tp = b_entry - (b_sl - b_entry) * rr_target
        if show_risk_levels
            float entry = b_entry
            float sl = b_sl
            float tp = b_tp
            array.push(active_entry_lines, line.new(bar_index, entry, bar_index+12, entry, color=color.white, width=1, style=line.style_dotted))
            array.push(active_sl_lines, line.new(bar_index, sl, bar_index+12, sl, color=red, width=1))
            array.push(active_tp_lines, line.new(bar_index, tp, bar_index+12, tp, color=green, width=1))

        if show_liquidity_tgt
            [tgt, tgt_name] = get_liq_target(false)
            if not na(tgt)
                line liq = line.new(bar_index, tgt, bar_index+25, tgt, color=color.new(red, 25), width=2, style=line.style_dashed)
                array.push(active_liq_lines, liq)
                label liq_lbl = label.new(bar_index+25, tgt, tgt_name, style=label.style_label_left, color=color.new(red, 65), textcolor=color.white, size=size.small)
                array.push(active_liq_labels, liq_lbl)

        alert("BEST BEARISH " + grade + " | score " + str.tostring(score) + "/" + str.tostring(sMax) + " | entry " + str.tostring(b_entry, format.mintick) + " | SL " + str.tostring(b_sl, format.mintick) + " | TP " + str.tostring(b_tp, format.mintick) + " | body " + str.tostring(body_pct * 100, "#") + "% |" + winTag + " " + preset + " " + syminfo.ticker, alert.freq_once_per_bar)

if cisd == 2 and can_signal
    trend := 1
    bool liq_ok  = bars_since_low <= liquidity_lookback and close > nz(last_wicked_low_level, low)
    bool fvg_ok  = (not na(last_bull_fvg_bar) and bar_index - last_bull_fvg_bar <= 10) or bull_fvg or ivLiveBull
    bool ifvg_ok = ivLiveBull
    bool disp_ok = cisd_ratio >= strong_disp_mult
    bool htf_ok  = htf_bull
    bool ob_ok   = not na(last_bull_ob_bar) and bar_index - last_bull_ob_bar <= 12 and close >= last_bull_ob_low
    bool pd_ok   = in_discount
    bool body_ok = body_pct >= body_pct_min

    int sMax = 4 + (scDisp ? 1 : 0) + (scPrem ? 1 : 0) + (scBody ? 1 : 0) + (scIfvg and ifvgMode != "Off" ? 1 : 0)
    score := (liq_ok ? 1 : 0) + (fvg_ok ? 1 : 0) + (scDisp and disp_ok ? 1 : 0) + (htf_ok ? 1 : 0) + (ob_ok ? 1 : 0) + (scPrem and pd_ok ? 1 : 0) + (scBody and body_ok ? 1 : 0) + (scIfvg and ifvgMode != "Off" and ifvg_ok ? 1 : 0)
    float sFrac = sMax > 0 ? 1.0 * score / sMax : 0.0
    grade := sFrac >= 0.999 ? "A+" : sFrac >= 0.80 ? "A" : sFrac >= 0.60 ? "B" : "C"

    if liq_ok
        bullish_sweep := true

    bool filters_ok = (not require_liq_sweep or liq_ok) and (not require_fvg or fvg_ok) and (not require_strong_disp or disp_ok) and (not require_htf_bias or htf_ok) and (not require_ob or ob_ok) and (not require_prem_disc or pd_ok) and (not require_body_pct or body_ok) and (not require_ifvg or ifvg_ok) and (ifvgMode != "Track + score + gate" or ifvg_ok) and orOkBull and (not crtGateCore or crtOkBull)
    best_bull := filters_ok and score >= min_score_for_best

    if best_bull
        last_signal_bar := bar_index
        int line_width = score >= 3 ? 5 : 3
        line origin_line = line.new(int(origin_idx), origin_lvl, bar_index, origin_lvl, color=green, width=line_width)
        array.push(active_origin_lines, origin_line)
        array.push(active_origins, origin_lvl)
        array.push(active_dirs, 1)
        array.push(active_bars, bar_index)

        string star = score >= 3 ? "★ " : ""
        label lbl = label.new(bar_index, low, star + "BEST " + grade + " ▲", style=label.style_label_up, color=green, textcolor=color.white, size=size.normal)
        array.push(active_labels, lbl)

        float b_entry = close
        float b_sl = low - atr * atr_mult_sl
        float b_tp = b_entry + (b_entry - b_sl) * rr_target
        if show_risk_levels
            float entry = b_entry
            float sl = b_sl
            float tp = b_tp
            array.push(active_entry_lines, line.new(bar_index, entry, bar_index+12, entry, color=color.white, width=1, style=line.style_dotted))
            array.push(active_sl_lines, line.new(bar_index, sl, bar_index+12, sl, color=red, width=1))
            array.push(active_tp_lines, line.new(bar_index, tp, bar_index+12, tp, color=green, width=1))

        if show_liquidity_tgt
            [tgt, tgt_name] = get_liq_target(true)
            if not na(tgt)
                line liq = line.new(bar_index, tgt, bar_index+25, tgt, color=color.new(green, 25), width=2, style=line.style_dashed)
                array.push(active_liq_lines, liq)
                label liq_lbl = label.new(bar_index+25, tgt, tgt_name, style=label.style_label_left, color=color.new(green, 65), textcolor=color.white, size=size.small)
                array.push(active_liq_labels, liq_lbl)

        alert("BEST BULLISH " + grade + " | score " + str.tostring(score) + "/" + str.tostring(sMax) + " | entry " + str.tostring(b_entry, format.mintick) + " | SL " + str.tostring(b_sl, format.mintick) + " | TP " + str.tostring(b_tp, format.mintick) + " | body " + str.tostring(body_pct * 100, "#") + "% |" + winTag + " " + preset + " " + syminfo.ticker, alert.freq_once_per_bar)

// Clean old signals
if array.size(active_bars) > 0
    for i = array.size(active_bars)-1 to 0
        // clamped: a counted for takes its direction from start vs end, so an
        // empty bound still runs the body once with a bad index — skip it
        if i < 0 or i >= array.size(active_bars)
            continue
        if bar_index - array.get(active_bars, i) > clean_after_bars
            line.delete(array.get(active_origin_lines, i))
            if i < array.size(active_entry_lines)
                line.delete(array.get(active_entry_lines, i))
                line.delete(array.get(active_sl_lines, i))
                line.delete(array.get(active_tp_lines, i))
            if i < array.size(active_liq_lines)
                line.delete(array.get(active_liq_lines, i))
            if i < array.size(active_labels)
                label.delete(array.get(active_labels, i))
            if i < array.size(active_liq_labels)
                label.delete(array.get(active_liq_labels, i))
            array.remove(active_origin_lines, i)
            array.remove(active_origins, i)
            array.remove(active_dirs, i)
            array.remove(active_bars, i)
            if i < array.size(active_entry_lines)
                array.remove(active_entry_lines, i)
                array.remove(active_sl_lines, i)
                array.remove(active_tp_lines, i)
            if i < array.size(active_liq_lines)
                array.remove(active_liq_lines, i)
            if i < array.size(active_labels)
                array.remove(active_labels, i)
            if i < array.size(active_liq_labels)
                array.remove(active_liq_labels, i)

// Auto-invalidation
if auto_invalidate and array.size(active_origins) > 0
    for i = array.size(active_origins)-1 to 0
        // clamped: a counted for takes its direction from start vs end, so an
        // empty bound still runs the body once with a bad index — skip it
        if i < 0 or i >= array.size(active_origins)
            continue
        int dir = array.get(active_dirs, i)
        float orig = array.get(active_origins, i)
        bool invalidated = (dir == 1 and close < orig) or (dir == -1 and close > orig)
        if invalidated
            line.delete(array.get(active_origin_lines, i))
            if i < array.size(active_entry_lines)
                line.delete(array.get(active_entry_lines, i))
                line.delete(array.get(active_sl_lines, i))
                line.delete(array.get(active_tp_lines, i))
            if i < array.size(active_liq_lines)
                line.delete(array.get(active_liq_lines, i))
            if i < array.size(active_labels)
                label.delete(array.get(active_labels, i))
            if i < array.size(active_liq_labels)
                label.delete(array.get(active_liq_labels, i))
            array.remove(active_origin_lines, i)
            array.remove(active_origins, i)
            array.remove(active_dirs, i)
            array.remove(active_bars, i)
            if i < array.size(active_entry_lines)
                array.remove(active_entry_lines, i)
                array.remove(active_sl_lines, i)
                array.remove(active_tp_lines, i)
            if i < array.size(active_liq_lines)
                array.remove(active_liq_lines, i)
            if i < array.size(active_labels)
                array.remove(active_labels, i)
            if i < array.size(active_liq_labels)
                array.remove(active_liq_labels, i)

plotshape(bearish_sweep and not best_bear ? high : na, "Strong Bear", shape.labeldown, location.abovebar, color.new(red, 60), size=size.tiny, text="▼")
plotshape(bullish_sweep and not best_bull ? low  : na, "Strong Bull", shape.labelup, location.belowbar, color.new(green, 60), size=size.tiny, text="▲")

plotchar(not na(pivhigh) ? high[len] : na, "SH", "●", location.absolute, red, size=size.tiny, offset=-len)
plotchar(not na(pivlow)  ? low[len]  : na, "SL", "●", location.absolute, green, size=size.tiny, offset=-len)

color candle_col  = color.from_gradient(t1, 0, 100, trend > 0 ? green : red, chart.bg_color)
color candle_col_ = color.from_gradient(t2, 0, 100, trend > 0 ? green : red, chart.bg_color)
plotcandle(show_candles ? open : na, show_candles ? high : na, show_candles ? low : na, show_candles ? close : na, "Candles", candle_col, candle_col_, bordercolor=candle_col_)

// Dashboard
string analysis = ""
if array.size(live_bull_fvgs) > 0 or array.size(live_bear_fvgs) > 0
    analysis := "FVGs"
if array.size(ivTop) > 0
    analysis := analysis + (analysis == "" ? "" : " + ") + "iFVG"
if array.size(live_bull_obs) > 0 or array.size(live_bear_obs) > 0
    analysis := analysis + (analysis == "" ? "" : " + ") + "OB"
if analysis == ""
    analysis := "Clear"

if show_dashboard and barstate.islast
    var table dash = table.new(position.top_right, 2, 16, bgcolor=color.new(#0d0d0d, 15), border_width=1)
    table.cell(dash, 0, 0, "CISD Ultimate", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, preset, text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 0, 1, "Score", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 1, str.tostring(score) + " " + grade, text_color=score >= 3 ? green : score == 2 ? color.yellow : red, text_size=size.small)
    table.cell(dash, 0, 2, "Analysis", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 2, analysis, text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 3, "Live FVGs", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 3, str.tostring(array.size(live_bull_fvgs) + array.size(live_bear_fvgs)), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 4, "Live OBs", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(array.size(live_bull_obs) + array.size(live_bear_obs)), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 5, "iFVG", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, ifvgMode == "Off" ? "layer off" : str.tostring(array.size(ivTop)) + " inverted / " + str.tostring(array.size(fvTop)) + " gaps", text_color=array.size(ivTop) > 0 ? green : color.gray, text_size=size.tiny)
    table.cell(dash, 0, 6, "Prem/Disc", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 6, in_discount ? "Discount" : "Premium", text_color=in_discount ? green : red, text_size=size.tiny)
    table.cell(dash, 0, 7, "HTF Bias", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 7, htf_bull ? "Bullish" : "Bearish", text_color=htf_bull ? green : red, text_size=size.tiny)
    table.cell(dash, 0, 8, "Window", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 8, (inWindow ? "in " : "out of ") + timeMode + (inSb ? " +SB" : "") + (inMac ? " +MACRO" : ""), text_color=inWindow ? green : color.gray, text_size=size.tiny)
    table.cell(dash, 0, 9, "Ready", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 9, can_signal ? "YES" : "Cooldown", text_color=can_signal ? green : color.orange, text_size=size.tiny)
    table.cell(dash, 0, 10, "Open range", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 10, not useOR ? "off" : na(orHi) ? "building" : str.tostring(orHi, format.mintick) + " / " + str.tostring(orLo, format.mintick) + (orHiTaken ? " H taken" : "") + (orLoTaken ? " L taken" : ""), text_color=useOR and (orHiTaken or orLoTaken) ? green : color.gray, text_size=size.tiny)
    table.cell(dash, 0, 11, "Score parts", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 11, "liq fvg htf ob" + (scDisp ? " disp" : "") + (scPrem ? " prem" : "") + (scBody ? " body" : "") + (scIfvg and ifvgMode != "Off" ? " ifvg" : ""), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 12, "iFVG tap", text_color=color.gray, text_size=size.tiny)

    table.cell(dash, 0, 13, "4H CRT", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 13, crtStateTxt + (crtOn and crtReady ? " | ref " + str.tostring(crtHi, format.mintick) + " / " + str.tostring(crtLo, format.mintick) + " | open " + str.tostring(crtOp, format.mintick) : ""), text_color=crtState == 4 ? green : crtState == 5 or crtState == 6 ? red : crtState == 2 or crtState == 3 ? color.yellow : crtStandAside and crtOn ? color.orange : color.gray, text_size=size.tiny)
    table.cell(dash, 0, 14, "CRT why", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 14, (crtNote == "" ? "no change this bar" : crtNote) + (crtPerf == "" ? "" : "\n" + crtPerf) + (crtFri == "Mark only" and isNfpFri ? "\nfirst Friday (NFP day) - marked, not blocked" : "") + (crtSkips > 0 ? "\n" + str.tostring(crtSkips) + " day(s) stood aside" : "") + (crtFiltered > 0 ? " / " + str.tostring(crtFiltered) + " raids filtered out" : ""), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 12, ifvgMode == "Off" or ifvgMode == "Track only" ? "no entries" : ifvg_bull ? "LONG " + str.tostring(iv_entry, format.mintick) : ifvg_bear ? "SHORT " + str.tostring(iv_entry, format.mintick) : "none this bar", text_color=ifvg_bull or ifvg_bear ? green : color.gray, text_size=size.tiny)

alertcondition(best_bear, "BEST Bearish CISD", "BEST Bearish CISD")
alertcondition(best_bull, "BEST Bullish CISD", "BEST Bullish CISD")

// The inverted-zone taps get their own conditions so they can be alerted apart from the CISD "BEST"
// pair - same bar, different decision - and they go quiet with the ifvgAlert switch.
alertcondition(ifvgAlert and ifvg_bull, "iFVG Inversion Long", "iFVG inversion long: tap of the inverted zone")
alertcondition(ifvgAlert and ifvg_bear, "iFVG Inversion Short", "iFVG inversion short: tap of the inverted zone")
alertcondition(useOR and orTapHi, "NY opening range high swept", "opening range high taken: wick through, close back inside")
alertcondition(useOR and orTapLo, "NY opening range low swept", "opening range low taken: wick through, close back inside")

// The candle-range layer gets its own conditions: the CISD "BEST" pair and this are
// different decisions on the same bar, and an alert that conflates them cannot be audited.
alertcondition(crtOn and crtEvArm, "CRT bound raided and accepted back", "reference-candle raid: wick through the bound, close back inside")
alertcondition(crtOn and crtEvEntry, "CRT entry", "candle-range entry: trigger taken at the level the model names")
alertcondition(crtOn and crtEvOut, "CRT outcome (target or stop)", "candle-range setup finished - the panel keeps the running count")
alertcondition(crtOn and crtEvVoid, "CRT void / abandoned", "candle-range setup voided: accepted outside, both bounds taken, or no delivery in the window")
